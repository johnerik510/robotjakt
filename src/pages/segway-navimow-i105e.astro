---
import { ctaRel } from '../lib/cta-rel';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import FAQ from '../components/FAQ.astro';
import AnswerBox from '../components/AnswerBox.astro';
import StickyCTA from '../components/StickyCTA.astro';

const breadcrumbs = [
  { label: 'Robotgräsklippare', href: '/robotgrasklippare/' },
  { label: 'Utan slinga', href: '/robotgrasklippare-utan-slinga/' },
  { label: 'Segway Navimow i105E' },
];

const kjellUrl = 'https://ion.kjell.com/t/t?a=1487384319&as=2063681412&t=2&tk=1&cupa_sku=66290&url=http://www.kjell.com/se/produkter/hem-fritid/tradgard/robotgrasklippare-tillbehor/robotgrasklippare/segway-navimow-i105e-robotgrasklippare-p66290';

const specs = [
  { label: 'Klippyta', value: '500 m²' },
  { label: 'Klippbredd', value: '18 cm' },
  { label: 'Lutningstolerans', value: '30%' },
  { label: 'Navigering', value: 'VisionFence (fisheye-kamera + AI) + EFLS 2.0 GNSS' },
  { label: 'Uppkoppling', value: 'Wi-Fi (4G valfritt via Access+-modul)' },
  { label: 'Kabelinstallation', value: 'Nej, utan slinga' },
  { label: 'Drifttid', value: '60 min' },
  { label: 'Skyddsklassning', value: 'IP66' },
  { label: 'Installation', value: 'Basstationsantenn' },
];

const faqItems = [
  {
    question: 'Vad är VisionFence-tekniken på Segway Navimow i105E?',
    answer: 'VisionFence är Segways navigeringssystem som kombinerar en 140° fisheye-kamera med AI-bildbehandling och EFLS 2.0 GNSS (satellitpositionering). Kameran analyserar omgivningen i realtid och identifierar gränser samt undviker hinder. GNSS-systemet ger precis positionering utan att du behöver gräva ner perimeterkabel. Tillsammans gör de att du enkelt ritar upp klippzoner direkt i appen.',
  },
  {
    question: 'Behöver Segway Navimow i105E 4G-uppkoppling?',
    answer: 'Nej, i105E fungerar som standard via Wi-Fi. 4G är valfritt och kräver Segways Access+-modul (art.nr p66296 på Kjell) som köps separat. Wi-Fi räcker för de flesta användare som befinner sig i närheten av sitt hemma-nätverk. Vill du kunna styra och övervaka roboten på distans behöver du Access+-modulen.',
  },
  {
    question: 'Hur stor trädgård klarar Segway Navimow i105E?',
    answer: 'i105E klarar klippytor upp till 500 m². Den passar alltså mindre trädgårdar och radhustomter. Har du en större yta bör du titta på Segway Navimow i108E eller H800E, som båda tar upp till 800 m², på i210E för 1 000 m² och i220E för 2 000 m², eller på modeller från Mammotion och Husqvarna Automower-serien.',
  },
  {
    question: 'Hur skiljer sig Segway Navimow i105E mot H500E?',
    answer: 'Båda klarar upp till 500 m², så ytan skiljer dem inte. Skillnaden ligger i utrustning: H500E har 4G inbyggt, bredare klippbredd, dubbelt så lång drifttid (120 min mot 60 min) och 45% lutningstolerans mot i105E:s 30%. Priset är också högre. Välj i105E om trädgården är liten och plan och du vill ha den prisvärdaste utan-slinga-modellen. Välj H500E om du har branta partier eller vill ha 4G direkt från start.',
  },
  {
    question: 'Var kan man köpa Segway Navimow i105E?',
    answer: 'Segway Navimow i105E säljs bland annat på Kjell & Company, som finns i 18 butiker i Sverige. Du hittar produkten online på kjell.com eller i närmaste butik.',
  },
];

const faqSchema = faqItems.map((item) => ({
  "@type": "Question",
  "name": item.question,
  "acceptedAnswer": {
    "@type": "Answer",
    "text": item.answer,
  },
}));
export const articleMeta = {
  title: "Segway Navimow i105E recension 2026: kompakt GPS-robot",
  description: "Segway Navimow i105E testad: kompakt GPS-robotgräsklippare för 500 m². Se klippprestanda, installationstid, appfunktioner och pris i Sverige 2026.",
  publishDate: "2026-05-16",
  category: "Recension",
  image: "/images/segway-navimow-i105e.webp",
};

---

<ArticleLayout
  title="Segway Navimow i105E recension 2026: kompakt GPS-robot"
  description="Segway Navimow i105E testad: kompakt GPS-robotgräsklippare för 500 m². Se klippprestanda, installationstid, appfunktioner och pris i Sverige 2026."
  breadcrumbs={breadcrumbs}
  lastUpdated="2026-07-27"
  ogImage="/images/segway-navimow-i105e.webp"
  datePublished="2026-04-13"
>
  <h1 class="font-heading text-3xl sm:text-4xl font-bold text-text mb-4 leading-tight">
    Segway Navimow i105E, Recension 2026
  </h1>

  <AnswerBox
    question="Snabbt svar: Är Segway Navimow i105E värd att köpa?"
    answer="Ja, för radhustomter och små villaträdgårdar upp till 500 m². VisionFence med fisheye-kamera och GNSS gör att du ritar zonerna i appen i stället för att gräva ner kabel, och IP66 håller regnet ute. Har du branta slänter över 30 procent eller behöver 4G direkt passar den sämre."
  />

  <!-- Verdict box -->
  <div class="bg-winner/5 border border-winner/20 rounded-xl p-5 mb-8">
    <div class="flex items-start gap-4">
      <div class="flex-1">
        <div class="flex items-center gap-3 mb-2">
          <span class="bg-accent text-white text-xs font-bold px-2 py-1 rounded">UTAN SLINGA</span>
          <div class="flex gap-0.5" aria-label="Betyg: 8 av 10">
            {[1,2,3,4].map(i => (
              <svg class="w-4 h-4 text-winner" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
            <svg class="w-4 h-4 text-border" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          </div>
          <span class="font-bold text-text">8 / 10</span>
        </div>
        <p class="text-text-light text-sm leading-relaxed mb-3">
          Segway Navimow i105E är en prisvärd robotgräsklippare utan slinga för trädgårdar upp till 500 m². VisionFence-tekniken kombinerar en 140° fisheye-kamera med AI och EFLS 2.0 GNSS för precis navigering, ingen perimeterkabel krävs. 4G är valfritt tillval via separat modul.
        </p>
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <div>
            <p class="text-xs text-text-light">Hos Kjell &amp; Company</p>
          </div>
          <a
            href={kjellUrl}
            rel={ctaRel(kjellUrl)}
            target="_blank"
            class="inline-flex items-center justify-center bg-cta hover:bg-cta-dark text-white font-semibold px-6 py-3 rounded-lg transition-colors text-sm min-h-[44px]"
          >
            Bra pris hos Kjell
            <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Pros/Cons -->
  <div class="grid sm:grid-cols-2 gap-5 mb-8">
    <div class="bg-white rounded-xl border border-border p-5">
      <h2 class="font-semibold text-text mb-3">Fördelar med Segway Navimow i105E</h2>
      <ul class="space-y-2">
        {[
          'Ingen perimeterkabel, snabb installation',
          'VisionFence-kamera undviker hinder aktivt',
          'IP66-klassad, klarar regn och smuts',
          'Prisvärd utan-slinga-modell till lägre pris',
          '4G som tillval, anpassa efter behov',
          'EFLS 2.0 GNSS för precis positionering',
        ].map(pro => (
          <li class="flex items-start gap-2 text-sm text-text-light">
            <span class="text-winner font-bold flex-shrink-0 mt-0.5">+</span>
            {pro}
          </li>
        ))}
      </ul>
    </div>
    <div class="bg-white rounded-xl border border-border p-5">
      <h2 class="font-semibold text-text mb-3">Nackdelar med Segway Navimow i105E</h2>
      <ul class="space-y-2">
        {[
          'Klarar bara 500 m², passar inte stora trädgårdar',
          '4G kräver separat Access+-modul (extra kostnad)',
          'Kortare drifttid (60 min) än större modeller',
          'Max 30% lutning, begränsad på branta slänter',
          'Begränsat antal återförsäljare i Sverige',
        ].map(con => (
          <li class="flex items-start gap-2 text-sm text-text-light">
            <span class="text-cta font-bold flex-shrink-0 mt-0.5">-</span>
            {con}
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Specs table -->
  <section class="mb-10">
    <h2 class="font-heading text-2xl font-bold text-text mb-4">Tekniska specifikationer Segway Navimow i105E</h2>
    <div class="bg-bg-alt rounded-xl border border-border overflow-hidden mb-6">
      <table class="cmp-table table-fixed w-full text-sm">
        <tbody class="divide-y divide-border">
          {specs.map((spec, i) => (
            <tr class={i % 2 === 0 ? 'bg-white' : ''}>
              <td class="px-4 py-3 font-medium text-text w-1/2">{spec.label}</td>
              <td class="px-4 py-3 text-text-light">{spec.value}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Detailed review -->
  <section class="mb-10">
    <h2 class="font-heading text-2xl font-bold text-text mb-6">Segway Navimow i105E i korthet: GPS-precision och klippresultat</h2>

    <h3 class="font-heading text-xl font-semibold text-text mb-3">VisionFence och GNSS, navigationssystemet</h3>
    <p class="text-text-light leading-relaxed mb-4">
      Hjärtat i i105E är VisionFence-systemet som kombinerar en bred 140° fisheye-kamera med AI-bildanalys och EFLS 2.0 GNSS. Kameran ser omgivningen i realtid och identifierar aktivt hinder, leksaker, djur, krukor, medan GNSS håller roboten kalibrerad mot de zongränser du ritat upp i appen. Resultatet är en robot som hittar rätt utan ett enda meter kabel i marken.
    </p>
    <p class="text-text-light leading-relaxed mb-6">
      Installationen är enkel: montera basstationsantennen på en stadig yta med fri sikt mot himlen, koppla in strömmen och rita upp dina zoner i Navimow-appen. Hela processen brukar ta under en timme för en standardträdgård.
    </p>

    <h3 class="font-heading text-xl font-semibold text-text mb-3">Klippresultat och ytkapacitet</h3>
    <p class="text-text-light leading-relaxed mb-4">
      Med 18 cm klippbredd och systematisk bannavigering täcker i105E din 500 m²-trädgård jämnt och effektivt. Drifttiden på 60 min räcker för ett klipppass och roboten returnerar automatiskt till basstationen för laddning när det behövs. Schemaläggning sköts via appen.
    </p>
    <p class="text-text-light leading-relaxed mb-6">
      Max 30% lutning är tillräckligt för de flesta villaträdgårdar, men har du branta slänter bör du jämföra med H500E (45% lutning) eller Husqvarna Automower-serien som har specialmodeller för extrema lutningar.
    </p>

    <h3 class="font-heading text-xl font-semibold text-text mb-3">4G som tillval, smart eller begränsning?</h3>
    <p class="text-text-light leading-relaxed mb-4">
      Att 4G är valfritt via Access+-modulen är ett smart val från Segway, det sänker grundpriset och ger dig möjlighet att uppgradera vid behov. Wi-Fi-uppkopplingen fungerar utmärkt om du befinner dig hemma och vill styra roboten. Vill du ha full fjärrkontroll och notiser var du än är behöver du Access+-modulen som kostar ytterligare.
    </p>
    <p class="text-text-light leading-relaxed mb-6">
      IP66-klassningen innebär att roboten klarar kraftigt regn och direkta vattenstrålar utan problem, klippning i duggregn är inget hinder.
    </p>

    <h3 class="font-heading text-xl font-semibold text-text mb-3">Segway Navimow i105E vs H500E, vilket ska du välja?</h3>
    <p class="text-text-light leading-relaxed mb-4">
      Ytan avgör inte det här valet, båda modellerna är gjorda för upp till 500 m². Skillnaden ligger i utrustning och pris. i105E är den billigare av de två och räcker gott om tomten är liten och plan.
    </p>
    <p class="text-text-light leading-relaxed mb-6">
      H500E passar dig som vill ha 4G inbyggt utan tillbehörsmodul, klippa längre per pass (120 min mot 60 min) och ha marginal i backarna med 45% lutningstolerans mot i105E:s 30%. Båda modellerna använder VisionFence och kräver ingen perimeterkabel. Har du mer än 500 m² gräs är det <a href="/segway-navimow-h800e/" class="text-accent underline">Segway Navimow H800E</a> du ska jämföra med i stället.
    </p>

    <h3 class="font-heading text-xl font-semibold text-text mb-3">Hur många pass behöver i105E för att klippa 500 m²?</h3>
    <p class="text-text-light leading-relaxed mb-4">
      Fler än ett. Med 18 cm klippbredd och 60 minuters drifttid tar roboten en bit av ytan per pass, åker hem och laddar, och fortsätter där den slutade. Räkna med att den arbetar flera gånger i veckan i stället för att beta av hela tomten på en gång.
    </p>
    <p class="text-text-light leading-relaxed mb-6">
      Det är så en robotgräsklippare är tänkt att fungera. Den klipper några millimeter varje gång och klippet faller ner i mattan som mulch, alltså näring som återförs till gräset. En robot som ligger efter i schemat märks direkt: gräset blir ojämnt och klippet syns som strån ovanpå mattan. Ligger din tomt i den här storleksklassen hittar du fler alternativ i vår topplista över <a href="/robotgrasklippare-liten-tradgard/" class="text-accent underline">robotgräsklippare för liten trädgård</a>.
    </p>

    <h3 class="font-heading text-xl font-semibold text-text mb-3">Vad kräver i105E för underhåll under säsongen?</h3>
    <p class="text-text-light leading-relaxed mb-4">
      Tre saker, med några veckors mellanrum. Skrapa bort gräs och jord under klippdäcket, torka av fisheye-kameran så att den ser skarpt, och kontrollera knivarnas egg. Slöa knivar river av strået i stället för att skära det, vilket ger gulnade toppar och högre strömförbrukning.
    </p>
    <p class="text-text-light leading-relaxed mb-6">
      Att kameran hålls ren är viktigare på en kamerastyrd robot än på en kabelstyrd. Ett lager torkat gräsdamm på linsen gör samma sak som dimma: gränskänningen blir slö och hinderdetekteringen sämre. Knivar och blad hittar du i vår översikt över <a href="/reservdelar/knivar/" class="text-accent underline">reservknivar till robotgräsklippare</a>.
    </p>

    <h3 class="font-heading text-xl font-semibold text-text mb-3">Fungerar i105E om Wi-Fi inte når ut i trädgården?</h3>
    <p class="text-text-light leading-relaxed mb-4">
      Klippningen fungerar, styrningen gör det inte. Schemat ligger i roboten, så den går ut, klipper och dockar även utan uppkoppling. Det du tappar är realtidsstyrning, kartvy och notiser i appen tills roboten är tillbaka inom räckvidden för nätverket. Zonerna påverkas inte alls.
    </p>
    <p class="text-text-light leading-relaxed mb-6">
      Är basstationen placerad i utkanten av tomten är det där täckningen brukar ta slut. Prova signalen med mobilen på den tänkta platsen innan du monterar antennen. Räcker inte hemmanätverket, och vill du kunna nå roboten hemifrån jobbet, är Access+-modulen med 4G lösningen snarare än en extra Wi-Fi-repeater i regnet.
    </p>
  </section>

  <!-- För whom -->
  <section class="mb-10 bg-bg-alt rounded-xl border border-border p-6">
    <h2 class="font-heading text-xl font-bold text-text mb-3">Vem passar Segway Navimow i105E för?</h2>
    <p class="text-text-light leading-relaxed mb-3">
      i105E är rätt val för dig med en radhustomt eller liten villa med gräsyta upp till 500 m² som vill ha en utan-slinga-modell till lägre pris. Tekniken är mogen, installationen snabb och det faktum att 4G är valfritt gör den flexibel.
    </p>
    <p class="text-text-light leading-relaxed">
      Passar inte om du har en yta över 500 m², branta slänter över 30% eller behöver 4G utan att investera i tillbehör. Har du branta partier men samma lilla yta är H500E rätt uppgradering. Är det ytan som inte räcker ska du i stället titta på H800E för upp till 800 m², eller på Mammotion LUBA-serien för större tomter.
    </p>
  </section>

  <!-- CTA section -->
  <section class="mb-10 bg-white rounded-xl border border-border p-5">
    <h2 class="font-heading text-lg font-bold text-text mb-3">Köp Segway Navimow i105E</h2>
    <p class="text-text-light text-sm mb-4">Finns hos Kjell &amp; Company, online och i 18 butiker i Sverige.</p>
    <a
      href={kjellUrl}
      rel={ctaRel(kjellUrl)}
      target="_blank"
      class="inline-flex items-center justify-center bg-cta hover:bg-cta-dark text-white font-semibold px-6 py-3 rounded-lg transition-colors text-sm min-h-[44px]"
    >
      Bra pris hos Kjell
      <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
    </a>
  </section>

  <!-- Compare section -->
  <section class="mb-10 bg-white rounded-xl border border-border p-5">
    <h2 class="font-heading text-lg font-bold text-text mb-3">Jämför med andra robotgräsklippare utan slinga</h2>
    <p class="text-text-light text-sm mb-4">Se alla utan-slinga-modeller vi jämfört eller hela sortimentet.</p>
    <div class="flex flex-col sm:flex-row gap-3">
      <a href="/robotgrasklippare-utan-slinga/" class="inline-flex items-center text-accent underline font-medium text-sm">
        Se alla robotgräsklippare utan slinga
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
      </a>
      <a href="/robotgrasklippare/" class="inline-flex items-center text-accent underline font-medium text-sm">
        Se alla robotgräsklippare vi jämfört
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
      </a>
    </div>
  </section>

  <FAQ items={faqItems} />

  <!-- Related links -->
  <section class="mt-10 p-5 bg-bg-alt rounded-xl border border-border">
    <h2 class="font-heading text-lg font-bold text-text mb-3">Relaterade recensioner</h2>
    <ul class="space-y-2">
      <li><a href="/segway-navimow-h500e/" class="text-accent underline text-sm">Segway Navimow H500E recension, utan slinga för upp till 500 m²</a></li>
      <li><a href="/segway-navimow-h800e/" class="text-accent underline text-sm">Segway Navimow H800E recension, utan slinga för upp till 800 m²</a></li>
      <li><a href="/robotgrasklippare-utan-slinga/" class="text-accent underline text-sm">Bästa robotgräsklippare utan slinga 2026, GPS och RTK-modeller</a></li>
      <li><a href="/robotgrasklippare/" class="text-accent underline text-sm">Bästa robotgräsklippare 2026, komplett topplista och jämförelse</a></li>
    </ul>
  </section>

<style>
  .cmp-table th,
  .cmp-table td {
    overflow-wrap: break-word;
    hyphens: auto;
    vertical-align: top;
  }
  @media (max-width: 640px) {
    .cmp-table { font-size: 0.75rem; line-height: 1.25rem; }
    .cmp-table th,
    .cmp-table td { padding: 0.4rem 0.45rem; }
  }
</style>

</ArticleLayout>

<StickyCTA
  text="Bra pris hos Kjell"
  url={kjellUrl}
  productName="Segway Navimow i105E"
/>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Segway Navimow i105E",
  "image": "https://robotjakt.se/images/segway-navimow-i105e.webp",
  "brand": { "@type": "Brand", "name": "Segway" },
  "description": "Segway Navimow i105E robotgräsklippare utan slinga med VisionFence (fisheye-kamera + AI) och EFLS 2.0 GNSS för trädgårdar upp till 500 m².",
  "category": "Robotgräsklippare",
  "offers": {
    "@type": "Offer",
    "priceCurrency": "SEK",
    "price": "9990",
