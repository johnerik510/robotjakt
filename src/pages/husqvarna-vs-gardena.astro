            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Category by category comparison -->
    <section class="mb-10">
      <h2 class="font-heading text-2xl font-bold text-text mb-6">Gardena vs Husqvarna Automower, kategori för kategori</h2>
      <div class="space-y-5">

        <div class="bg-white rounded-xl border border-border p-5">
