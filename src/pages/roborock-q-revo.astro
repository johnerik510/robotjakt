import Breadcrumbs from '../components/Breadcrumbs.astro';

const faqItems = [
  {
    question: 'Är Roborock Q Revo värd priset?',
    answer: 'Ja, för de flesta hem är Q Revo ett utmärkt val i sin prisklass. Du får dubbla roterande moppar som tvättas automatiskt i stationen, LiDAR-navigation och automatisk fyll-och-töm-station, allt till ett lägre pris än premiummodellerna. Det är ett komplett städsystem som normalt kostar betydligt mer.',
  },
  {
    question: 'Vad är DuoRoller-moppsystemet på Q Revo?',
    answer: 'DuoRoller är Roborocks system med två roterande moppskivor som snurrar mot golvet med 200 rpm. De roterande rörelserna ger bättre rengöring av klibbiga fläckar och smuts jämfört med ett enkelt vibrerande moppkläde. Vid mattor lyfts mopparna automatiskt upp för att undvika att fukta mattans yta.',
  },
  {
    question: 'Vad är skillnaden mellan Q Revo och Roborock S8 Max Ultra?',
    answer: 'S8 Max Ultra har betydligt starkare sugkraft på 10 000 Pa mot Q Revos 5 500 Pa, och kostar mer. Båda har automatisk mopptvätt i stationen. S8 Max Ultra passar hem som prioriterar sugkraft och djupare mattengöring. Q Revo är det smartare valet om du vill hålla nere kostnaden och har mest hårdgolv att moppa.',
  },
  {
    question: 'Hur fungerar den automatiska stationen på Q Revo?',
    answer: 'Stationen sköter fyra saker automatiskt: den fyller på rent vatten i robotens tank, tömmer smutsvatten, tömmer robotens dammkorg och tvättar moppskivorna. Du behöver i regel bara tappa ur smutsvatten och fylla på rent vatten en gång i veckan vid normal användning.',
  },
  {
    question: 'Passar Q Revo för hem med mattor?',
    answer: 'Q Revo fungerar bra i hem med blandade golv. Mopparna lyfts automatiskt vid mattor så de fuktas inte. Sugkraften på 5 500 Pa hanterar korta mattor och hårdgolv väl. För hem med tjocka mattor eller husdjur med lång päls rekommenderar vi S8 Max Ultra med 10 000 Pa.',
  },
  {
    question: 'Vad är skillnaden mot Dreame L10s Ultra Gen 2?',
    answer: 'Dreame L10s Ultra Gen 2 har starkare sugkraft på 7 000 Pa mot Q Revos 5 500 Pa. Båda har dubbla roterande moppar och automatisk mopptvätt. L10s Ultra Gen 2 har dessutom 3D structured light-navigation som ger bättre hinderdetektering. Q Revo har en något enklare station-design och bättre batterikapacitet (180 min vs 170 min). Väljer du på sugkraft vinner L10s, väljer du på stationskvalitet och Roborocks ekosystem är Q Revo ett starkt alternativ.',
  },
  {
    question: 'Hur mycket låter Roborock Q Revo?',
    answer: 'Specifikationen anger cirka 68 dB i det starkaste sugläget, vilket är något högre än toppmodellerna. Ljudet hörs tydligt i samma rum men går att prata över, och på lägre sugeffekt sjunker det märkbart. Det du reagerar mest på är stationen när den tömmer dammkorgen, ett kort men kraftigt moment efter varje pass. Schemalägg körningen på dagtid så slipper du den på kvällen.',
  },
  {
    question: 'Hur mycket plats kräver stationen och var ska den stå?',
    answer: 'Stationen behöver en fri vägg med eluttag och fritt utrymme framför så att roboten kan docka rakt in. Tänk också på att du ska komma åt vattentankarna regelbundet utan att dra fram hela stationen. Undvik placering precis utanför ett sovrum, eftersom dammtömningen låter till. Hall eller tvättstuga fungerar oftast bäst.',
  },
  {
    question: 'Fungerar Roborock Q Revo med Google Assistant och Alexa?',
    answer: 'Ja, roboten styrs via Roborock Home-appen för iOS och Android och stödjer röstkommandon genom Google Assistant och Amazon Alexa. I appen ligger kartan med rumsindelning, förbjudna zoner, virtuella väggar och scheman per rum. Röststyrningen är bekväm för att starta och stoppa ett pass, men detaljinställningarna gör du i appen.',
  },
];

const specs = [
  { label: 'Sugkraft', value: '5 500 Pa' },
  { label: 'Moppsystem', value: 'DuoRoller (dubbla roterande moppar)' },
  { label: 'Moppvarvtal', value: '200 rpm' },
  { label: 'Mopplyfning', value: 'Automatisk vid mattor' },
  { label: 'Station', value: 'Fyll-och-töm (vatten + damm)' },
  { label: 'Mopptvättning', value: 'Automatisk i station' },
  { label: 'Navigering', value: 'LiDAR PreciSense' },
  { label: 'Batterikapacitet', value: '5 200 mAh' },
  { label: 'Drifttid', value: 'ca 180 min' },
  { label: 'Bullernivå', value: 'ca 68 dB (max)' },
