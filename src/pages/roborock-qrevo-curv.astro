---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthorByline from '../components/AuthorByline.astro';
import AnswerBox from '../components/AnswerBox.astro';
import FAQ from '../components/FAQ.astro';
import StickyCTA from '../components/StickyCTA.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { resolveMultiCTA } from '../lib/multi-cta';

const PRODUCT = 'Roborock Qrevo Curv';
const cta = resolveMultiCTA(PRODUCT, 'roborock');
const primary = cta?.primary;
const others = cta?.others?.slice(0, 3) ?? [];

const faqItems = [
  {
    question: 'Vad är AdaptiLift-chassit och vad gör det?',
    answer: 'AdaptiLift är tre oberoende justerbara hjul som kan lyfta hela roboten eller bara en sida i taget. Roboten höjer sig 10 mm för att ta sig över en kant, och kan luta fram, bak eller åt sidan för att komma över snedare hinder. Det är därför Qrevo Curv klarar trösklar på 3 cm som standard och 4 cm när kanten är uppdelad i två steg.',
  },
  {
    question: 'Är Roborock Qrevo Curv efterföljaren till Qrevo Master?',
    answer: 'Den ersätter Qrevo Master i butikernas sortiment men är inte en direkt uppgradering på varje punkt. Curv har högre sugkraft, AdaptiLift-chassit och lägre bygghöjd, medan Master hade en större dammbehållare. Går du från Master till Curv är det tröskelhanteringen och kantstädningen som är den märkbara skillnaden.',
  },
  {
    question: 'Hur bra är kantstädningen?',
    answer: 'FlexiArm Arc-sidoborsten svänger ut mot väggen i stället för att sitta fast i ett läge, och moppmodulen skjuts ut åt sidan vid kanter. Det gör att roboten når betydligt närmare golvlisten än robotar med fasta borstar. Hörnen når den fortfarande inte hela vägen in i, det gör ingen rund robot.',
  },
  {
    question: 'Tvättas mopparna med varmvatten?',
    answer: 'Ja, stationen tvättar med 75-gradigt vatten och torkar sedan med varmluft. Tre temperaturlägen finns att välja mellan i appen. Varmluftstorkningen är det som gör mest skillnad i vardagen: det är torkningen, inte tvätten, som avgör om mopparna börjar lukta unket.',
  },
  {
    question: 'Hur ofta behöver stationens dammpåse bytas?',
    answer: 'Roborock anger upp till sju veckor mellan tömningar. Det förutsätter ett hem utan husdjur och normal mängd smuts. Med hund eller katt som fäller är tre till fyra veckor mer realistiskt. Vattentankarna behöver fyllas på oftare än så, ungefär varannan vecka i en normalstor bostad.',
  },
  {
    question: 'Trasslar borsten av långt hår?',
    answer: 'DuoDivide-borsten består av två parallella rullar med korta borst och spiralformade blad som delar upp och för hår vidare mot sugmunnen. Det minskar trasslet kraftigt jämfört med en enkel borstrulle. Kontrollera ändlagren med några månaders mellanrum, det är där hår ändå kan snurra ihop sig.',
  },
  {
    question: 'Hur hög är Roborock Qrevo Curv?',
    answer: 'Roboten mäter 352 x 347 x 103 mm. Med 10,3 cm bygghöjd kommer den under de flesta soffor men inte under lägre sängramar. Behöver du komma under möbler med runt nio centimeters frigång är en modell med nedsänkbart LiDAR-torn ett bättre val.',
  },
  {
    question: 'Vilka hinder undviker roboten?',
    answer: 'Reactive AI känner igen 62 objekttyper i 20 kategorier med hjälp av strukturerat ljus och RGB-kamera. I praktiken betyder det sladdar, skor, strumpor och husdjursskålar. Små och mörka föremål på mörkt golv är fortfarande det som roboten missar oftast.',
  },
];

const specs = [
  { label: 'Sugkraft', value: '18 500 Pa (HyperForce)' },
  { label: 'Chassi', value: 'AdaptiLift med tre justerbara hjul, 10 mm lyft' },
  { label: 'Tröskelpassage', value: '3 cm enkel kant, 4 cm i två steg' },
  { label: 'Mått', value: '352 x 347 x 103 mm' },
  { label: 'Navigering', value: 'PreciSense LiDAR' },
  { label: 'Hinderdetektering', value: 'Reactive AI, 62 objekttyper i 20 kategorier' },
  { label: 'Huvudborste', value: 'DuoDivide dubbelrulle (anti-tangle)' },
  { label: 'Sidoborste', value: 'FlexiArm Arc, utsvängbar' },
  { label: 'Mopplyft', value: '10 mm' },
  { label: 'Mopptvätt', value: '75 °C varmvatten, tre lägen' },
  { label: 'Mopptorkning', value: 'varmluft i stationen' },
  { label: 'Tömningsintervall', value: 'upp till sju veckor enligt Roborock' },
  { label: 'App', value: 'Roborock (iOS och Android)' },
  { label: 'Röststyrning', value: 'Google Assistant, Amazon Alexa' },
];

const breadcrumbs = [
  { label: 'Roborock Qrevo Curv recension' },
];

export const articleMeta = {
  title: "Roborock Qrevo Curv recension 2026: test och omdöme",
  description: "Roborock Qrevo Curv granskad 2026. AdaptiLift-chassit tar 4 cm trösklar, 18 500 Pa och FlexiArm Arc mot kanterna. Vår recension, för- och nackdelar.",
  publishDate: "2026-08-03",
  category: "Recension",
  image: "/images/roborock-qrevo-curv.webp",
};
---

<BaseLayout
  title="Roborock Qrevo Curv recension 2026: test och omdöme"
  description="Roborock Qrevo Curv granskad 2026. AdaptiLift-chassit tar 4 cm trösklar, 18 500 Pa och FlexiArm Arc mot kanterna. Vår recension, för- och nackdelar."
  ogImage="/images/roborock-qrevo-curv.webp"
  article={{ datePublished: "2026-08-03", dateModified: "2026-08-03", image: "/images/roborock-qrevo-curv.webp" }}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <Breadcrumbs items={breadcrumbs} />
    <AuthorByline datePublished="2026-08-03" dateModified="2026-08-03" />
    <p class="text-xs text-text-lighter mb-4">Senast uppdaterad: 2026-08-03</p>

    <h1 class="font-heading text-3xl sm:text-4xl font-bold text-text mb-4 leading-tight">
      Roborock Qrevo Curv recension 2026
    </h1>

    <AnswerBox
      question="Snabbt svar: är Roborock Qrevo Curv värd att köpa?"
      answer="Ja, om hemmet har trösklar och du vill ha Roborocks ekosystem utan att betala flaggskeppspris. AdaptiLift lyfter roboten över kanter upp till 4 cm i två steg, FlexiArm Arc svänger ut mot golvlisten och 18 500 Pa räcker gott till mattor. Har du inga trösklar alls betalar du för chassit i onödan."
    />

    <img
      src="/images/roborock-qrevo-curv.webp"
      alt="Roborock Qrevo Curv robotdammsugare i den rundade vita stationen"
      class="w-full max-w-md mx-auto max-h-[300px] object-contain rounded-xl border border-border bg-gray-50 mb-8"
      width="900" height="900" loading="eager" fetchpriority="high"
    />

    <div class="bg-winner/5 border border-winner/20 rounded-xl p-5 mb-8">
      <div class="flex-1">
        <div class="flex items-center gap-3 mb-2">
          <span class="bg-accent text-white text-xs font-bold px-2 py-1 rounded">BÄSTA MELLANKLASS</span>
          <div class="flex gap-0.5">
            {[1,2,3,4,5].map(i => (
              <svg class={`w-4 h-4 ${i <= 5 ? 'text-winner' : 'text-border'}`} fill="currentColor" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <span class="font-bold text-text">4,6 / 5</span>
        </div>
        <p class="text-text-light text-sm leading-relaxed">
          Qrevo Curv är den modell som tog över efter Qrevo Master i butikerna, och den gör två saker bättre: den tar sig över trösklar och den kommer närmare väggen. Bygghöjden på 10,3 cm är samtidigt dess tydligaste begränsning, låga sängar förblir ostädade.
        </p>
      </div>
    </div>

    {primary && (
      <div class="bg-accent/5 border border-accent/20 rounded-xl p-5 mb-8">
        <p class="text-sm text-text-light mb-3">Roborock Qrevo Curv finns hos flera av våra samarbetsbutiker. Jämför alltid innan du köper.</p>
        <div class="flex flex-wrap items-center gap-3">
          <a href={primary.url} rel="sponsored nofollow noopener noreferrer" target="_blank" class="inline-flex items-center justify-center px-6 py-3 bg-cta text-white font-semibold rounded-lg hover:bg-cta-dark transition-colors min-h-[44px] text-sm">
            Bra pris hos {primary.store}
            <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
          </a>
          {others.map((o) => (
            <a href={o.url} rel="sponsored nofollow noopener noreferrer" target="_blank" class="inline-flex items-center justify-center px-5 py-3 border-2 border-border text-text-light font-semibold rounded-lg hover:border-cta hover:text-cta transition-colors min-h-[44px] text-sm">
              Bra pris hos {o.store}
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="bg-bg-alt rounded-xl border border-border p-5 mb-8">
      <h2 class="font-heading text-xl font-bold text-text mb-3">Roborock Qrevo Curvs prestanda enligt specifikationer och oberoende tester</h2>
      <p class="text-text-light text-sm leading-relaxed mb-3">Vi har inte kört Qrevo Curv i eget hem. Bedömningen bygger på Roborocks egen specifikation, butikernas produktdata och publicerade tester från oberoende testredaktioner. Där tester och tillverkare säger emot varandra väger vi testerna tyngre, och där ingen källa täcker en punkt skriver vi inget.</p>
      <p class="text-text-light text-sm leading-relaxed">Genomgående i materialet återkommer tre saker: AdaptiLift fungerar som utlovat på riktiga trösklar, kantstädningen är märkbart bättre än på robotar med fast sidoborste, och bygghöjden på 10,3 cm gör att den fastnar utanför låga möbler. Det sista är den vanligaste invändningen mot modellen.</p>
    </div>

    <div class="grid sm:grid-cols-2 gap-5 mb-8">
      <div class="bg-white rounded-xl border border-border p-5">
        <h2 class="font-semibold text-text mb-3">Fördelar med Roborock Qrevo Curv</h2>
        <ul class="space-y-2">
          {[
            'AdaptiLift lyfter roboten över kanter upp till 4 cm i två steg',
            'FlexiArm Arc-sidoborsten svänger ut och når golvlisten',
            'DuoDivide-dubbelrulle som inte trasslar av långt hår',
            '18 500 Pa räcker för luggmattor och djurhår',
            'Varmvattentvätt och varmluftstorkning i stationen',
            'Roborocks app är den mest genomarbetade i klassen',
          ].map(pro => (
            <li class="flex items-start gap-2 text-sm text-text-light">
              <span class="text-winner font-bold flex-shrink-0 mt-0.5">+</span>
              {pro}
            </li>
          ))}
        </ul>
      </div>
      <div class="bg-white rounded-xl border border-border p-5">
        <h2 class="font-semibold text-text mb-3">Nackdelar med Roborock Qrevo Curv</h2>
        <ul class="space-y-2">
          {[
            '10,3 cm bygghöjd stänger ute låga sängar och soffor',
            'Hinderdetekteringen missar små mörka föremål på mörkt golv',
            'Stationen är hög och kräver fri höjd över dockningsplatsen',
            'Hörnen nås inte hela vägen in, som på alla runda robotar',
          ].map(con => (
            <li class="flex items-start gap-2 text-sm text-text-light">
              <span class="text-cta font-bold flex-shrink-0 mt-0.5">-</span>
              {con}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <section class="mb-10">
      <h2 class="font-heading text-2xl font-bold text-text mb-4">Roborock Qrevo Curv i detalj: chassi, kanter och underhåll</h2>

      <h3 class="font-heading text-xl font-semibold text-text mb-3">Hur fungerar AdaptiLift-chassit på riktiga trösklar?</h3>
      <p class="text-text-light leading-relaxed mb-4">
        De tre hjulen kan höjas oberoende av varandra, vilket låter roboten lyfta framvagnen först och sedan dra upp bakvagnen. Roborock anger 3 cm för en enkel kant och 4 cm när kanten går i två steg. Vanliga svenska innerdörrtrösklar ligger under den gränsen, medan en högre list mellan hall och badrum kan bli för mycket.
      </p>
      <p class="text-text-light leading-relaxed mb-6">
        Samma mekanik används för att lyfta hela roboten 10 mm när den kör upp på en tjock matta, så att moppmodulen inte släpar. Det är en mer robust lösning än att bara lyfta moppen, eftersom hela chassit kommer högre och undviker att luggen fastnar under sidoborsten. Behöver du klara högre kanter än så är <a href="/dreame-x50-ultra/" class="text-accent underline">Dreame X50 Ultra</a> den modell som går längst i dag.
      </p>

      <h3 class="font-heading text-xl font-semibold text-text mb-3">Hur nära kanterna städar FlexiArm Arc?</h3>
      <p class="text-text-light leading-relaxed mb-4">
        Sidoborsten sitter på en arm som svänger ut mot väggen när roboten kör längs en list, i stället för att rotera i ett fast läge. Samtidigt skjuts moppmodulen ut åt sidan. Kombinationen gör att både torrsmuts och fukt når betydligt närmare golvlisten än på robotar med fast borste.
      </p>
      <p class="text-text-light leading-relaxed mb-6">
        Begränsningen är geometrisk. En rund robot kan aldrig nå hela vägen in i ett 90-graders hörn, och där behöver du fortfarande gå efter med en handdammsugare någon gång i månaden. Det är samma kompromiss på alla runda modeller och inget som talar emot just Qrevo Curv.
      </p>

      <h3 class="font-heading text-xl font-semibold text-text mb-3">Hur bra är hinderdetekteringen?</h3>
      <p class="text-text-light leading-relaxed mb-6">
        Reactive AI kombinerar strukturerat ljus med en RGB-kamera och känner igen 62 objekttyper fördelade på 20 kategorier. Sladdar, skor, strumpor och husdjursskålar hanteras tillförlitligt. Det som fortfarande sätter roboten är små, mörka föremål mot mörkt golv, där kontrasten blir för låg för kameran. Plocka undan legobitar och laddkablar innan passet, så slipper du avbrott.
      </p>

      <h3 class="font-heading text-xl font-semibold text-text mb-3">Vad kräver stationen i löpande underhåll?</h3>
      <p class="text-text-light leading-relaxed mb-4">
        Stationen tömmer dammbehållaren, tvättar mopparna i 75 grader och torkar dem med varmluft. Roborock anger upp till sju veckor mellan påsbyten, vilket stämmer i hem utan husdjur. Torkningen är den funktion som betyder mest i praktiken, en fuktig mopp som står kvar i stationen börjar lukta inom ett dygn.
      </p>
      <p class="text-text-light leading-relaxed mb-6">
        Tvättbrickan under roboten samlar det som sköljs ur mopparna och behöver torkas av med några veckors mellanrum. Moppdukar, filter och sidoborste är slitdelar som byts efter skick, och rätt delar för Qrevo-serien listar vi bland <a href="/reservdelar/roborock-qrevo-serien/" class="text-accent underline">reservdelar till Roborock Qrevo-serien</a>.
      </p>

      <h3 class="font-heading text-xl font-semibold text-text mb-3">Specifikationer Roborock Qrevo Curv</h3>
      <div class="bg-bg-alt rounded-xl border border-border overflow-hidden mb-6">
        <table class="cmp-table table-fixed w-full text-sm">
          <tbody class="divide-y divide-border">
            {specs.map((spec, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : ''}>
                <td class="px-4 py-3 font-medium text-text w-1/2">{spec.label}</td>
                <td class="px-4 py-3 text-text-light">{spec.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3 class="font-heading text-xl font-semibold text-text mb-3">Vår slutsats: för vem passar Roborock Qrevo Curv?</h3>
      <p class="text-text-light leading-relaxed mb-4">
        Qrevo Curv är rätt val om du har trösklar mellan rummen, vill ha kantstädning som faktiskt når fram och föredrar Roborocks app. Den ersätter <a href="/roborock-qrevo-master/" class="text-accent underline">Roborock Qrevo Master</a> i sortimentet och är i dag den modell vi pekar mot när någon frågar efter Masters efterföljare.
      </p>
      <p class="text-text-light leading-relaxed">
        Har du låga sängar eller soffor som roboten måste under blir bygghöjden på 10,3 cm ett problem, och då är en modell med nedsänkbart LiDAR-torn ett bättre köp. Vill du ha Roborocks toppmodell i stället är <a href="/roborock-saros-20-sonic/" class="text-accent underline">Roborock Saros 20 Sonic</a> nästa steg uppåt.
      </p>
    </section>

    <FAQ items={faqItems} />

    <section class="mt-10 p-5 bg-bg-alt rounded-xl border border-border">
      <h2 class="font-heading text-lg font-bold text-text mb-3">Jämför med konkurrenter</h2>
      <ul class="space-y-2">
        <li><a href="/roborock-guide/" class="text-accent underline text-sm">Roborock guide 2026, alla modeller och skillnader</a></li>
        <li><a href="/roborock-s8-maxv-ultra/" class="text-accent underline text-sm">Roborock S8 MaxV Ultra, AI-kamera och dubbla gummirullar</a></li>
        <li><a href="/roborock-vs-dreame/" class="text-accent underline text-sm">Roborock eller Dreame, vilket märke passar dig</a></li>
        <li><a href="/robotdammsugare/med-mopp/" class="text-accent underline text-sm">Bästa robotdammsugare med mopp 2026</a></li>
        <li><a href="/robotdammsugare/med-bassation/" class="text-accent underline text-sm">Bästa robotdammsugare med basstation</a></li>
        <li><a href="/robotdammsugare/" class="text-accent underline text-sm">Bästa robotdammsugare 2026, alla kategorier</a></li>
      </ul>
    </section>
  </div>

  {primary && (
    <StickyCTA
      text={`Bra pris hos ${primary.store}`}
      url={primary.url}
      productName={PRODUCT}
    />
  )}

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Roborock Qrevo Curv",
    "image": "https://robotjakt.se/images/roborock-qrevo-curv.webp",
    "brand": { "@type": "Brand", "name": "Roborock" },
    "category": "Robotdammsugare",
    "description": "Roborock Qrevo Curv robotdammsugare med AdaptiLift-chassi, 18 500 Pa sugkraft, FlexiArm Arc-sidoborste och station med varmvattentvätt.",
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.6",
      "reviewCount": "1",
      "bestRating": "5",
      "worstRating": "1"
    },
    "review": {
      "@type": "Review",
      "reviewRating": { "@type": "Rating", "ratingValue": "4.6", "bestRating": "5", "worstRating": "1" },
      "author": { "@id": "https://robotjakt.se/#axel" },
      "datePublished": "2026-08-03",
      "reviewBody": "Roborock Qrevo Curv tog över efter Qrevo Master och gör två saker bättre: AdaptiLift tar roboten över trösklar upp till 4 cm i två steg och FlexiArm Arc når närmare golvlisten. Bygghöjden på 10,3 cm är dess tydligaste begränsning.",
      "publisher": { "@id": "https://robotjakt.se/#organization" }
    }
  })} />

<style>
  .cmp-table th,
  .cmp-table td {
    overflow-wrap: break-word;
    hyphens: auto;
    vertical-align: top;
  }
  @media (max-width: 640px) {
    .cmp-table { font-size: 0.75rem; line-height: 1.25rem; }
    .cmp-table th,
    .cmp-table td { padding: 0.4rem 0.45rem; }
  }
</style>

</BaseLayout>
