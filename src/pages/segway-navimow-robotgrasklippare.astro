---
import { ctaRel } from '../lib/cta-rel';
import AuthorByline from '../components/AuthorByline.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import AnswerBox from '../components/AnswerBox.astro';
import StickyCTA from '../components/StickyCTA.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import EditorialCTA from '../components/EditorialCTA.astro';

const breadcrumbs = [
  { label: 'Robotgräsklippare', href: '/robotgrasklippare/' },
  { label: 'Segway Navimow' },
];

type NavimowModel = {
  name: string;
  badge: string;
  badgeColor: string;
  area: string;
  features: string[];
  reviewUrl: string;
  description: string;
  // cta utelämnas medvetet på modeller utan verifierad affiliatelänk
  cta?: string;
  ctaText?: string;
};

const models: NavimowModel[] = [
  {
    name: 'Segway Navimow i105E',
    badge: 'BÄST PRIS UTAN SLINGA',
    badgeColor: 'bg-accent',
    area: 'upp till 500 m²',
    features: ['Vision Fence, inga kablar', 'Kamerabaserad gränsdetektion', '4G som tillval', 'Bullernivå 58 dB', 'Klarar 45% lutning'],
    cta: 'https://go.adt284.net/t/t?a=1870484630&as=2063681412&t=2&tk=1&cupa_sku=3252813&url=https://www.proshop.se/Robotgraesklippare/Segway-Navimow-i105e-robotgraesklippare-500-m/3252813',
    ctaText: 'Bra pris hos Proshop',
    reviewUrl: '/segway-navimow-i105e/',
    description: 'Navimow i105E är marknadens mest prisvärda robotgräsklippare utan perimeterkabel, för en tomt upp till 500 m². Vision Fence-tekniken kombinerar kamera och GPS för att hålla roboten inom zonerna utan ett enda steg av kabelinstallation.',
  },
  {
    name: 'Segway Navimow H500E',
    badge: 'INSTEG I H-SERIEN',
    badgeColor: 'bg-accent',
    area: 'upp till 500 m²',
    features: ['Vision Fence, inga kablar', '4G inbyggt från start', 'RTK GPS + kamera', 'Klarar 45% lutning', 'Lång drifttid, 120 min'],
    reviewUrl: '/segway-navimow-h500e/',
    description: 'Navimow H500E är instegsmodellen i H-serien och klarar tomter upp till 500 m². Du får RTK-antenn, Vision Fence och 4G i samma paket som på H800E, men i en mindre robot som räcker till en normal villatomt. Växer gräsytan förbi 500 m² är H800E nästa steg uppåt.',
  },
  {
    name: 'Segway Navimow H800E',
    badge: 'STÖRRE H-MODELLEN',
    badgeColor: 'bg-winner',
    area: 'upp till 800 m²',
    features: ['Vision Fence utan kablar', '4G inbyggt', 'Kamera + RTK GPS', 'Klarar 45% lutning', 'Snabbinstallation 30 min'],
    reviewUrl: '/segway-navimow-h800e/',
    description: 'Navimow H800E täcker tomter upp till 800 m² och är den större av seriens två H-modeller. Tekniken är densamma som i H500E, men batteriet är större och klipptiden längre, vilket gör den till valet när tomten är en normal till stor villatomt. Över 800 m² räcker H-serien inte till.',
  },
];

const faqItems = [
  {
    question: 'Hur fungerar Segway Navimow utan perimeterkabel?',
    answer: 'Segway Navimow använder Vision Fence-teknologi, en kombination av kamera och GPS (EFLS, Exact Fusion Locating System) för att hålla sig inom definierade zoner. Du kartlägger trädgårdens gränser digitalt i Navimow-appen och roboten följer kartan med hjälp av kameran och satellitpositionering. Ingen kabel behöver grävas ner eller läggas ut.',
  },
  {
    question: 'Vilken Navimow-modell ska jag välja?',
    answer: 'Ytan avgör. Under 500 m²: i105E är seriens billigaste utan-slinga-alternativ, och H500E är alternativet om du vill ha 4G och RTK-antenn direkt från start. 500 till 800 m²: H800E, den större av H-modellerna, med längre klipptid per pass. Över 800 m²: då räcker ingen H-modell, utan du behöver en modell ur Segways i-serie, som i210E för 1 000 m² och i220E för 2 000 m², eller en robot från Mammotion eller Husqvarna.',
  },
  {
    question: 'Hur jämför sig Segway Navimow mot Mammotion LUBA?',
    answer: 'De ligger i olika storleksklasser. Segway Navimow H-serien tar 500 m² (H500E) respektive 800 m² (H800E), medan Mammotion LUBA AWD 3000 är byggd för upp till 3 000 m². Har du en villatomt är Navimow enklare och billigare att komma igång med. Har du en stor tomt är LUBA det enda av de två som räcker till. Båda använder RTK GPS men med olika kompletterande tekniker (Vision Fence mot RTK-basstationsantenn), och LUBA klarar dessutom betydligt brantare mark.',
  },
  {
    question: 'Fungerar Segway Navimow i dåligt väder?',
    answer: 'Ja, Navimow-modellerna är byggda för att klippa i alla väderförhållanden inklusive regn. IPX5-klassade mot stänkvatten. En automatisk regnsensor pausar klippningen vid kraftigt regn om du aktiverar det i appen. Kamerasystemet (Vision Fence) kan ha något sämre precision vid kraftigt regn men roboten är designad för nordeuropeiskt klimat.',
  },
  {
    question: 'Vad ingår i paketet när man köper Segway Navimow?',
    answer: 'Paketet inkluderar roboten, laddstation, RTK-antenn (för H-serien), nätadapter och snabbstartsguide. Inget kabelkit eller stiftpåsar behövs eftersom Navimow inte använder perimeterkabel. H-seriens RTK-antenn monteras på ett fast underlag (husvägg, staket) för bäst signalstabilitet. Installationen tar normalt 20 till 40 minuter.',
  },
  {
    question: 'Vad betyder siffrorna i Navimows modellnamn?',
    answer: 'I H-serien anger siffran den maximala klippytan i kvadratmeter. H500E är alltså gjord för upp till 500 m², H800E för upp till 800 m² och i105E för 105 m². Det gör serien ovanligt lätt att läsa av: mät gräsytan, lägg på marginal för hinder och smala passager, och välj modellen vars siffra ligger över resultatet. i-serien följer samma logik, där i210E tar 1 000 m² och i220E 2 000 m².',
  },
  {
    question: 'Var ska RTK-antennen sitta?',
    answer: 'Antennen ska sitta stadigt monterad med så fri sikt mot himlen som möjligt, gärna högt på en husvägg, ett staket eller en egen stolpe. Signalstabiliteten avgör hur exakt roboten håller sina gränser, så undvik lägen under takfot, tät trädkrona eller intill en hög häck. Sitter antennen fel märks det som att roboten driver utanför sina zoner eller stannar oftare. Flyttas antennen ur läge senare måste zonerna kalibreras om, så kontrollera fästet varje vår.',
  },
  {
    question: 'Kan Navimow klippa flera gräsytor som inte hänger ihop?',
    answer: 'Du ritar flera zoner i appen och kan lägga olika scheman på dem, till exempel framsidan mitt på dagen och baksidan på morgonen. Det som avgör om det fungerar i praktiken är om roboten kan ta sig mellan ytorna på gräs eller passage. Är ytorna helt åtskilda av en grusgång, en trappa eller en asfalterad uppfart måste du bära roboten emellan. Zonhanteringen är dessutom mer grundläggande än hos Husqvarnas Automower Connect.',
  },
  {
    question: 'Ska roboten tas in på vintern?',
    answer: 'Ja, själva roboten ska förvaras torrt och frostfritt inomhus, normalt från oktober eller november. Batteriet mår bäst av att lagras på 60 till 80 procent laddning i stället för fullt. Laddstationen och RTK-antennen får stå kvar ute, men kontrollera antennens fäste innan snön kommer, eftersom en antenn som glider ur läge tvingar dig att kalibrera om zonerna till våren.',
  },
];

const faqSchema = faqItems.map((item) => ({
  "@type": "Question",
  "name": item.question,
  "acceptedAnswer": {
    "@type": "Answer",
    "text": item.answer,
  },
}));
export const articleMeta = {
  title: "Bästa Segway Navimow robotgräsklippare 2026: guide",
  description: "Komplett guide till Segway Navimow 2026. Vi jämför H500E, H800E och i105E. GPS-styrda gräsrobotar utan slinga. Hitta rätt modell för din trädgård.",
  publishDate: "2026-05-16",
  category: "Topplista",
  image: "/images/segway-navimow-h500e.webp",
};

---

<BaseLayout
  title="Bästa Segway Navimow robotgräsklippare 2026: guide"
  description="Komplett guide till Segway Navimow 2026. Vi jämför H500E, H800E och i105E. GPS-styrda gräsrobotar utan slinga. Hitta rätt modell för din trädgård."
  article={{ datePublished: "2026-05-16", dateModified: "2026-07-27", image: "/images/segway-navimow-h500e.webp" }}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <Breadcrumbs items={breadcrumbs} />
    <AuthorByline datePublished="2026-05-16" dateModified="2026-07-27" />

    <h1 class="font-heading text-3xl sm:text-4xl font-bold text-text mb-4 leading-tight">
      Segway Navimow robotgräsklippare 2026, Vision Fence utan slinga
    </h1>

    <AnswerBox
      question="Snabbt svar: Vilken Segway Navimow ska du välja 2026?"
      answer="Under 500 m² räcker i105E, seriens billigaste utan-slinga-modell, och H500E om du vill ha 4G och RTK-antenn från start. Mellan 500 och 800 m² tar H800E över, den större av de två H-modellerna, med längre klipptid per pass. Har du mer än 800 m² gräs räcker ingen H-modell, då får du gå upp till Segways i-serie eller titta på Mammotion och Husqvarna."
    />
    <p class="text-text-light mb-6 max-w-2xl">
      Segway Navimow klipper utan perimeterkabel med Vision Fence. Den här sidan ställer hela serien mot varandra så att du hittar rätt storleksklass. Söker du testet av en enskild modell ligger det på våra egna sidor för <a href="/segway-navimow-h500e/" class="text-accent underline">Segway Navimow H500E</a>, <a href="/segway-navimow-h800e/" class="text-accent underline">Segway Navimow H800E</a> och <a href="/segway-navimow-i105e/" class="text-accent underline">Segway Navimow i105E</a>.
    </p>

    <EditorialCTA products={['Segway Navimow i105E']} />

    <section class="mb-8 bg-bg-alt rounded-xl border border-border p-6">
      <h2 class="font-heading text-xl font-bold text-text mb-3">Segway Navimow utan slinga: Vision Fence och RTK GPS förklarade</h2>
      <p class="text-text-light leading-relaxed mb-3">
        Segway Navimow är kända för sin Vision Fence-teknik som kombinerar kameradetektion med RTK GPS (EFLS). Jämfört med konkurrenterna Mammotion LUBA och Husqvarna EPOS ligger Navimow-serien lägre i pris, och i105E är den billigaste vägen in i utan-slinga-segmentet.
      </p>
      <p class="text-text-light leading-relaxed">
        Installationen tar 20 till 40 minuter: montera RTK-antennen (H-serien), lägg till laddstationen och kartlägg trädgårdens zoner i appen. Ingen kabel grävs ner, inga stift sätts i marken. Navimow-appen (iOS och Android) stödjer schemaläggning, zonhantering och fjärrstyrning via 4G.
      </p>
    </section>

    <h2 class="font-heading text-2xl font-bold text-text mb-6" id="modeller">Alla Segway Navimow-modeller 2026: i105E, H500E och H800E jämförda</h2>
    <div class="space-y-6">
      {models.map((model) => (
        <section class="bg-white rounded-xl border border-border overflow-hidden shadow-sm">
          <div class="p-5 sm:p-6">
            <div class="flex flex-wrap items-start gap-3 mb-3">
              <h3 class="font-heading text-xl font-bold text-text">{model.name}</h3>
              <span class={`${model.badgeColor} text-white text-xs font-bold px-2.5 py-1 rounded-full uppercase tracking-wide`}>
                {model.badge}
              </span>
            </div>
            <p class="text-text-light leading-relaxed mb-4">{model.description}</p>
            <div class="grid grid-cols-2 gap-4 mb-4">
              <div>
                <p class="text-xs font-semibold text-text mb-2">Funktioner</p>
                <ul class="space-y-1">
                  {model.features.map(f => (
                    <li class="flex items-start gap-1.5 text-xs text-text-light">
                      <span class="text-winner font-bold mt-0.5">+</span>{f}
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <p class="text-xs font-semibold text-text mb-2">Areal</p>
                <p class="text-sm font-semibold text-text">{model.area}</p>
              </div>
            </div>
            <div class="flex flex-wrap gap-3">
              <a href={model.reviewUrl} class="inline-flex items-center text-accent underline font-medium text-sm">
                {model.name} recension
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              </a>
              {model.cta && (
                <a
                  href={model.cta}
                  rel={ctaRel(model.cta)}
                  target="_blank"
                  class="inline-flex items-center justify-center bg-cta hover:bg-cta-dark text-white font-semibold px-5 py-2.5 rounded-lg transition-colors text-sm min-h-[44px]"
                >
                  {model.ctaText}
                  <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                </a>
              )}
            </div>
          </div>
        </section>
      ))}
    </div>

    <section class="mt-10 mb-10">
      <h2 class="font-heading text-2xl font-bold text-text mb-6">Köpguide: det här bör du kolla innan du väljer Segway Navimow</h2>

      <h3 class="font-heading text-xl font-bold text-text mb-3">Vad kan störa Vision Fence i en trädgård med mycket träd?</h3>
      <p class="text-text-light leading-relaxed mb-3">
        Sikten uppåt och utåt. Vision Fence bygger på satellitpositionering plus kamera, och satellitsignalen dämpas av täta trädkronor, höga husgavlar och plank. Kameran i sin tur behöver ljus och en ren lins. Blir båda källorna svaga samtidigt tvekar roboten närmast zongränsen.
      </p>
      <p class="text-text-light leading-relaxed mb-6">
        Testa innan du köper: ställ dig med mobilen i tomtens mest skuggade hörn och se hur många satelliter den hittar. Är det ett litet parti under en stor gran spelar det sällan roll, roboten passerar snabbt. Är hela ena långsidan täckt av krona eller ligger tomten inklämd mellan höga fasader är det där problemen dyker upp. Samma sak gäller alla <a href="/robotgrasklippare-utan-slinga/" class="text-accent underline">robotgräsklippare utan slinga</a>, oavsett märke, eftersom de alla bygger på satellitpositionering i någon form.
      </p>

      <h3 class="font-heading text-xl font-bold text-text mb-3">Hur lång tid tar installationen av en Segway Navimow?</h3>
      <p class="text-text-light leading-relaxed mb-3">
        Normalt 20 till 40 minuter. Du placerar laddstationen, monterar RTK-antennen på ett fast underlag som husvägg eller staket och kartlägger sedan zonerna i appen. Ingen kabel grävs ner och inga stift sätts i marken, vilket är hela poängen med Vision Fence.
      </p>
      <p class="text-text-light leading-relaxed mb-6">
        Den enskilt viktigaste detaljen är antennens placering. Sitter den på något som rör sig, ett spjälstaket som svajar eller ett provisoriskt stativ, flyttas referenspunkten och zonerna hamnar snett. Skruva fast den i något stumt, med så fri sikt uppåt som tomten tillåter, och gör det på första försöket. Att flytta antennen i efterhand innebär att zonerna måste ritas om.
      </p>

      <h3 class="font-heading text-xl font-bold text-text mb-3">Vad kräver en Segway Navimow för underhåll under säsongen?</h3>
      <p class="text-text-light leading-relaxed mb-3">
        Rengöring och knivkontroll, med några veckors mellanrum. Skrapa bort gräs och jord under klippdäcket, torka av kameralinsen och känn på knivarnas egg. Slöa knivar river av grässtrået i stället för att skära det, vilket ger gulnade toppar och mer strömförbrukning per pass.
      </p>
      <p class="text-text-light leading-relaxed mb-6">
        Byt hela knivsatsen samtidigt. En enda ny kniv mot två slitna ger obalans i klippdäcket, vilket hörs som vibration och sliter på lagren. Sand, kottar och grus är det som slöar knivarna snabbast, så tomter med grusgång intill gräset behöver bytas oftare än rena gräsytor. Vad som passar vilken modell går vi igenom under <a href="/reservdelar/knivar/" class="text-accent underline">reservknivar till robotgräsklippare</a>.
      </p>

      <h3 class="font-heading text-xl font-bold text-text mb-3">Hur ofta ska en Segway Navimow klippa?</h3>
      <p class="text-text-light leading-relaxed mb-3">
        Ofta och lite i taget. En robotgräsklippare tar bara några millimeter per pass och klippet faller ner i mattan som mulch, alltså näring som återförs till gräset. Kör den för sällan blir klippet så långt att det lägger sig som strån ovanpå ytan i stället.
      </p>
      <p class="text-text-light leading-relaxed mb-6">
        Lägg därför schemat med marginal snarare än snålt. Gräset växer betydligt snabbare i maj och juni än i augusti, så det schema som räcker sent på säsongen ligger ofta efter under högsommaren. Eftersom zonerna ligger i appen kan du enkelt köra vissa partier oftare, till exempel den solbelysta delen av tomten, utan att röra en enda kabel.
      </p>
    </section>

    <FAQ items={faqItems} />


    <section class="mt-10 p-5 bg-bg-alt rounded-xl border border-border">
      <h2 class="font-heading text-lg font-bold text-text mb-3">Relaterade guider</h2>
      <ul class="space-y-2">
        <li><a href="/robotgrasklippare/" class="text-accent underline text-sm">Bästa robotgräsklippare 2026, alla märken jämförda</a></li>
        <li><a href="/segway-navimow-i105e/" class="text-accent underline text-sm">Segway Navimow i105E, recension 2026</a></li>
        <li><a href="/segway-navimow-h500e/" class="text-accent underline text-sm">Segway Navimow H500E, recension 2026</a></li>
        <li><a href="/segway-navimow-h800e/" class="text-accent underline text-sm">Segway Navimow H800E, recension 2026</a></li>
        <li><a href="/mammotion-vs-segway-navimow/" class="text-accent underline text-sm">Mammotion vs Segway Navimow, vilken ska du välja?</a></li>
        <li><a href="/gardena-vs-segway-navimow/" class="text-accent underline text-sm">Gardena vs Segway Navimow, jämförelse 2026</a></li>
      </ul>
    </section>
  </div>

  <StickyCTA text="Se bästa Segway Navimow 2026" url="#modeller" />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Segway Navimow robotgräsklippare 2026",
    "description": "Segway Navimow-modeller utan perimeterkabel jämförda 2026.",
    "numberOfItems": 3,
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Segway Navimow i105E", "url": "https://robotjakt.se/segway-navimow-i105e/" },
      { "@type": "ListItem", "position": 2, "name": "Segway Navimow H500E", "url": "https://robotjakt.se/segway-navimow-h500e/" },
      { "@type": "ListItem", "position": 3, "name": "Segway Navimow H800E", "url": "https://robotjakt.se/segway-navimow-h800e/" },
    ],
  })} />
  {/* FAQPage schema emitteras via FAQ-komponenten */}
</BaseLayout>
