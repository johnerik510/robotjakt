const faqItems = [
  {
    question: 'Hur ofta ska jag byta borstar på robotdammsugaren?',
    answer: 'Sidoborstar slits snabbast, byt var 6 till 12 månad eller när de böjer sig och inte längre är raka. Huvudborsten håller 12 till 18 månader. Kontrollera regelbundet att inga hår eller trådar fastnat runt axeln.',
  },
  {
    question: 'Vad är skillnaden mellan gummiborste och borstborste?',
    answer: 'Gummiborstar är bättre för hårda golv och lämnar inga borstrester. Traditionella borstborstar är effektivare på mattor. De flesta moderna Roborock- och Dreamemodeller levereras med gummiborstar som standardbyte.',
  },
  {
    question: 'Passar tredjepartsborstar lika bra som original?',
    answer: 'Ja, i de flesta fall. Välj borstar som tydligt anger kompatibla modeller och kontrollera kundrecensioner. Undvik extremt billiga borstar utan modellspecifikation, de kan ha fel dimensioner och sitta löst.',
  },
  {
    question: 'Hur ser du att borstarna är slitna?',
    answer: 'Titta på formen. Sidoborstarnas armar ska vara raka, böjer de sig utåt sveper de inte längre in smuts mot munstycket. På huvudborsten känner du efter om gummiläpparna eller stråna är nednötta och greppar sämre mot golvet. Hår som lindat sig hårt runt axeln och inte går att få loss är ett lika tydligt tecken. Sämre städresultat på en robot som annars fungerar beror oftast på just det här.',
  },
  {
    question: 'Går det att rengöra borstarna i stället för att byta dem?',
    answer: 'Ja, och det bör du göra långt innan bytet blir aktuellt. Klipp loss håret längs borsten med en sax och dra ut resterna, gärna varannan vecka i hem med hund, katt eller långt hår. Skölj av borsten och låt den torka helt innan du monterar tillbaka den. Rengöring håller städresultatet uppe men rätar inte ut en böjd sidoborste eller återställer nednötta gummiläppar.',
  },
  {
    question: 'Vilken borste passar bäst i ett hem med husdjur eller långt hår?',
    answer: 'Gummiborste. Traditionella borstvalsar med strån fångar långa hårstrån som lindar sig runt axeln, medan gummivalsar låter håret glida av mot dammkorgen. Helt fria från hår blir de inte, men du behöver klippa loss betydligt mer sällan. Nackdelen är att gummiborsten är något mindre effektiv på mattor än en traditionell borste med strån.',
  },
  {
    question: 'Lönar det sig att köpa ett komplett kit i stället för lösa borstar?',
    answer: 'Oftast ja. Kiten innehåller det som ändå ska bytas ungefär samtidigt: huvudborste, sidoborstar, HEPA-filter och beroende på modell även moppdukar och dammpåsar. Du betalar mindre per del och slipper lägga en ny beställning varje gång filtret sätter igen. Har du redan filter hemma kan lösa borstar bli billigare, men då är risken större att filterbytet skjuts upp.',
  },
  {
    question: 'Behöver du verktyg för att byta borstarna?',
    answer: 'Sällan något utöver det som följer med. Huvudborsten sitter under ett lock som du lossar för hand och lyfter av, medan sidoborstarna fästs med en liten skruv eller ett snäpplås beroende på modell. Sitter sidoborsten fast med skruv räcker en liten stjärnskruvmejsel. Passa på att torka ur borstkanalen medan roboten ändå ligger upp och ned.',
  },
];

const breadcrumbs = [
  { label: 'Reservdelar', href: '/reservdelar/' },
  { label: 'Borstar' },
];

const faqSchema = faqItems.map((item) => ({
  "@type": "Question",
  "name": item.question,
  "acceptedAnswer": {
    "@type": "Answer",
    "text": item.answer,
  },
}));
export const articleMeta = {
  title: "Reservborstar till robotdammsugare 2026: guide och köp",
  description: "Köpguide till reservborstar för robotdammsugare 2026. Huvudborstar, sidoborstar och gummirullar. Se byte-intervall, kompatibilitet och bästa priser.",
  publishDate: "2026-03-29",
  category: "Reservdelar",
  image: "/images/parts-robot-kit-3.webp",
};

---

<BaseLayout
  title="Reservborstar till robotdammsugare 2026: guide och köp"
  description="Köpguide till reservborstar för robotdammsugare 2026. Huvudborstar, sidoborstar och gummirullar. Se byte-intervall, kompatibilitet och bästa priser."
  article={{ datePublished: "2026-03-29", dateModified: "2026-07-27", image: "/images/parts-robot-kit-3.webp" }}
>
  <section class="bg-primary text-white py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} light={true} />
    <AuthorByline datePublished="2026-03-29" dateModified="2026-07-27" />
      <h1 class="font-heading text-3xl sm:text-4xl font-bold mb-3">Ersättningsborstar till robotdammsugare</h1>
      <p class="text-gray-200 max-w-2xl">Huvud- och sidoborstar till Roborock, Dreame och Ecovacs. Byt slitna borstar för att hålla sugkraft och städkvalitet på topp.</p>
    </div>
  </section>

  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
<p class="text-sm text-text-light mb-2">Senast uppdaterad: juli 2026, {products.length} borstar och tillbehörskit</p>

    <AnswerBox
      question="Snabbt svar: När ska borstarna på robotdammsugaren bytas?"
      answer="Byt sidoborstar var 6 till 12 månad och huvudborsten var 12 till 18 månad, eller tidigare om borsten är böjd, sliten eller full av hår som inte går att ta bort. Tredjepartskit med borstar, filter och moppdukar fungerar bra, kontrollera bara att kitet uttryckligen anger din modell."
    />

    <div class="bg-accent/5 border border-accent/20 rounded-xl px-5 py-4 mb-8 text-sm text-text">
      <strong>Tips:</strong> Köp ett komplett kit (borstar + filter + moppkuddar), du sparar pengar och behöver bara beställa en gång.
    </div>

    <div class="space-y-4 mb-10">
      {products.map((p, i) => (
        <article class="bg-white rounded-xl border border-border shadow-sm transition-shadow p-5">
          <div class="flex flex-col sm:flex-row gap-4">
            <div class="flex-shrink-0 flex flex-col items-center gap-2">
              {i === 0 && p.badge && <span class="text-xs font-bold uppercase px-3 py-1 rounded-full bg-winner/10 text-winner">{p.badge}</span>}
              {i > 0 && p.badge && <span class="text-xs font-bold uppercase px-3 py-1 rounded-full bg-bg-alt text-text-light">{p.badge}</span>}
              {p.img && (
                <div class="w-32 h-32 bg-gray-50 rounded-xl p-2 flex items-center justify-center border border-border">
                  <img src={p.img} alt={p.name} class="w-full h-full object-contain" loading="lazy" width="200" height="200" />
                </div>
              )}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex flex-wrap items-start gap-2 mb-1">
                <h2 class="font-heading font-bold text-text text-base">{p.name}</h2>
                <span class="text-xs bg-bg-alt text-text-light px-2 py-0.5 rounded-full">{p.type}</span>
              </div>
              <p class="text-xs text-accent font-medium mb-2">{p.compat}</p>
              {p.includes && (
                <p class="text-xs text-text-light mb-4"><strong class="text-text">Innehåller:</strong> {p.includes}</p>
              )}
              <div class="flex flex-wrap items-center gap-3">
                {p.buyUrl && (
                  <a
                    href={p.buyUrl}
                    rel="sponsored nofollow noopener noreferrer"
                    target="_blank"
                    class="inline-flex items-center justify-center bg-cta hover:bg-cta-dark text-white font-semibold px-5 py-2.5 rounded-lg transition-colors text-sm min-h-[44px]"
                  >
                    Bra pris hos {p.store}
                  </a>
                )}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <section class="mb-8">
      <h2 class="font-heading text-xl font-bold text-text mb-4">Fler reservdelar</h2>
      <div class="grid sm:grid-cols-2 gap-3">
        <a href="/reservdelar/filter/" class="bg-white border border-border rounded-lg px-4 py-3 hover:border-accent transition-all text-sm font-semibold text-text hover:text-accent">Filter till robotdammsugare</a>
        <a href="/reservdelar/roborock/" class="bg-white border border-border rounded-lg px-4 py-3 hover:border-accent transition-all text-sm font-semibold text-text hover:text-accent">Alla Roborock reservdelar</a>
        <a href="/reservdelar/dreame/" class="bg-white border border-border rounded-lg px-4 py-3 hover:border-accent transition-all text-sm font-semibold text-text hover:text-accent">Alla Dreame reservdelar</a>
        <a href="/reservdelar/ecovacs/" class="bg-white border border-border rounded-lg px-4 py-3 hover:border-accent transition-all text-sm font-semibold text-text hover:text-accent">Alla Ecovacs reservdelar</a>
      </div>
    </section>

    <!-- Fördjupning: borstbyte -->
    <section class="mb-8">
      <h2 class="font-heading text-xl font-bold text-text mb-4">Bra att veta innan du byter borstar</h2>
      <div class="space-y-5">

        <div>
          <h3 class="font-semibold text-text mb-2">Varför tappar robotdammsugaren sugkraft fast den är hel?</h3>
          <p class="text-text-light text-sm leading-relaxed mb-3">
            Oftast handlar det om slitdelar, inte om motorn. Böjda sidoborstar slutar mata in smuts mot munstycket, en sliten huvudborste greppar sämre mot golvet och ett igensatt HEPA-filter stryper luftflödet genom roboten. Byt de delarna och sugkraften brukar vara tillbaka på nyskick.
          </p>
          <p class="text-text-light text-sm leading-relaxed">
            HEPA-filtret är den vanligaste boven eftersom det fångar fina partiklar som gradvis täpper igen filtermaterialet, och slitaget syns inte alltid utanpå. Filtret beställer du separat, och vi har en egen genomgång av <a href="/reservdelar/filter/" class="text-accent underline">filter till robotdammsugare</a>.
          </p>
        </div>

        <div>
          <h3 class="font-semibold text-text mb-2">Hur vet jag att en borste passar min robotmodell?</h3>
          <p class="text-text-light text-sm leading-relaxed mb-3">
            Kontrollera att din exakta modell står i produktens kompatibilitetslista, det räcker inte att märket stämmer. Modeller inom samma serie delar ofta slitdelar, Dreame D10 Plus, D10 och D9 Max tar till exempel samma sidoborste, men mellan serier skiljer sig infästningar och dimensioner, och fel dimension gör att borsten sitter löst.
          </p>
          <p class="text-text-light text-sm leading-relaxed">
            Är du osäker på vilken serie din robot tillhör hittar du modellnamnet på etiketten under roboten. Vi har även samlat alla delar per serie, till exempel <a href="/reservdelar/roborock-s8-serien/" class="text-accent underline">reservdelar till Roborock S8-serien</a>.
          </p>
        </div>

      </div>
    </section>

    <FAQ items={faqItems} />

  </main>
</BaseLayout>
