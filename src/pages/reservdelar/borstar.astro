  },
  {
    img: '/images/parts/dreame-rsb7-sidoborste-d10-plus.webp',
    name: 'Dreame RSB7 sidoborste',
    compat: 'Passar: Dreame D10 Plus, D10, D9 Max',
    includes: null,
    badge: null,
