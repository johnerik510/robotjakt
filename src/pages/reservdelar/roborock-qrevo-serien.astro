---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import FAQ from '../../components/FAQ.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AnswerBox from '../../components/AnswerBox.astro';

const TAG = 'johnerik510-20';

const products = [
  {
    asin: 'B0CY5CWRXQ',
    name: 'Roborock Qrevo S / Qrevo Pro / Qrevo MaxV, 20-delars kit',
    compat: 'Passar: Qrevo S, Qrevo Pro, Qrevo MaxV Ultra, Qrevo Plus',
    includes: '1 gummiborste, 6 sidoborstar, 4 HEPA-filter, 4 moppkuddar, 4 dammpåsar',
    badge: 'Bästsäljare',
  },
  {
    asin: 'B0DG5J1QK7',
    name: 'Roborock Qrevo Pro / Qrevo S / Qrevo MaxV, 22-delars kit',
    compat: 'Passar: Qrevo Pro, Qrevo S, Qrevo MaxV Ultra',
    includes: '2 gummiborstar, 6 sidoborstar, 4 HEPA-filter, 4 dammpåsar, 4 mopptorkdukar',
    badge: 'Mest komplett',
  },
  {
    asin: 'B0DG5H9HLH',
    name: 'Roborock Qrevo S / Qrevo Pro / Qrevo MaxV, 21-delars kit',
    compat: 'Passar: Qrevo S, Qrevo Pro, Qrevo MaxV Ultra',
    includes: '1 gummiborste, 4 sidoborstar, 4 HEPA-filter, 4 mopptorkdukar, 6 dammpåsar',
    badge: 'Bästa pris',
  },
  {
    asin: 'B0CNMFPF5K',
    name: 'Roborock Qrevo Master, dammpåsar 5-pack',
    compat: 'Passar: Qrevo Master, Qrevo MaxV Ultra (med automatisk station)',
    includes: '5 dammpåsar för automatisk tömningsstation',
    badge: null,
  },
  {
    asin: 'B0CG35BWMW',
    name: 'Roborock Qrevo-serien, HEPA-filter 4-pack',
    compat: 'Passar: Qrevo S, Qrevo Pro, Qrevo MaxV Ultra, Qrevo Master',
    includes: '4 HEPA E11-filter',
    badge: 'Bästa filterpris',
  },
];

const faqItems = [
  {
    question: 'Delar Qrevo Pro och Qrevo Master samma reservdelar?',
    answer: 'Nej, Qrevo Master har ett eget reservdelssystem. Qrevo Pro, Qrevo S och Qrevo MaxV Ultra delar systemet. Kontrollera alltid att din exakta modell anges som kompatibel i produktbeskrivningen. Dammpåsarna är modellspecifika, blanda inte mellan Qrevo Master och Qrevo Pro.',
  },
  {
    question: 'Hur ofta byter jag reservdelar på Roborock Qrevo Pro?',
    answer: 'HEPA-filter: var 2 månad. Sidoborstar: var 6 till 12 månad. Gummiborste (huvudrulle): var 12 månad. Moppkuddar: tvätta efter varje städning med varm mopptvättning, byt vid slitage. Dammpåsar: när fyllda, ca var 4 till 6 vecka.',
  },
  {
    question: 'Kan Qrevo-seriens moppkuddar tvättas i maskin?',
    answer: 'Originalmoppkuddarna kan tvättas i maskin i 40°C. Stationens inbyggda mopptvättning med varmt vatten sköter den löpande rengöringen, maskintvätt rekommenderas var 2 till 4 vecka som komplettering.',
  },
  {
    question: 'Var köper jag billigaste Qrevo-reservdelar?',
    answer: 'Amazon erbjuder generellt de billigaste tredjepartsalternativen, ofta 50 till 70% billigare än originalen. Sök på din exakta modell (t.ex. "Roborock Qrevo Pro reservdelar") och välj kit med högt antal recensioner och god kompatibilitetsbekräftelse.',
  },
  {
    question: 'Är tredjepartsdelar lika bra som Roborocks originaldelar?',
    answer: 'För filter, sidoborstar och dammpåsar duger de oftast utmärkt och kostar klart mindre. Svagheten är jämnheten mellan tillverkningsomgångar. En påse eller ett filter som inte sitter helt tätt släpper förbi damm, och då märks det som sämre sugkraft. Välj kit med många recensioner och en kompatibilitetslista som nämner din exakta modell, så minskar risken rejält.',
  },
  {
    question: 'Hur ser jag att sidoborstarna behöver bytas?',
    answer: 'När stråna böjt sig permanent och inte längre sopar in smuts mot huvudborsten. Bockade strån når inte hela vägen fram till golvlisten, och det syns som en kvarlämnad smutsrand längs kanterna trots att roboten kört. Rensa hår från borstfästet med jämna mellanrum. Normalintervallet är 6 till 12 månader, kortare i hem med långhåriga husdjur.',
  },
  {
    question: 'Passar Qrevo-delar till andra Roborock-serier, till exempel S8?',
    answer: 'Utgå från att de inte gör det. Roborock använder olika delsystem mellan serierna, och redan inom Qrevo-familjen har Master egna dammpåsar som inte passar Qrevo S eller Qrevo Pro. Kontrollera alltid kompatibilitetslistan mot ditt exakta modellnamn innan du beställer. För S8-modellerna finns en egen reservdelssida med rätt delar.',
  },
  {
    question: 'Hur vet jag när dammpåsen i stationen behöver bytas?',
    answer: 'Appen säger till när påsen är full, och i normalt bruk landar det på ungefär 4 till 6 veckor. Har du husdjur eller drar in mycket sand och grus går den fortare. Byt hellre någon vecka för tidigt än för sent, eftersom en överfull påse stryper luftflödet och gör den automatiska tömningen sämre. Ha alltid en extra påse hemma.',
  },
];

const breadcrumbs = [
  { label: 'Reservdelar', href: '/reservdelar/' },
  { label: 'Roborock Qrevo-serien reservdelar' },
];

const faqSchema = faqItems.map(item => ({
  "@type": "Question",
  "name": item.question,
  "acceptedAnswer": { "@type": "Answer", "text": item.answer },
}));
export const articleMeta = {
  title: "Reservdelar Roborock Qrevo serien 2026: guide och köp",
  description: "Reservdelar till Roborock Qrevo-serien 2026. Filter, borstar och moppar till Qrevo Master, MaxV Ultra och Pro. Se kompatibilitet och pris i Sverige.",
  publishDate: "2026-04-05",
  category: "Reservdelar",
  image: "/images/parts-roborock-qrevo-kit.webp",
};

---

<BaseLayout
  title="Reservdelar Roborock Qrevo serien 2026: guide och köp"
  description="Reservdelar till Roborock Qrevo-serien 2026. Filter, borstar och moppar till Qrevo Master, MaxV Ultra och Pro. Se kompatibilitet och pris i Sverige."
  article={{ datePublished: "2026-04-05", dateModified: "2026-07-27", image: "/images/parts-roborock-qrevo-kit.webp" }}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <Breadcrumbs items={breadcrumbs} />
    <AuthorByline datePublished="2026-04-05" dateModified="2026-07-27" />
<p class="text-xs text-text-lighter mb-4">Senast uppdaterad: 2026-07-27</p>

    <h1 class="font-heading text-3xl sm:text-4xl font-bold text-text mb-3 leading-tight">
      Roborock Qrevo-serien Reservdelar 2026
    </h1>
    <AnswerBox
      question="Snabbt svar: Vilka reservdelar passar Roborock Qrevo-serien?"
      answer="Qrevo S, Qrevo Pro och Qrevo MaxV Ultra delar samma reservdelssystem, medan Qrevo Master har ett eget med modellspecifika dammpåsar. Byt HEPA-filter var 2 månad, sidoborstar var 6 till 12 månad och gummiborsten var 12 månad. Tredjepartskit på Amazon kostar ofta 50 till 70 procent mindre än originalen."
    />
    <p class="text-text-light text-lg mb-6 leading-relaxed">
      Roborock Qrevo-serien kräver byte av HEPA-filter var 2-3 månader och sidoborste var 2 månader. Qrevo Master med utfällbar sidoarm har egna reservdelar för armens borste (byte var 3 månader). Rätt delar till Qrevo S, Qrevo Pro, Qrevo MaxV Ultra och Qrevo Master.
    </p>

    <div class="space-y-4 mb-10">
      {products.map(p => (
        <div class="bg-white rounded-xl border border-border p-5">
          <div class="flex flex-col sm:flex-row sm:items-start gap-4">
            <div class="flex-1">
              <div class="flex items-start gap-3 mb-2">
                {p.badge && (
                  <span class="bg-accent text-white text-xs font-bold px-2 py-0.5 rounded flex-shrink-0">{p.badge}</span>
                )}
                <h2 class="font-semibold text-text text-sm leading-snug">{p.name}</h2>
              </div>
              <p class="text-xs text-text-lighter mb-1"><span class="font-medium">Passar:</span> {p.compat}</p>
              <p class="text-xs text-text-light mb-3"><span class="font-medium">Innehaller:</span> {p.includes}</p>
              <div class="flex items-center gap-4">
                
                
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <section class="mb-10">
      <h2 class="font-heading text-2xl font-bold text-text mb-4">Underhållsschema, Roborock Qrevo-serien</h2>
      <div class="bg-bg-alt rounded-xl border border-border overflow-hidden">
        <table class="cmp-table table-fixed w-full text-sm">
          <thead>
            <tr class="bg-primary text-white">
              <th class="px-4 py-3 text-left font-semibold">Del</th>
              <th class="px-4 py-3 text-left font-semibold">Bytesintervall</th>
              <th class="px-4 py-3 text-left font-semibold">Tips</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            <tr class="bg-white"><td class="px-4 py-3 font-medium">HEPA-filter</td><td class="px-4 py-3 text-text-light">Var 2 månad</td><td class="px-4 py-3 text-text-light">Knacka rent varje vecka</td></tr>
            <tr><td class="px-4 py-3 font-medium">Sidoborstar</td><td class="px-4 py-3 text-text-light">Var 6 till 12 månad</td><td class="px-4 py-3 text-text-light">Byt vid bockning</td></tr>
            <tr class="bg-white"><td class="px-4 py-3 font-medium">Gummiborste</td><td class="px-4 py-3 text-text-light">Var 12 månad</td><td class="px-4 py-3 text-text-light">Rengör från har regelbundet</td></tr>
            <tr><td class="px-4 py-3 font-medium">Moppkuddar</td><td class="px-4 py-3 text-text-light">Tvatta varje vecka</td><td class="px-4 py-3 text-text-light">Station sköter vardagstvätten</td></tr>
            <tr class="bg-white"><td class="px-4 py-3 font-medium">Dammpase</td><td class="px-4 py-3 text-text-light">När full (4 till 6 veckor)</td><td class="px-4 py-3 text-text-light">App meddelar när det är dags</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="mb-10">
      <h3 class="font-heading text-lg font-bold text-text mb-2">Hur vet jag vilket kit som passar min Qrevo-modell?</h3>
      <p class="text-sm text-text-light leading-relaxed mb-3">
        Kontrollera alltid kompatibilitetslistan i produktbeskrivningen mot din exakta modell. Qrevo S, Qrevo Pro och Qrevo MaxV Ultra delar reservdelssystem och kan använda samma kit, medan Qrevo Master kräver egna delar. Dammpåsarna är modellspecifika, så blanda aldrig påsar mellan Qrevo Master och övriga serien.
      </p>
      <p class="text-sm text-text-light leading-relaxed mb-6">
        Modellnamnet hittar du i Roborock-appen eller på etiketten på robotens undersida. Är du osäker på vilken Qrevo-variant du faktiskt äger, eller funderar på att byta upp dig, ger vår <a href="/roborock-guide/" class="text-accent underline">guide till alla Roborock-modeller</a> en överblick över hur serierna skiljer sig åt.
      </p>

      <h3 class="font-heading text-lg font-bold text-text mb-2">Varför tappar min Qrevo sugkraft mellan filterbytena?</h3>
      <p class="text-sm text-text-light leading-relaxed mb-3">
        Ett igensatt HEPA-filter är den vanligaste orsaken till försämrad sugkraft. När filtret täpps igen av fint damm stryps luftflödet genom roboten och motorn får arbeta hårdare med sämre resultat. Knacka rent filtret varje vecka och byt var 2 månad, så håller du sugkraften jämn.
      </p>
      <p class="text-sm text-text-light leading-relaxed mb-6">
        Hår som lindats runt gummiborsten och sidoborstarna försämrar upptaget på samma sätt, rengör dem därför regelbundet mellan bytena. Behöver du bara fylla på filter i stället för ett helt kit finns samlade alternativ på vår sida om <a href="/reservdelar/filter/" class="text-accent underline">filter till robotdammsugare</a>.
      </p>

      <h3 class="font-heading text-lg font-bold text-text mb-2">Hur ofta behöver Qrevo-moppkuddarna bytas?</h3>
      <p class="text-sm text-text-light leading-relaxed mb-3">
        Stationens mopptvätt med varmt vatten sköter den löpande rengöringen, så kuddarna behöver sällan bytas i förtid. Komplettera med maskintvätt i 40 grader var 2 till 4 vecka, och byt först när mikrofibern blivit stel, tovig eller tunnsliten. Då tappar den vattenupptagningen och lämnar strimmor.
      </p>
      <p class="text-sm text-text-light leading-relaxed mb-3">
        Tvättar du kuddarna sällan sätter sig fett och fint damm i fibrerna, och då sprider moppen smutsen vidare i stället för att lyfta den. En kudde som fortfarande känns mjuk och luddig har kvar sin funktion, oavsett hur många körningar den har bakom sig.
      </p>
      <p class="text-sm text-text-light leading-relaxed mb-6">
        Kör du roboten med mopp varje dag går kuddarna fortare. Räkna med tätare byten i hem med husdjur eller mycket utomhussmuts. Ska du välja mopputrustning från grunden hittar du modellerna vi rekommenderar i vår guide till <a href="/robotdammsugare/med-mopp/" class="text-accent underline">robotdammsugare med moppfunktion</a>.
      </p>

      <h3 class="font-heading text-lg font-bold text-text mb-2">Behöver Qrevo Master egna delar till sidoarmen?</h3>
      <p class="text-sm text-text-light leading-relaxed mb-3">
        Ja. Qrevo Master har en utfällbar sidoarm som når in i hörn och längs kanter, och armens borste är en egen förbrukningsdel med byte ungefär var 3 månad. Den ingår inte i standardkiten för Qrevo S, Qrevo Pro och Qrevo MaxV Ultra.
      </p>
      <p class="text-sm text-text-light leading-relaxed mb-3">
        Samma sak gäller dammpåsarna. Qrevo Masters påsar är modellspecifika och passar inte de övriga Qrevo-varianterna. Beställer du ett samlingskit till serien får du alltså inte automatiskt allt din Master behöver, läs kompatibilitetslistan post för post innan du lägger i varukorgen.
      </p>
      <p class="text-sm text-text-light leading-relaxed">
        Är du osäker på om sidoarmen och det egna delsystemet motiverar Master-modellen framför en enklare Qrevo, går vi igenom vad den faktiskt gör bättre i vår <a href="/roborock-qrevo-master/" class="text-accent underline">Roborock Qrevo Master recension</a>.
      </p>
    </section>

    <FAQ items={faqItems} />


    <section class="mt-10 p-5 bg-bg-alt rounded-xl border border-border">
      <h2 class="font-heading text-lg font-bold text-text mb-3">Relaterade sidor</h2>
      <ul class="space-y-2">
        <li><a href="/reservdelar/roborock/" class="text-accent underline text-sm">Alla Roborock reservdelar</a></li>
        <li><a href="/reservdelar/roborock-s8-serien/" class="text-accent underline text-sm">Roborock S8-serien reservdelar</a></li>
        <li><a href="/roborock-qrevo-master/" class="text-accent underline text-sm">Roborock Qrevo Master recension</a></li>
        <li><a href="/roborock-qrevo-pro/" class="text-accent underline text-sm">Roborock Qrevo Pro recension</a></li>
        <li><a href="/roborock-guide/" class="text-accent underline text-sm">Roborock, alla modeller guide 2026</a></li>
      </ul>
    </section>
  </div>

<style>
  .cmp-table th,
  .cmp-table td {
    overflow-wrap: break-word;
    hyphens: auto;
    vertical-align: top;
  }
  @media (max-width: 640px) {
    .cmp-table { font-size: 0.75rem; line-height: 1.25rem; }
    .cmp-table th,
    .cmp-table td { padding: 0.4rem 0.45rem; }
  }
</style>

</BaseLayout>
