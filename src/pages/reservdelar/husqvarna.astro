---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import FAQ from '../../components/FAQ.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AnswerBox from '../../components/AnswerBox.astro';


const knivar = [
  {
    img: null,
    name: 'Husqvarna knivar till Husqvarna Automower 36 st',
    compat: 'Passar: Husqvarna Automower',
    includes: '36 knivar',
    badge: 'Husqvarna original',
    detail: 'Originalknivar från Husqvarna, storpack för hela säsongen',
    store: 'CS Megastore',
    url: 'https://go.csmegastore.se/t/t?a=1514097163&as=2063681412&t=2&tk=1&cupa_sku=25417320&url=https://www.csmegastore.se/i/25417320/husqvarna-knivar-till-husqvarna-automower-36-st',
  },
  {
    img: null,
    name: 'Japcell knivar till Husqvarna Automower/Gardena/Greenworks Optimow - 30 st. titanbelagt stål inkl. skruvar',
    compat: 'Passar: Husqvarna Automower, Gardena, Greenworks Optimow',
    includes: '30 knivar i titanbelagt stål, skruvar ingår',
    badge: 'Titanbelagt stål',
    detail: 'Titanbelagt stål, skruvar följer med i paketet',
    store: 'CS Megastore',
    url: 'https://go.csmegastore.se/t/t?a=1514097163&as=2063681412&t=2&tk=1&cupa_sku=24130011&url=https://www.csmegastore.se/i/24130011/japcell-knivar-till-husqvarna-automower-gardena-greenworks-optimow-30-st-titanbelagt-st%c3%a5l-inkl-skruvar',
  },
  {
    img: null,
    name: 'Husqvarna knivar för AUTOMOWER 9 st',
    compat: 'Passar: Husqvarna Automower',
    includes: '9 knivar',
    badge: null,
    detail: 'Originalknivar från Husqvarna i mindre förpackning',
    store: 'CS Megastore',
    url: 'https://go.csmegastore.se/t/t?a=1514097163&as=2063681412&t=2&tk=1&cupa_sku=25417317&url=https://www.csmegastore.se/i/25417317/husqvarna-knivar-f%c3%b6r-automower-9-st',
  },
];

const kabel = [
  {
    asin: 'B0DRHWXPHC',
    img: null,
    name: 'Forever Speed, begränsningskabel 100 m, 2,7 mm',
    compat: 'Passar: Husqvarna Automower, Gardena Sileno, Worx Landroid, McCulloch',
    includes: '100 m kabel, diameter 2,7 mm, förtennad koppar med aluminiumskikt',
    badge: null,
    detail: 'Räcker till tomter upp till ca 800 kvm',
  },
  {
    asin: 'B0DRHXG9WX',
    img: null,
    name: 'Forever Speed, begränsningskabel 150 m, 2,7 mm',
    compat: 'Passar: Husqvarna Automower, Gardena Sileno, Worx Landroid, McCulloch',
    includes: '150 m kabel, diameter 2,7 mm, förtennad koppar med aluminiumskikt',
    badge: 'Stor tomt',
    detail: 'Räcker till tomter upp till ca 1 500 kvm',
  },
  {
    asin: 'B0D9QB7H3S',
    img: null,
    name: '20-pack kabelklämmor, reparerar och skarvar begränsningskabel',
    compat: 'Passar: Gardena, Husqvarna och alla kabeldrivna robotgräsklippare',
    includes: '20 anslutningsklämmor, passar kabel 2,7 till 3,4 mm',
    badge: null,
    detail: 'Nödvändigt vid kabelbrott, enkelt att montera utan verktyg',
  },
];

const faqItems = [
  {
    question: 'Hur ofta ska jag byta knivar på Husqvarna Automower?',
    answer: 'Byt knivar varje säsong (april, maj) eller om gräset ser ojämnt klippt ut under säsongen. Med hård eller stenig mark slits knivarna fortare, kontrollera var 4 till 6 vecka.',
  },
  {
    question: 'Passar universalblad i min Husqvarna Automower?',
    answer: 'Ja, universalblad passar alla standardmodeller (105, 115H, 310, 315, 315X, 430X, 450X) som använder det vanliga triangulära hållarsystemet. Kontrollera kompatibilitetslistan i produktbeskrivningen.',
  },
  {
    question: 'Min begränsningskabel är bruten, måste jag byta hela kabeln?',
    answer: 'Nej. Använd kabelklämmor för att skärva ihop kabeln vid brottstället. Det tar 5 minuter och kostar till lägre pris per skärv. Du behöver bara byta hela kabeln om den är skadad på många ställen.',
  },
  {
    question: 'Vad är skillnaden mellan 100 m och 150 m begränsningskabel?',
    answer: '100 m räcker för tomter upp till ca 800 kvm. För tomter upp till 1 500 kvm behöver du 150 m. Mät runt tomtens perimeter och lägg till kabel för interna zongränser och laddningsstationens spiralkabel.',
  },
  {
    question: 'Hur ser du att knivarna behöver bytas?',
    answer: 'Titta på gräsmattan innan du tittar på roboten. Slöa blad sliter av stråna i stället för att kapa dem, och de trasiga topparna brunfärgas så att hela ytan ser tröttare ut trots att klipparen kört som vanligt. Vänd sedan klipparen och känn på bladen: böjda, spruckna eller märkbart nedslipade kanter betyder byte. På hård eller stenig mark kontrollerar du var 4 till 6 vecka.',
  },
  {
    question: 'Är originalblad bättre än universalblad?',
    answer: 'Inte automatiskt. Det som avgör passformen är hållarsystemet och bladtjockleken, alltså 0,75 mm och det triangulära fästet som Automower 105, 115H, 310, 315, 315X, 430X och 450X använder. Skillnaden mellan enkla och dyrare blad sitter i stålet: förstärkta eller titanhärdade blad håller längre på steniga tomter med mycket hinder. Kontrollera alltid kompatibilitetslistan innan du beställer.',
  },
  {
    question: 'Måste du byta skruvarna samtidigt som knivarna?',
    answer: 'Ja, använd de nya skruvarna som följer med bladpaketen och återanvänd aldrig de gamla. En sliten skruv kan tappa greppet i gängan och lossna under drift. Byt dessutom alla blad vid samma tillfälle, inte bara det som ser sämst ut, annars blir klippskivan obalanserad och du får vibrationer och ojämnt klippresultat. Stäng av med huvudströmbrytaren innan du vänder på klipparen.',
  },
  {
    question: 'Passar bladen även till andra märken än Husqvarna?',
    answer: 'Ofta, men kontrollera listan för det specifika paketet. Japcells titanbelagda blad anges passa Husqvarna Automower, Gardena och Greenworks Optimow, medan Husqvarnas egna knivpaket bara listas för Automower. Det som styr är att fästet är av samma triangulära typ och att bladtjockleken stämmer. Passar inte hållaren är bladen värdelösa oavsett vad förpackningen lovar.',
  },
];

const breadcrumbs = [
  { label: 'Reservdelar', href: '/reservdelar/' },
  { label: 'Husqvarna Automower' },
];

const faqSchema = faqItems.map((item) => ({
  "@type": "Question",
  "name": item.question,
  "acceptedAnswer": {
    "@type": "Answer",
    "text": item.answer,
  },
}));
export const articleMeta = {
  title: "Husqvarna Automower knivar och kabel, modell för modell",
  description: "Vilka knivar passar din Husqvarna Automower? Se hållarsystem och kompatibilitet för 105, 115H, 310, 315, 315X, 430X och 450X, plus kabel och klämmor.",
  publishDate: "2026-03-29",
  category: "Reservdelar",
  image: "/images/parts-husqvarna-blade.webp",
};

---

<BaseLayout
  title="Husqvarna Automower knivar och kabel, modell för modell"
  description="Vilka knivar passar din Husqvarna Automower? Se hållarsystem och kompatibilitet för 105, 115H, 310, 315, 315X, 430X och 450X, plus kabel och klämmor."
  article={{ datePublished: "2026-03-29", dateModified: "2026-07-27", image: "/images/parts-husqvarna-blade.webp" }}
>
  <section class="bg-primary text-white py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} light={true} />
    <AuthorByline datePublished="2026-03-29" dateModified="2026-07-27" />
      <h1 class="font-heading text-3xl sm:text-4xl font-bold mb-3">Husqvarna Automower knivar, modell för modell</h1>
      <p class="text-gray-200 max-w-2xl">Bladen sitter i det triangulära hållarsystem som Automower 105, 115H, 310, 315, 315X, 430X och 450X delar. Här finns originalknivar från Husqvarna, titanbelagda blad från Japcell samt begränsningskabel och kabelklämmor som passar Automower.</p>
    </div>
  </section>

  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
<p class="text-sm text-text-light mb-3">Senast uppdaterad: juli 2026, {knivar.length + kabel.length} produkter</p>

    <AnswerBox
      question="Snabbt svar: Vilka reservdelar behöver Husqvarna Automower?"
      answer="Husqvarna Automower behöver framför allt nya knivar varje säsong, helst i april eller maj innan gräset tar fart. Knivarna sitter i det triangulära hållarsystem som standardmodellerna 105, 115H, 310, 315, 315X, 430X och 450X delar. Går begränsningskabeln av lagar du den med kabelklämmor i stället för att byta hela kabeln."
    />

    <p class="text-sm text-text-light mb-6">Den här sidan är avgränsad till Husqvarna Automower. Har du en Gardena Sileno, Worx Landroid eller Segway Navimow hittar du samma delar i vår översikt över <a href="/reservdelar/robotgrasklippare/" class="text-accent underline">reservdelar robotgräsklippare</a>.</p>

    <h2 class="font-heading text-xl font-bold text-text mb-4">Ersättningsknivar</h2>
    <div class="space-y-4 mb-10">
      {knivar.map((p, i) => (
        <article class="bg-white rounded-xl border border-border shadow-sm transition-shadow p-5">
          <div class="flex flex-col sm:flex-row gap-4">
            <div class="flex-shrink-0 flex flex-col items-center gap-2">
              {i === 0 && <span class="text-xs font-bold uppercase px-3 py-1 rounded-full bg-winner/10 text-winner">{p.badge}</span>}
              {i > 0 && p.badge && <span class="text-xs font-bold uppercase px-3 py-1 rounded-full bg-bg-alt text-text-light">{p.badge}</span>}
              {p.img && (
                <div class="w-32 h-32 bg-gray-50 rounded-xl p-2 flex items-center justify-center border border-border">
                  <img src={p.img} alt={p.name} class="w-full h-full object-contain" loading="lazy" width="200" height="200" />
                </div>
              )}
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="font-heading font-bold text-text text-base mb-1">{p.name}</h3>
              <p class="text-xs text-accent font-medium mb-1">{p.compat}</p>
              <p class="text-xs text-text-light mb-1"><strong class="text-text">Innehåller:</strong> {p.includes}</p>
              <p class="text-xs text-text-light mb-4">{p.detail}</p>
              <div class="flex flex-wrap items-center gap-3">
                {p.url && (
                  <a
                    href={p.url}
                    rel="sponsored nofollow noopener noreferrer"
                    target="_blank"
                    class="inline-flex items-center justify-center min-h-[44px] bg-cta hover:bg-cta/90 text-white font-semibold px-6 py-3 rounded-lg transition-colors text-sm"
                  >
                    Bra pris hos {p.store}
                  </a>
                )}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <h2 class="font-heading text-xl font-bold text-text mb-4">Begränsningskabel och klämmor</h2>
    <div class="space-y-4 mb-10">
      {kabel.map((p) => (
        <article class="bg-white rounded-xl border border-border shadow-sm transition-shadow p-5">
          <div class="flex flex-col sm:flex-row gap-4">
            <div class="flex-shrink-0 flex flex-col items-center gap-2">
              {p.badge && <span class="text-xs font-bold uppercase px-3 py-1 rounded-full bg-bg-alt text-text-light">{p.badge}</span>}
              {p.img && (
                <div class="w-32 h-32 bg-gray-50 rounded-xl p-2 flex items-center justify-center border border-border">
                  <img src={p.img} alt={p.name} class="w-full h-full object-contain" loading="lazy" width="200" height="200" />
                </div>
              )}
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="font-heading font-bold text-text text-base mb-1">{p.name}</h3>
              <p class="text-xs text-accent font-medium mb-1">{p.compat}</p>
              <p class="text-xs text-text-light mb-1"><strong class="text-text">Innehåller:</strong> {p.includes}</p>
              <p class="text-xs text-text-light mb-4">{p.detail}</p>
              <div class="flex flex-wrap items-center gap-3">
                
                
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <section class="mb-10">
      <h2 class="font-heading text-xl font-bold text-text mb-4">Guide: underhåll av din Automower</h2>
      <div class="space-y-6 text-sm text-text-light leading-relaxed">
        <div>
          <h3 class="font-heading text-lg font-bold text-text mb-2">Hur byter du knivar på en Automower?</h3>
          <p class="mb-3">Stäng av klipparen med huvudströmbrytaren, vänd den upp och ner och skruva loss de gamla bladen. Nya skruvar följer med i bladpaketen, återanvänd aldrig gamla skruvar. Byt alltid alla blad samtidigt så att klippskivan förblir balanserad, obalans ger vibrationer och ett ojämnt klippresultat.</p>
          <p>Byt varje säsong, i april eller maj, och kontrollera bladen var 4 till 6 vecka om tomten är hård eller stenig. Bladpack som även passar Gardena, Worx och Segway Navimow hittar du bland våra <a href="/reservdelar/knivar/" class="text-accent underline">knivar till robotgräsklippare</a>.</p>
        </div>
        <div>
          <h3 class="font-heading text-lg font-bold text-text mb-2">Räcker 100 meter begränsningskabel till din tomt?</h3>
          <p class="mb-3">En rulle på 100 meter räcker till tomter upp till ungefär 800 kvadratmeter, medan 150 meter täcker upp till cirka 1 500 kvadratmeter. Mät runt tomtens hela perimeter och lägg till kabel för interna zongränser, öar runt rabatter och laddningsstationens spiralkabel innan du väljer längd.</p>
          <p>Går kabeln av behöver du sällan byta hela slingan. Kabelklämmor skarvar ihop brottet på fem minuter utan verktyg, hela kabeln byts bara om den är skadad på många ställen. Funderar du i stället på en ny klippare hittar du alla aktuella modeller i vår jämförelse av <a href="/husqvarna-robotgrasklippare/" class="text-accent underline">Husqvarna robotgräsklippare</a>.</p>
        </div>
      </div>
    </section>

    <section class="mb-8">
      <h2 class="font-heading text-xl font-bold text-text mb-4">Fler reservdelar</h2>
      <div class="grid sm:grid-cols-2 gap-3">
        <a href="/reservdelar/knivar/" class="bg-white border border-border rounded-lg px-4 py-3 hover:border-accent transition-all text-sm font-semibold text-text hover:text-accent">Alla knivar och kabel</a>
        <a href="/reservdelar/robotgrasklippare/" class="bg-white border border-border rounded-lg px-4 py-3 hover:border-accent transition-all text-sm font-semibold text-text hover:text-accent">Robotgräsklippare reservdelar</a>
        <a href="/husqvarna-robotgrasklippare/" class="bg-white border border-border rounded-lg px-4 py-3 hover:border-accent transition-all text-sm font-semibold text-text hover:text-accent">Husqvarna Automower, test och jämförelse</a>
        <a href="/reservdelar/" class="bg-white border border-border rounded-lg px-4 py-3 hover:border-accent transition-all text-sm font-semibold text-text hover:text-accent">Alla reservdelar</a>
      </div>
    </section>

    <FAQ items={faqItems} />

  </main>
</BaseLayout>
