---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import FAQ from '../../components/FAQ.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AnswerBox from '../../components/AnswerBox.astro';


// Produkterna kommer fran Adtractions produktfeed via reservdelskatalogen.
// Kompatibiliteten under "Passar" ar hamtad ordagrant ur butikens artikelnamn.
// Dar butiken inte anger nagon modell star det uttryckligen sa i stallet for
// en gissad modellista.
const products = [
  {
    img: '/images/parts/roborock-ultra-plus-dammpase-6-pack.webp',
    name: 'Roborock Ultra / Plus dammpåse, 6 st',
    compat: 'Ultra- och Plus-stationer enligt butikens artikelnamn, stäm av mot din station innan köp',
    includes: '6 dammpåsar till tömningsstationen',
    badge: 'Dammpåse',
    store: 'Teknikproffset',
    buyUrl: 'https://dot.teknikproffset.se/t/t?a=1954032647&as=2063681412&t=2&tk=1&cupa_sku=C58862&url=https://www.teknikproffset.se/hem-hushall-tradgard/stadprodukter/dammsugare-tillbehor/tillbehor-45/dammsugarpasar/roborock-ultra-plus-dammpase-6-st',
    series: 'S8-serien',
  },
  {
    img: '/images/parts/roborock-hepa-filter-2-pack.webp',
    name: 'Roborock HEPA-filter 2-pack',
    compat: 'Modell framgår inte av butikens artikelnamn, stäm av mot din robot innan köp',
    includes: '2 HEPA-filter',
    badge: 'Filter',
    store: 'Kjell',
    buyUrl: 'https://ion.kjell.com/t/t?a=1487384319&as=2063681412&t=2&tk=1&cupa_sku=66038&url=http://www.kjell.com/se/produkter/hem-fritid/stadning-rengoring/robotdammsugare/tillbehor-till-robotdammsugare/roborock-hepa-filter-2-pack-p66038',
    series: 'S8-serien',
  },
  {
    img: '/images/parts/roborock-duo-huvudborste.webp',
    name: 'Roborock Duo-huvudborste 1-pack',
    compat: 'Modell framgår inte av butikens artikelnamn, stäm av mot din robot innan köp',
    includes: '1 duo-huvudborste',
    badge: 'Huvudborste',
    store: 'Kjell',
    buyUrl: 'https://ion.kjell.com/t/t?a=1487384319&as=2063681412&t=2&tk=1&cupa_sku=66034&url=http://www.kjell.com/se/produkter/hem-fritid/stadning-rengoring/robotdammsugare/tillbehor-till-robotdammsugare/roborock-duo-huvudborste-1-pack-p66034',
    series: 'S8-serien',
  },
  {
    img: '/images/parts/roborock-sidoborste-2-pack.webp',
    name: 'Roborock Sidoborste 2-pack',
    compat: 'Modell framgår inte av butikens artikelnamn, stäm av mot din robot innan köp',
    includes: '2 sidoborstar',
    badge: 'Sidoborstar',
    store: 'Kjell',
    buyUrl: 'https://ion.kjell.com/t/t?a=1487384319&as=2063681412&t=2&tk=1&cupa_sku=66035&url=http://www.kjell.com/se/produkter/hem-fritid/stadning-rengoring/robotdammsugare/tillbehor-till-robotdammsugare/roborock-sidoborste-2-pack-p66035',
    series: 'S8-serien',
  },
  {
    img: '/images/parts/roborock-qrevo-tillbehorskit.webp',
    name: 'Roborock tillbehörskit till QRevo',
    compat: 'Passar: QRevo',
    includes: null,
    badge: 'Tillbehörskit',
    store: 'Kjell',
    buyUrl: 'https://ion.kjell.com/t/t?a=1487384319&as=2063681412&t=2&tk=1&cupa_sku=66041&url=http://www.kjell.com/se/produkter/hem-fritid/stadning-rengoring/robotdammsugare/tillbehor-till-robotdammsugare/roborock-tillbehorskit-till-roborock-qrevo-p66041',
    series: 'Qrevo-serien',
  },
  {
    img: '/images/parts/roborock-q-revo-reservdelspaket.webp',
    name: 'Roborock Q Revo reservdelspaket, vit',
    compat: 'Passar: Q Revo',
    includes: null,
    badge: 'Reservdelspaket',
    store: 'Teknikproffset',
    buyUrl: 'https://dot.teknikproffset.se/t/t?a=1954032647&as=2063681412&t=2&tk=1&cupa_sku=C58874&url=https://www.teknikproffset.se/hem-hushall-tradgard/stadprodukter/dammsugare-tillbehor/tillbehor-45/reservdelar-till-robotdammsugare/roborock-q-revo-reservdelspaket-vit',
    series: 'Qrevo-serien',
  },
  {
    img: '/images/parts/roborock-q-revo-dammpase-6-pack.webp',
    name: 'Roborock Q Revo dammpåse, 6 st',
    compat: 'Passar: Q Revo',
    includes: '6 dammpåsar',
    badge: 'Dammpåsar',
    store: 'Teknikproffset',
    buyUrl: 'https://dot.teknikproffset.se/t/t?a=1954032647&as=2063681412&t=2&tk=1&cupa_sku=C36558&url=https://www.teknikproffset.se/hem-hushall-tradgard/stadprodukter/dammsugare-tillbehor/tillbehor-45/dammsugarpasar/roborock-q-revo-dammpase-6-st',
    series: 'Qrevo-serien',
  },
  {
    img: '/images/parts/roborock-qrevo-curv-sidoborste.webp',
    name: 'Roborock sidoborste, grå, 103 mm',
    compat: 'Passar: Qrevo Curv, Qrevo Edge, Qrevo CurvX, Qrevo Curv S5X, Saros Z70, Saros 10R, Saros 10',
    includes: 'Sidoborste, 103 mm',
    badge: 'Sidoborste',
    store: 'CS Megastore',
    buyUrl: 'https://go.csmegastore.se/t/t?a=1514097163&as=2063681412&t=2&tk=1&cupa_sku=24978047&url=https://www.csmegastore.se/i/24978047/roborock-6970995780116-sidoborste-robotdammsugare-gr%c3%a5-roborock-qrevo-curv-qrevo-edge-saros-z70-saros-10r-saros-10-qrevo-curvx',
    series: 'Qrevo-serien',
  },
];

const faqItems = [
  {
    question: 'Vilket reservdelskit passar min Roborock-modell?',
    answer: 'S8, S8+, S8 Pro Ultra, S8 Max Ultra och S8 MaxV Ultra delar alla samma reservdelssystem. Qrevo-serien (Qrevo S, Qrevo Pro, Qrevo MaxV) har ett eget separat system. Kontrollera alltid att kittet du köper anger din exakta modell.',
  },
  {
    question: 'Hur ofta ska jag byta reservdelar på min Roborock?',
    answer: 'HEPA-filter: var 2 månad. Sidoborstar: var 6 till 12 månad. Huvudborste (gummiborstar): var 12 till 18 månad. Moppkuddar: tvätta varje vecka, byt när de är slitna. Dammpåsar: när fyllda eller var 4 till 6 vecka.',
  },
  {
    question: 'Fungerar tredjepartskits i Roborock utan att ogiltigförklara garantin?',
    answer: 'I Sverige gäller att använda tredjepartsförbrukningsartiklar (filter, borstar) normalt inte ogiltigförklarar garantin på roboten. Kontakta Roborock kundtjänst om du är osäker.',
  },
    {
    question: 'Hur ser jag att HEPA-filtret behöver bytas?',
    answer: 'När det inte går att knacka rent längre. Ett filter som är mattat och missfärgat i vecken stryper luftflödet genom roboten, och sugkraften sjunker långt innan bytesintervallet på två månader är slut. Knacka ur filtret varje vecka, då håller det sitt intervall. Blås aldrig rent det med tryckluft, fibrerna tar skada och filtreringen blir sämre.',
  },
  {
    question: 'Behöver min Roborock dammpåsar?',
    answer: 'Bara om den har en station med automatisk tömning. Modeller utan station samlar smutsen i robotens egen behållare som du tömmer för hand, och då blir påsar i kittet liggande oanvända. Påsarna är dessutom knutna till exakt stationstyp, så kontrollera modellraden innan du köper ett kit där påsar ingår. Räkna med byte var fjärde till sjätte vecka.',
  },
  {
    question: 'Lönar det sig att köpa ett helt kit eller enstaka delar?',
    answer: 'Kit lönar sig när flera delar närmar sig sitt intervall samtidigt, vilket de ofta gör efter ett år. Är det bara en enskild del som gett upp köper du hellre den delen separat. Ett komplett kit täcker HEPA-filter, huvudborste, sidoborstar och moppdukar, ibland dammpåsar, och flera kit har en liten skruvmejsel med eftersom sidoborstarna sitter fast med skruv.',
  },
  {
    question: 'Hur får jag bort hår som lindat sig runt huvudborsten?',
    answer: 'Lyft ur borsten ur hållaren och klipp av hårstråna längs valsen med en sax, sedan dras de loss i en sträng. Kontrollera ändarna på valsen samtidigt, det är där hår gärna packar ihop sig och börjar bromsa rotationen. Gör det ungefär varannan vecka, då håller gummiborsten sina 12 till 18 månader utan att prestandan sjunker däremellan.',
  },
  {
    question: 'När ska moppdukarna bytas i stället för tvättas?',
    answer: 'Tvätta dem varje vecka och byt när fibrerna blivit hårda och stripiga. En duk som mattats ihop tar upp mindre vatten och skjuter smutsen framför sig i stället för att lyfta den, vilket syns som ränder på klinker och parkett. Hur ofta det inträffar beror på hur mycket du moppar, inte på kalendern, så känn på dukarna i stället för att räkna veckor.',
  },
];

const breadcrumbs = [
  { label: 'Reservdelar', href: '/reservdelar/' },
  { label: 'Roborock' },
];

const faqSchema = faqItems.map((item) => ({
  "@type": "Question",
  "name": item.question,
  "acceptedAnswer": {
    "@type": "Answer",
    "text": item.answer,
  },
}));
export const articleMeta = {
  title: "Roborock reservdelar 2026: välj rätt serie till din robot",
  description: "Reservdelar till Roborock robotdammsugare. Här ser du vilket delsystem din robot tillhör och går vidare till rätt serie för filter, borstar och moppar.",
  publishDate: "2026-03-29",
  category: "Reservdelar",
  image: "/images/parts-roborock-filter.webp",
};

---

<BaseLayout
  title="Roborock reservdelar 2026: välj rätt serie till din robot"
  description="Reservdelar till Roborock robotdammsugare. Här ser du vilket delsystem din robot tillhör och går vidare till rätt serie för filter, borstar och moppar."
  article={{ datePublished: "2026-03-29", dateModified: "2026-07-28", image: "/images/parts-roborock-filter.webp" }}
>
  <section class="bg-primary text-white py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} light={true} />
    <AuthorByline datePublished="2026-03-29" dateModified="2026-07-28" />
      <h1 class="font-heading text-3xl sm:text-4xl font-bold mb-3">Roborock reservdelar, välj rätt serie till din robot</h1>
      <p class="text-gray-200 max-w-2xl">Roborock delar sitt sortiment i två reservdelssystem som inte går att blanda, så första steget är att veta vilken serie din robot tillhör. Modellnamnet står på etiketten under roboten och i Roborock-appen, och härifrån skickas du vidare till sidan för just din serie.</p>
    </div>
  </section>

  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <AnswerBox
      question="Snabbt svar: Vilka reservdelar passar min Roborock?"
      answer="Roborock har två separata reservdelssystem: hela S8-serien (S8, S8+, S8 Pro Ultra, S8 Max Ultra, S8 MaxV Ultra) delar ett, och Qrevo-serien (Qrevo S, Qrevo Pro, Qrevo MaxV) ett annat. Filter och borstar kan inte blandas mellan serierna. Kontrollera alltid att kittet anger din exakta modell innan du beställer."
    />
    <p class="text-base text-text-light leading-relaxed mb-4">
      Läs modellnamnet på etiketten under roboten och gå sedan direkt till din serie. Tillhör roboten S8-familjen ligger delarna med kompatibilitet per modell samlade under <a href="/reservdelar/roborock-s8-serien/" class="text-accent underline">Roborock S8 reservdelar</a>, som täcker S8, S8+, S8 Pro Ultra, S8 Max Ultra och S8 MaxV Ultra. Är det en Qrevo hittar du delarna, inklusive Qrevo Masters modellspecifika dammpåsar och borsten till den utfällbara sidoarmen, under <a href="/reservdelar/roborock-qrevo-serien/" class="text-accent underline">Roborock Qrevo reservdelar</a>.
    </p>
<p class="text-sm text-text-light mb-6">Senast uppdaterad: juli 2026, {products.length} reservdelar</p>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8">
      {['S8-serien', 'Qrevo-serien'].map(series => (
        <a href={`#${series.toLowerCase().replace('-', '')}`} class="bg-white border border-border rounded-lg px-4 py-3 text-center hover:border-accent transition-all text-sm font-semibold text-text hover:text-accent">{series}</a>
      ))}
      <a href="/reservdelar/filter/" class="bg-white border border-border rounded-lg px-4 py-3 text-center hover:border-accent transition-all text-sm font-semibold text-text hover:text-accent">Bara filter</a>
      <a href="/reservdelar/borstar/" class="bg-white border border-border rounded-lg px-4 py-3 text-center hover:border-accent transition-all text-sm font-semibold text-text hover:text-accent">Bara borstar</a>
    </div>

    <h2 id="s8serien" class="font-heading text-xl font-bold text-text mb-2">S8-serien i urval</h2>
    <p class="text-sm text-text-light mb-4">Här visas ett urval av delarna. Full kompatibilitetslista för S8, S8+, S8 Pro Ultra, S8 Max Ultra och S8 MaxV Ultra, plus underhållsschema, finns på vår sida om <a href="/reservdelar/roborock-s8-serien/" class="text-accent underline">Roborock S8 reservdelar</a>.</p>
    <div class="space-y-4 mb-10">
      {products.filter(p => p.series === 'S8-serien').map((p, i) => (
        <article class="bg-white rounded-xl border border-border shadow-sm transition-shadow p-5">
          <div class="flex flex-col sm:flex-row gap-4">
            <div class="flex-shrink-0 flex flex-col items-center gap-2">
              {i === 0 && <span class="text-xs font-bold uppercase px-3 py-1 rounded-full bg-winner/10 text-winner">{p.badge}</span>}
              {i > 0 && p.badge && <span class="text-xs font-bold uppercase px-3 py-1 rounded-full bg-bg-alt text-text-light">{p.badge}</span>}
              {p.img && (
                <div class="w-32 h-32 bg-gray-50 rounded-xl p-2 flex items-center justify-center border border-border">
                  <img src={p.img} alt={p.name} class="w-full h-full object-contain" loading="lazy" width="200" height="200" />
                </div>
              )}
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="font-heading font-bold text-text text-base mb-1">{p.name}</h3>
              <p class="text-xs text-accent font-medium mb-2">{p.compat}</p>
              {p.includes && (
                <p class="text-xs text-text-light mb-4"><strong class="text-text">Innehåller:</strong> {p.includes}</p>
              )}
              <div class="flex flex-wrap items-center gap-3">
                <a
                  href={p.buyUrl}
                  rel="sponsored nofollow noopener noreferrer"
                  target="_blank"
                  class="inline-flex items-center justify-center bg-cta hover:bg-cta-dark text-white font-semibold px-5 py-2.5 rounded-lg transition-colors text-sm min-h-[44px]"
                >
                  Bra pris hos {p.store}
                </a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <h2 id="qrevoserien" class="font-heading text-xl font-bold text-text mb-2">Qrevo-serien i urval</h2>
    <p class="text-sm text-text-light mb-4">Samma sak här: hela kompatibilitetslistan per Qrevo-modell ligger på vår sida om <a href="/reservdelar/roborock-qrevo-serien/" class="text-accent underline">Roborock Qrevo reservdelar</a>.</p>
    <div class="space-y-4 mb-10">
      {products.filter(p => p.series === 'Qrevo-serien').map((p, i) => (
        <article class="bg-white rounded-xl border border-border shadow-sm transition-shadow p-5">
          <div class="flex flex-col sm:flex-row gap-4">
            <div class="flex-shrink-0 flex flex-col items-center gap-2">
              {i === 0 && <span class="text-xs font-bold uppercase px-3 py-1 rounded-full bg-bg-alt text-text-light">{p.badge || 'Populärt'}</span>}
              {i > 0 && p.badge && <span class="text-xs font-bold uppercase px-3 py-1 rounded-full bg-winner/10 text-winner">{p.badge}</span>}
              {p.img && (
                <div class="w-32 h-32 bg-gray-50 rounded-xl p-2 flex items-center justify-center border border-border">
                  <img src={p.img} alt={p.name} class="w-full h-full object-contain" loading="lazy" width="200" height="200" />
                </div>
              )}
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="font-heading font-bold text-text text-base mb-1">{p.name}</h3>
              <p class="text-xs text-accent font-medium mb-2">{p.compat}</p>
              {p.includes && (
                <p class="text-xs text-text-light mb-4"><strong class="text-text">Innehåller:</strong> {p.includes}</p>
              )}
              <div class="flex flex-wrap items-center gap-3">
                <a
                  href={p.buyUrl}
                  rel="sponsored nofollow noopener noreferrer"
                  target="_blank"
                  class="inline-flex items-center justify-center bg-cta hover:bg-cta-dark text-white font-semibold px-5 py-2.5 rounded-lg transition-colors text-sm min-h-[44px]"
                >
                  Bra pris hos {p.store}
                </a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <section class="mb-8">
      <h2 class="font-heading text-xl font-bold text-text mb-4">Fler reservdelar</h2>
      <div class="grid sm:grid-cols-2 gap-3">
        <a href="/reservdelar/dreame/" class="bg-white border border-border rounded-lg px-4 py-3 hover:border-accent transition-all text-sm font-semibold text-text hover:text-accent">Dreame reservdelar</a>
        <a href="/reservdelar/ecovacs/" class="bg-white border border-border rounded-lg px-4 py-3 hover:border-accent transition-all text-sm font-semibold text-text hover:text-accent">Ecovacs reservdelar</a>
        <a href="/reservdelar/filter/" class="bg-white border border-border rounded-lg px-4 py-3 hover:border-accent transition-all text-sm font-semibold text-text hover:text-accent">Filter till robotdammsugare</a>
        <a href="/reservdelar/borstar/" class="bg-white border border-border rounded-lg px-4 py-3 hover:border-accent transition-all text-sm font-semibold text-text hover:text-accent">Borstar till robotdammsugare</a>
      </div>
    </section>

    <section class="mb-10">
      <h3 class="font-heading text-lg font-bold text-text mb-2">Kan jag använda S8-filter i en Qrevo eller tvärtom?</h3>
      <p class="text-sm text-text-light leading-relaxed mb-3">
        Nej. S8-serien och Qrevo-serien har olika reservdelssystem med olika form och fäste på både filter och borstar. Ett S8-filter passar inte i en Qrevo, även om båda är HEPA-klassade. Köp alltid kit som uttryckligen anger din serie och din modell i kompatibilitetslistan.
      </p>
      <p class="text-sm text-text-light leading-relaxed mb-6">
        Modellnamnet står i Roborock-appen och på etiketten på robotens undersida. Är du osäker på vilken serie din robot tillhör, eller vill jämföra modellerna innan nästa köp, hjälper vår <a href="/roborock-guide/" class="text-accent underline">guide till alla Roborock-modeller</a> dig att reda ut skillnaderna.
      </p>

      <h3 class="font-heading text-lg font-bold text-text mb-2">Hur får jag Roborock-delarna att hålla längre?</h3>
      <p class="text-sm text-text-light leading-relaxed mb-3">
        Knacka rent HEPA-filtret varje vecka, klipp bort hår som lindats runt huvudborsten och tvätta moppdukarna regelbundet. Med den rutinen håller filtren sina 2 månader, sidoborstarna 6 till 12 månader och huvudborsten 12 till 18 månader utan att prestandan sjunker däremellan.
      </p>
      <p class="text-sm text-text-light leading-relaxed mb-6">
        Ett igensatt filter stryper luftflödet genom roboten och sänker sugkraften långt innan bytesintervallet är slut, så den veckovisa rengöringen gör större skillnad än många tror. Behöver du bara fylla på förbrukningsdelar finns samlade alternativ på vår sida om <a href="/reservdelar/filter/" class="text-accent underline">filter till robotdammsugare</a>.
      </p>

      <h3 class="font-heading text-lg font-bold text-text mb-2">Vad ingår i ett komplett Roborock-kit?</h3>
      <p class="text-sm text-text-light leading-relaxed mb-3">
        Ett komplett kit täcker de delar som slits: HEPA-filter, huvudborste, sidoborstar och moppdukar, och i vissa fall dammpåsar till stationen. Flera kit har en liten skruvmejsel med, eftersom sidoborstarna sitter fast med skruv. Har du en modell utan station behöver du inga påsar alls.
      </p>
      <p class="text-sm text-text-light leading-relaxed mb-3">
        Dammpåsarna är det som skiljer kiten mest. Bara robotar med automatisk tömningsstation använder dem, och påsarna är knutna till exakt stationstyp. Köper du ett kit med påsar till en robot utan station betalar du för delar som blir liggande i lådan.
      </p>
      <p class="text-sm text-text-light leading-relaxed mb-6">
        Är det bara en enskild del som gett upp lönar det sig sällan att köpa ett helt kit. Enstaka huvudborstar och sidoborstar hittar du samlade på vår sida om <a href="/reservdelar/borstar/" class="text-accent underline">borstar till robotdammsugare</a>.
      </p>

      <h3 class="font-heading text-lg font-bold text-text mb-2">Hur vet jag vilken Roborock-modell jag har?</h3>
      <p class="text-sm text-text-light leading-relaxed mb-3">
        Modellnamnet står på etiketten på robotens undersida och i Roborock-appen under enhetsinformationen. Skriv av det exakt, inklusive tillägg som Plus, Pro, Max eller MaxV. Just de tilläggen avgör vilket reservdelssystem roboten hör till, och därmed vilka filter, borstar och dammpåsar som passar.
      </p>
      <p class="text-sm text-text-light leading-relaxed mb-3">
        Namn som ser nästan identiska ut hör inte alltid ihop. En S8 och en S8 MaxV Ultra delar delar, medan en S8 och en Qrevo Pro inte gör det trots att båda är Roborock. Det är därför kompatibilitetslistan alltid ska läsas rad för rad, inte skummas.
      </p>
      <p class="text-sm text-text-light leading-relaxed">
