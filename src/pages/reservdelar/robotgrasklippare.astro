    includes: '20 anslutningsklämmor, passar kabel 2,7 till 3,4 mm',
    badge: null,
    type: 'Kabel',
  },
];

const faqItems = [
  {
    question: 'Hur ofta ska jag byta knivar på robotgräsklipparen?',
    answer: 'Byt knivar varje säsong, helst på våren innan du startar klippningen. Med stenig eller hård mark slits knivarna fortare och kan behöva bytas mitt i säsongen.',
  },
  {
    question: 'Fungerar universalblad i alla robotgräsklippare?',
    answer: 'Universalblad fungerar i de flesta modeller från Husqvarna, Gardena, Worx och McCulloch som använder ett standardhållarsystem. Kontrollera alltid kompatibilitetslistan i produktbeskrivningen.',
  },
  {
    question: 'Min begränsningskabel är trasig, behöver jag byta hela kabeln?',
    answer: 'Nej. Använd kabelklämmor för att skarva ihop kabeln vid brottstället. Det tar 5 minuter och går åt en klämma per skarv.',
  },
  {
    question: 'Hur vet jag vilka blad som passar min robotgräsklippare?',
    answer: 'Utgå från kompatibilitetslistan för varje bladpaket, inte från märket i stort. Bladen här anges för Husqvarna Automower, Gardena Sileno, Worx Landroid, Greenworks Optimow, Segway Navimow samt Mammotion Luba och Yuka, och de titanbelagda bladen anges för Husqvarna Automower, Gardena och Greenworks Optimow. Står inte din modell med, jämför bladets form och skruvhålets placering mot originalbladet innan du beställer.',
  },
  {
    question: 'Måste jag byta alla knivar samtidigt?',
    answer: 'Ja, byt alltid hela uppsättningen. Blandar du nya och slitna blad går klippskivan i obalans och börjar vibrera, och vibrationerna flyttar över slitaget på lagren i klippmotorn. Det är också därför bladen säljs i flerpack, ett byte förbrukar alla blad på skivan. På stenig eller hård mark slits bladen fortare och kan behöva bytas redan mitt i säsongen.',
  },
  {
    question: 'Kan jag återanvända de gamla skruvarna?',
    answer: 'Nej, använd de skruvar som följer med bladpaketet. Det är skälet till att skruvar ingår i kitten. En gammal skruv som lossnar under drift släpper bladet inne i klippkåpan, och då riskerar du skador på mer än just det bladet. Kontrollera efter bytet att samtliga blad sitter fast och är hela, ett blad som sitter snett ger obalans direkt.',
  },
  {
    question: 'Hur mycket begränsningskabel behöver jag?',
    answer: 'Mät hela gräsytans omkrets och lägg till sträckan runt rabatter, träd och andra öar plus vägen fram till laddstationen. Som riktmärke räcker 150 meter till ungefär 1 000 kvadratmeter i en normalformad trädgård, medan en tomt med många hinder drar betydligt mer. Köp hellre till lite för mycket, kabel som tar slut mitt i installationen stoppar hela jobbet.',
  },
  {
    question: 'Passar kabelklämmorna min begränsningskabel?',
    answer: 'Klämmorna här tar kabel mellan 2,7 och 3,4 mm, vilket täcker de grovlekar Husqvarna, Gardena och övriga kabeldrivna klippare använder. Båda kabelrullarna i listan ligger på 2,7 mm. Är du osäker, mät kabeln innan du beställer. En klämma som är för stor ger dålig kontakt, och då kommer avbrottet tillbaka några veckor senare.',
  },
];

const breadcrumbs = [
  { label: 'Reservdelar', href: '/reservdelar/' },
  { label: 'Robotgräsklippare' },
];

const faqSchema = faqItems.map((item) => ({
  "@type": "Question",
  "name": item.question,
  "acceptedAnswer": {
    "@type": "Answer",
    "text": item.answer,
  },
}));
export const articleMeta = {
  title: "Reservdelar robotgräsklippare 2026: knivar och mer",
  description: "Komplett guide till reservdelar för robotgräsklippare 2026. Knivar, skruvar, laddningsplattor och slingtillbehör. Se kompatibilitet och pris Sverige.",
  publishDate: "2026-03-29",
  category: "Reservdelar",
  image: "/images/parts-husqvarna-blade.webp",
};

---

<BaseLayout
  title="Reservdelar robotgräsklippare 2026: knivar och mer"
  description="Komplett guide till reservdelar för robotgräsklippare 2026. Knivar, skruvar, laddningsplattor och slingtillbehör. Se kompatibilitet och pris Sverige."
  article={{ datePublished: "2026-03-29", dateModified: "2026-07-27", image: "/images/parts-husqvarna-blade.webp" }}
>
  <section class="bg-primary text-white py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} light={true} />
    <AuthorByline datePublished="2026-03-29" dateModified="2026-07-27" />
      <h1 class="font-heading text-3xl sm:text-4xl font-bold mb-3">Robotgräsklippare reservdelar</h1>
      <p class="text-gray-200 max-w-2xl">Ersättningsknivar, begränsningskabel och kabelklämmor till Husqvarna Automower, Gardena Sileno, Worx Landroid och Segway Navimow.</p>
    </div>
  </section>

  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <AnswerBox
      question="Snabbt svar: Vilka reservdelar behöver en robotgräsklippare?"
      answer="Knivarna är den viktigaste förbrukningsdelen och byts varje säsong, helst på våren innan klippstarten. Universalblad passar de flesta modeller från Husqvarna, Gardena, Worx och McCulloch. En trasig begränsningskabel behöver inte bytas i sin helhet, den skarvas med kabelklämmor på ungefär 5 minuter, direkt vid brottstället."
    />
<p class="text-sm text-text-light mb-2">Senast uppdaterad: juli 2026, {products.length} produkter</p>

    <div class="bg-accent/5 border border-accent/20 rounded-xl px-5 py-4 mb-8 text-sm text-text">
      <strong>Säsongsstart-tips:</strong> Byt knivar och kontrollera begränsningskabeln varje vår innan du startar robotgräsklipparen. Det tar 15 minuter och förebygger driftstopp under säsongen.
    </div>

    <h2 class="font-heading text-xl font-bold text-text mb-4">Knivar och blad</h2>
    <div class="space-y-4 mb-10">
      {products.filter(p => p.type === 'Knivar').map((p, i) => (
        <article class="bg-white rounded-xl border border-border shadow-sm transition-shadow p-5">
          <div class="flex flex-col sm:flex-row gap-4">
            <div class="flex-shrink-0 flex flex-col items-center gap-2">
              {i === 0 && <span class="text-xs font-bold uppercase px-3 py-1 rounded-full bg-winner/10 text-winner">{p.badge}</span>}
              {i > 0 && p.badge && <span class="text-xs font-bold uppercase px-3 py-1 rounded-full bg-bg-alt text-text-light">{p.badge}</span>}
              {p.img && (
                <div class="w-32 h-32 bg-gray-50 rounded-xl p-2 flex items-center justify-center border border-border">
                  <img src={p.img} alt={p.name} class="w-full h-full object-contain" loading="lazy" width="200" height="200" />
                </div>
              )}
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="font-heading font-bold text-text text-base mb-1">{p.name}</h3>
              <p class="text-xs text-accent font-medium mb-2">{p.compat}</p>
              {p.includes && <p class="text-xs text-text-light mb-4"><strong class="text-text">Innehåller:</strong> {p.includes}</p>}
              <div class="flex flex-wrap items-center gap-3">
                <a
                  href={p.buyUrl}
                  rel="sponsored nofollow noopener noreferrer"
                  target="_blank"
                  class="inline-flex items-center justify-center bg-cta hover:bg-cta-dark text-white font-semibold px-6 py-3 rounded-lg transition-colors text-sm min-h-[44px]"
                >
                  Bra pris hos {p.store}
                </a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <h2 class="font-heading text-xl font-bold text-text mb-4">Begränsningskabel och klämmor</h2>
    <div class="space-y-4 mb-10">
      {products.filter(p => p.type === 'Kabel').map((p) => (
        <article class="bg-white rounded-xl border border-border shadow-sm transition-shadow p-5">
          <div class="flex flex-col sm:flex-row gap-4">
            <div class="flex-shrink-0 flex flex-col items-center gap-2">
              {p.badge && <span class="text-xs font-bold uppercase px-3 py-1 rounded-full bg-bg-alt text-text-light">{p.badge}</span>}
              <div class="w-32 h-32 bg-gray-50 rounded-xl p-2 flex items-center justify-center border border-border">
                <img src={p.img} alt={p.name} class="w-full h-full object-contain" loading="lazy" width="200" height="200" />
              </div>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="font-heading font-bold text-text text-base mb-1">{p.name}</h3>
              <p class="text-xs text-accent font-medium mb-2">{p.compat}</p>
              <p class="text-xs text-text-light mb-4"><strong class="text-text">Innehåller:</strong> {p.includes}</p>
              <div class="flex flex-wrap items-center gap-3">
                
                
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <section class="mb-8">
      <h2 class="font-heading text-xl font-bold text-text mb-4">Fler reservdelar</h2>
      <div class="grid sm:grid-cols-2 gap-3">
        <a href="/reservdelar/husqvarna/" class="bg-white border border-border rounded-lg px-4 py-3 hover:border-accent transition-all text-sm font-semibold text-text hover:text-accent">Husqvarna Automower reservdelar</a>
        <a href="/reservdelar/knivar/" class="bg-white border border-border rounded-lg px-4 py-3 hover:border-accent transition-all text-sm font-semibold text-text hover:text-accent">Alla knivar och kabel</a>
        <a href="/reservdelar/robotdammsugare/" class="bg-white border border-border rounded-lg px-4 py-3 hover:border-accent transition-all text-sm font-semibold text-text hover:text-accent">Robotdammsugare reservdelar</a>
        <a href="/reservdelar/" class="bg-white border border-border rounded-lg px-4 py-3 hover:border-accent transition-all text-sm font-semibold text-text hover:text-accent">Alla reservdelar</a>
      </div>
    </section>

    <section class="mb-10">
      <h3 class="font-heading text-lg font-bold text-text mb-2">Hur märker jag att knivarna är slöa?</h3>
      <p class="text-sm text-text-light leading-relaxed mb-3">
        Slöa knivar sliter av grässtrået i stället för att klippa det, och snittet blir fransigt och gulnar i toppen efter ett par dagar. Klippbilden ser ojämn ut trots oförändrade inställningar, och motorn får jobba hårdare för samma resultat.
      </p>
      <p class="text-sm text-text-light leading-relaxed mb-3">
        Själva bytet tar några minuter. Vänd roboten, skruva loss de gamla bladen och sätt dit nya med de skruvar som ingår i kittet, återanvänd inte de gamla skruvarna. Byt alltid samtliga blad samtidigt, annars blir klippskivan obalanserad och börjar vibrera.
      </p>
      <p class="text-sm text-text-light leading-relaxed mb-6">
        På stenig eller hård mark slits knivarna fortare och kan behöva bytas mitt i säsongen. Klipper roboten en tomt med mycket lutning, rötter och kanter går det åt fler blad per säsong, se hur modellerna klarar den terrängen i vår guide till <a href="/robotgrasklippare-for-lutning/" class="text-accent underline">robotgräsklippare för lutning</a>.
      </p>

      <h3 class="font-heading text-lg font-bold text-text mb-2">Kan en trasig begränsningskabel skarvas i stället för att bytas?</h3>
      <p class="text-sm text-text-light leading-relaxed mb-3">
        Ja. Ett kabelbrott lagar du med en anslutningsklämma direkt vid skadan, och hela jobbet tar ungefär 5 minuter. Klämmorna passar kabel mellan 2,7 och 3,4 mm, alltså de grovlekar som Husqvarna, Gardena och övriga kabeldrivna klippare använder. En hel kabelrulle behövs bara vid skador på flera ställen.
      </p>
      <p class="text-sm text-text-light leading-relaxed mb-3">
        Svårast är att hitta brottstället. Roboten stannar och larmar om avbrott i slingan, men själva skadan kan sitta var som helst längs kabeln. Vanliga ställen är där du grävt, satt spaden i marken eller där kabeln ligger ytligt över en rot.
      </p>
      <p class="text-sm text-text-light leading-relaxed">
        Vill du slippa slingan helt finns modeller som håller sig inom tomten med satellitnavigering och gränser du ritar i appen. Dem har vi samlat i guiden till <a href="/robotgrasklippare-utan-slinga/" class="text-accent underline">robotgräsklippare utan slinga</a>.
      </p>
    </section>

    <FAQ items={faqItems} />

  </main>
</BaseLayout>
