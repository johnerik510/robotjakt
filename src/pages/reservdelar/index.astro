---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AnswerBox from '../../components/AnswerBox.astro';
import FAQ from '../../components/FAQ.astro';

const breadcrumbs = [{ label: 'Reservdelar & tillbehör' }];

const categories = [
  {
    title: 'Robotdammsugare reservdelar',
    description: 'Filter, borstar, moppkuddar och tillbehör till alla stora märken.',
    href: '/reservdelar/robotdammsugare/',
    icon: 'vacuum',
    items: ['HEPA-filter', 'Sidoborstar', 'Huvudborste', 'Moppkuddar', 'Dammposar'],
  },
  {
    title: 'Robotgräsklippare reservdelar',
    description: 'Knivar, laddningsstationer, begränsningskablar och mer.',
    href: '/reservdelar/robotgrasklippare/',
    icon: 'mower',
    items: ['Knivar', 'Begränsningskabel', 'Laddningsstation', 'Spiraler', 'Hjul'],
  },
];

const brands = [
  { name: 'Roborock', href: '/reservdelar/roborock/', desc: 'S8-, Q- och Qrevo-serien' },
  { name: 'Dreame', href: '/reservdelar/dreame/', desc: 'L10, L20, X30, X40-serien' },
  { name: 'Ecovacs', href: '/reservdelar/ecovacs/', desc: 'Deebot X5, T20, N8-serien' },
  { name: 'Husqvarna', href: '/reservdelar/husqvarna/', desc: 'Automower 105, 315X, 430X' },
];

const partTypes = [
  { name: 'Filter', href: '/reservdelar/filter/', desc: 'HEPA och washable filter' },
  { name: 'Borstar', href: '/reservdelar/borstar/', desc: 'Sido- och huvudborstar' },
  { name: 'Knivar', href: '/reservdelar/knivar/', desc: 'Till robotgräsklippare' },
];

// Produkter och tracker-URL:er hämtade ordagrant ur Adtractions produktfeed
// (reservdelskatalogen, verifierad 2026-07-28). Ingen URL är handskriven.
const popularParts = [
  {
    img: '/images/parts/roborock-s7-hepa-filter.webp',
    name: 'Roborock HEPA-filter till modell S7',
    compat: 'Passar: Roborock S7',
    includes: null,
    store: 'CS Megastore',
    buyUrl: 'https://go.csmegastore.se/t/t?a=1514097163&as=2063681412&t=2&tk=1&cupa_sku=7265073&url=https://www.csmegastore.se/i/7265073/roborock-hepa-filter-till-modell-s7',
  },
  {
    img: '/images/parts/roborock-q-revo-dammpase-6-pack.webp',
    name: 'Roborock dammpåse Q Revo, 6-pack',
    compat: 'Passar: Roborock Q Revo',
    includes: '6 dammpåsar',
    store: 'Teknikproffset',
    buyUrl: 'https://dot.teknikproffset.se/t/t?a=1954032647&as=2063681412&t=2&tk=1&cupa_sku=C36558&url=https://www.teknikproffset.se/hem-hushall-tradgard/stadprodukter/dammsugare-tillbehor/tillbehor-45/dammsugarpasar/roborock-q-revo-dammpase-6-st',
  },
  {
    img: '/images/parts/dreame-l10-l10s-ultra-tillbehorskit.webp',
    name: 'Dreame Tillbehörskit till Dreame L10/L10s Ultra',
    compat: 'Passar: Dreame L10/L10s Ultra',
    includes: null,
    store: 'Kjell',
    buyUrl: 'https://ion.kjell.com/t/t?a=1487384319&as=2063681412&t=2&tk=1&cupa_sku=65755&url=http://www.kjell.com/se/produkter/hem-fritid/stadning-rengoring/robotdammsugare/tillbehor-till-robotdammsugare/dreame-tillbehorskit-till-dreame-l10l10s-ultra-p65755',
  },
  {
    img: '/images/parts/dreame-d10s-pro-tillbehorskit.webp',
    name: 'Dreame Tillbehörskit DRAC3174',
    compat: 'Passar: Dreame D10s Pro',
    includes: '9 delar',
    store: 'CS Megastore',
    buyUrl: 'https://go.csmegastore.se/t/t?a=1514097163&as=2063681412&t=2&tk=1&cupa_sku=9741143&url=https://www.csmegastore.se/i/9741143/dreame-drac3174-robotdammsugare-tillbeh%c3%b6rskit-gr%c3%a5-vit-dreame-d10s-pro-9-styck',
  },
  {
    img: '/images/parts/grimsholm-dreame-robotgrasklippare-knivar.webp',
    name: 'Grimsholm Knivar till Dreame robotgräsklippare',
    compat: 'Passar: Dreame robotgräsklippare',
    includes: '12 knivar',
    store: 'Kjell',
    buyUrl: 'https://ion.kjell.com/t/t?a=1487384319&as=2063681412&t=2&tk=1&cupa_sku=49250&url=http://www.kjell.com/se/produkter/hem-fritid/tradgard/robotgrasklippare-tillbehor/knivar-till-robotgrasklippare/grimsholm-knivar-till-dreame-robotgrasklippare-12-pack-p49250',
  },
  {
    img: '/images/parts/grimsholm-ecovacs-goat-knivar.webp',
    name: 'Grimsholm Knivar till Ecovacs GOAT',
    compat: 'Passar: Ecovacs Goat',
    includes: '12 knivar',
    store: 'Kjell',
    buyUrl: 'https://ion.kjell.com/t/t?a=1487384319&as=2063681412&t=2&tk=1&cupa_sku=49252&url=http://www.kjell.com/se/produkter/hem-fritid/tradgard/robotgrasklippare-tillbehor/knivar-till-robotgrasklippare/grimsholm-knivar-till-ecovacs-goat-12-pack-p49252',
  },
];

const faqItems = [
  {
    question: 'Hur ofta ska du byta filter i en robotdammsugare?',
    answer: 'Var andra till var tredje månad vid normal användning. Ett igensatt filter minskar sugkraften med upp till 40 procent, och det märks som att roboten lämnar kvar damm trots tömd behållare. Filtret ser ofta rent ut på ytan även när det slutat släppa igenom luft ordentligt, så gå efter intervallet i stället för efter utseendet. Allergiker vinner mest på att hålla schemat.',
  },
  {
    question: 'Hur ofta ska knivarna på robotgräsklipparen bytas?',
    answer: 'Varje säsong. Trubbiga knivar drar och sliter i gräset i stället för att klippa rent, vilket ger gulnade grästoppar och ökar belastningen på motorn. Bytet tar några minuter med en skruvmejsel. Byt alla knivar samtidigt så att klippskivan sitter i balans, en obalanserad skiva vibrerar och sliter i onödan på lager och motor.',
  },
  {
    question: 'Hur ofta ska dammpåsen i basstationen bytas?',
    answer: 'Räkna med var fjärde till sjätte vecka vid daglig städning, men intervallet skiljer sig mellan modeller. Roborock S8 Pro Ultras station klarar ungefär sju veckor. Byt när påsen är fylld till 70 till 80 procent, appen säger oftast till när det är dags. Ett hem med husdjur och mattor fyller påsen snabbare än en lägenhet med bara hårda golv.',
  },
  {
    question: 'Hur vet du vilken reservdel som passar din robot?',
    answer: 'Utgå från den exakta modellbeteckningen, inte från märket. Två modeller från samma tillverkare kan använda olika filter och moppkuddar även när robotarna ser likadana ut. Kontrollera kompatibilitetslistan i produktbeskrivningen mot din beteckning innan du beställer. Det här är det vanligaste skälet till att fel del hamnar i brevlådan.',
  },
  {
    question: 'Var köper du reservdelar till robotdammsugare och robotgräsklippare?',
    answer: 'Vi länkar vidare till Kjell, CS Megastore, Teknikproffset, Proshop och Elon. CS Megastore och Kjell har bredast utbud av reservdelar till de vanligaste märkena, medan Teknikproffset är starkast på dammpåsar och moppdukar. Sök på din exakta modellbeteckning i stället för på märkesnamnet, då slipper du sortera bland delar som ser rätt ut men inte passar.',
  },
  {
    question: 'Hur ofta ska moppkuddarna bytas?',
    answer: 'Efter slitage, inte efter kalender. Tvätta kuddarna ungefär en gång i veckan och byt dem när fibrerna packats platta eller kudden slutat suga upp vatten som förut. Det går fortare i hem som moppas dagligen. Slitna moppkuddar sprider smuts i stället för att torka upp den, och det syns som ränder på golvet trots att roboten kört som vanligt. Kuddarna kan tvättas mellan bytena, men mikrofibrerna plattas ut med tiden och då hjälper ingen tvätt.',
  },
  {
    question: 'Hur märker du att sidoborstarna är slitna?',
    answer: 'Damm som ligger kvar längs väggar och lister är det tydligaste tecknet. Sidoborstens uppgift är att sopa in smuts från kanterna mot sugöppningen, och när stråna böjt sig utåt eller kortats av når de inte längre hela vägen ut. Räkna med byte var sjätte till tolfte månad, kortare intervall i hem med husdjur eller långt hår.',
  },
  {
    question: 'Vilka knivar passar min robotgräsklippare?',
    answer: 'Universalblad med standardtjocklek 0,75 millimeter passar Husqvarna Automower, Gardena Sileno och Yardforce, alltså de modeller som använder det vanliga triangulära hållarsystemet. Har du stenig eller krävande mark håller titanblad skärpan längre än vanliga stålblad. Kontrollera ändå knivfäste och bladtjocklek mot din exakta modell, måtten skiljer sig mellan generationer även inom samma märke.',
  },
];
---

<BaseLayout
  title="Reservdelar till robotar, filter, borstar och knivar"
  description="Hitta rätt reservdelar och tillbehör till din robot. HEPA-filter, borstar och knivar till Roborock, Dreame, Ecovacs och Husqvarna Automower. Köp via Kjell."
  article={true}
>
  <section class="bg-primary text-white py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} light={true} />
      <h1 class="font-heading text-3xl sm:text-4xl font-bold mb-3">Reservdelar &amp; tillbehör till robotar</h1>
      <p class="text-gray-200 text-lg max-w-2xl">Filter, borstar, knivar och tillbehör till robotdammsugare och robotgräsklippare, hitta rätt del till din modell.</p>
    </div>
  </section>

  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <AnswerBox
      question="Snabbt svar: Var hittar du reservdelar till din robot?"
      answer="Reservdelar till robotdammsugare och robotgräsklippare hittar du hos Kjell, CS Megastore, Teknikproffset och Proshop, ofta som originaldelar eller kompatibla kit. Byt HEPA-filter var 2 till 3 månad, sidoborstar var 6 till 12 månad och knivar varje säsong. Välj delar efter märke, Roborock, Dreame, Ecovacs eller Husqvarna, eller efter typ som filter, borstar och knivar."
    />

    <!-- Kategorier -->
    <section class="mb-10">
      <h2 class="font-heading text-2xl font-bold text-text mb-5">Välj robottyp</h2>
      <div class="grid sm:grid-cols-2 gap-5">
        {categories.map(cat => (
          <a href={cat.href} class="block bg-white rounded-xl border border-border p-6 hover:border-accent transition-all group">
            <h3 class="font-heading text-lg font-bold text-text group-hover:text-accent mb-2">{cat.title}</h3>
            <p class="text-text-light text-sm mb-4">{cat.description}</p>
            <ul class="flex flex-wrap gap-2">
              {cat.items.map(item => (
                <li class="text-xs bg-bg-alt text-text-light px-2 py-1 rounded-full">{item}</li>
              ))}
            </ul>
          </a>
        ))}
      </div>
    </section>

    <!-- Per märke -->
    <section class="mb-10">
      <h2 class="font-heading text-2xl font-bold text-text mb-5">Reservdelar per märke</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {brands.map(brand => (
          <a href={brand.href} class="flex items-center justify-between bg-white rounded-xl border border-border px-5 py-4 hover:border-accent transition-all group">
            <div>
              <span class="font-heading font-bold text-text group-hover:text-accent">{brand.name}</span>
              <p class="text-xs text-text-light mt-0.5">{brand.desc}</p>
            </div>
            <svg class="w-5 h-5 text-text-lighter group-hover:text-accent transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        ))}
      </div>
    </section>

    <!-- Per typ -->
    <section class="mb-10">
      <h2 class="font-heading text-2xl font-bold text-text mb-5">Reservdelar per typ</h2>
      <div class="grid grid-cols-3 gap-4">
        {partTypes.map(pt => (
          <a href={pt.href} class="block bg-white rounded-xl border border-border px-4 py-5 text-center hover:border-accent transition-all group">
            <span class="font-heading font-bold text-text group-hover:text-accent block mb-1">{pt.name}</span>
            <p class="text-xs text-text-light">{pt.desc}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- Populära reservdelar -->
    <section class="mb-10">
      <h2 class="font-heading text-2xl font-bold text-text mb-5">Populära reservdelar just nu</h2>
      <div class="space-y-4">
        {popularParts.map(p => (
          <article class="bg-white rounded-xl border border-border shadow-sm transition-shadow p-5">
            <div class="flex flex-col sm:flex-row gap-4">
              <div class="flex-shrink-0 flex flex-col items-center gap-2">
                <div class="w-32 h-32 bg-gray-50 rounded-xl p-2 flex items-center justify-center border border-border">
                  <img src={p.img} alt={p.name} class="w-full h-full object-contain" loading="lazy" width="200" height="200" />
                </div>
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="font-heading font-bold text-text text-base mb-1">{p.name}</h3>
                <p class="text-xs text-accent font-medium mb-2">{p.compat}</p>
                {p.includes && <p class="text-xs text-text-light mb-4"><strong class="text-text">Innehåller:</strong> {p.includes}</p>}
                <div class="flex flex-wrap items-center gap-3">
                  <a
                    href={p.buyUrl}
                    rel="sponsored nofollow noopener noreferrer"
                    target="_blank"
                    class="inline-flex items-center justify-center bg-cta hover:bg-cta-dark text-white font-semibold px-6 py-3 rounded-lg transition-colors text-sm min-h-[44px]"
                  >
                    Bra pris hos {p.store}
                  </a>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Var köper man -->
    <section class="mb-8">
      <h2 class="font-heading text-2xl font-bold text-text mb-5">Var hittar du reservdelarna?</h2>
      <div class="grid sm:grid-cols-3 gap-4">
        <a href="https://ion.kjell.com/t/t?a=1487384319&as=2063681412&t=2&tk=1" rel="sponsored nofollow noopener noreferrer" target="_blank" class="flex flex-col items-center justify-center bg-white rounded-xl border border-border px-5 py-6 hover:border-accent transition-all group text-center">
          <span class="font-heading font-bold text-text group-hover:text-accent text-lg mb-1">Kjell &amp; Company</span>
          <p class="text-xs text-text-light">Brett utbud av tillbehör och reservdelar</p>
        </a>
        <a href="https://to.elon.se/t/t?a=1606750995&as=2063681412&t=2&tk=1" rel="sponsored nofollow noopener noreferrer" target="_blank" class="flex flex-col items-center justify-center bg-white rounded-xl border border-border px-5 py-6 hover:border-accent transition-all group text-center">
          <span class="font-heading font-bold text-text group-hover:text-accent text-lg mb-1">Elon</span>
          <p class="text-xs text-text-light">Stort urval, ofta originaldelar</p>
        </a>
        <a href="https://go.adt284.net/t/t?a=1870484630&as=2063681412&t=2&tk=1" rel="sponsored nofollow noopener noreferrer" target="_blank" class="flex flex-col items-center justify-center bg-white rounded-xl border border-border px-5 py-6 hover:border-accent transition-all group text-center">
          <span class="font-heading font-bold text-text group-hover:text-accent text-lg mb-1">Proshop</span>
          <p class="text-xs text-text-light">Stort urval originaldelar</p>
        </a>
      </div>
    </section>

    <!-- Why replace -->
    <section class="bg-bg-alt rounded-xl p-6 mb-8">
      <h2 class="font-heading text-xl font-bold text-text mb-3">Varför byta reservdelar regelbundet?</h2>
      <div class="grid sm:grid-cols-2 gap-4 text-sm text-text-light">
        <div>
          <p class="font-semibold text-text mb-1">Filter, byt var 2 till 3 månad</p>
          <p>Ett igensatt filter minskar sugkraften med upp till 40 %. HEPA-filter håller allergener borta, men bara om de byts regelbundet.</p>
        </div>
        <div>
          <p class="font-semibold text-text mb-1">Borstar, byt var 6 till 12 månad</p>
          <p>Slitna sidoborstar borstar inte längre längs kanter och väggar. Huvud­borsten samlar djurhår och behöver rengöras eller bytas.</p>
        </div>
        <div>
          <p class="font-semibold text-text mb-1">Knivar (robotgräsklippare), byt varje säsong</p>
          <p>Trubbiga knivar drar och sliter på gräset istället för att klippa rent. Resultatet är gulnat gräs och ökad belastning på motorn.</p>
        </div>
        <div>
          <p class="font-semibold text-text mb-1">Moppkuddar, tvätta veckovis och byt vid slitage</p>
          <p>Slitna moppkuddar sprider smuts istället för att torka upp den. Byt mot originalkuddar för bästa moppresultat.</p>
        </div>
      </div>
    </section>

    <!-- Köpguide -->
    <section class="mb-8">
      <h2 class="font-heading text-xl font-bold text-text mb-4">Köpguide: original, kompatibelt och rätt passform</h2>
      <div class="space-y-6 text-sm text-text-light leading-relaxed">
        <div>
          <h3 class="font-heading text-lg font-bold text-text mb-2">Ska du välja originaldelar eller kompatibla reservdelar?</h3>
          <p class="mb-3">Originaldelar garanterar passform och samma material som delarna roboten levererades med, medan kompatibla kit ofta ger fler delar för pengarna. För rena slitdelar som <a href="/reservdelar/filter/" class="text-accent underline">filter till robotdammsugare</a> och sidoborstar fungerar kompatibla alternativ bra, så länge tillverkaren tydligt anger vilka modeller kittet passar.</p>
          <p>Kontrollera alltid kompatibilitetslistan mot din exakta modellbeteckning innan du beställer. Två modeller från samma märke kan använda olika filter och moppkuddar, även när robotarna ser likadana ut. Står din modell inte med i produktbeskrivningen: välj ett annat kit.</p>
        </div>
        <div>
          <h3 class="font-heading text-lg font-bold text-text mb-2">Hur vet du att det är dags att byta en del?</h3>
          <p class="mb-3">Roboten berättar det ofta själv genom resultatet. Sämre sugkraft trots tömd behållare pekar på ett igensatt filter. Damm som ligger kvar längs väggar och lister betyder slitna sidoborstar. Ojämnt eller fransigt klippt gräs är det tydligaste tecknet på slöa knivar i robotgräsklipparen, och blad, begränsningskabel och kabelklämmor till klipparen ligger samlade under <a href="/reservdelar/robotgrasklippare/" class="text-accent underline">reservdelar robotgräsklippare</a>.</p>
          <p>Många appar räknar drifttimmar och påminner när en del närmar sig slutet av sin livslängd. Räknaren vet dock inget om hur dammigt eller krävande just ditt hem är, så lita mer på ögonen än på appen. Byt <a href="/reservdelar/knivar/" class="text-accent underline">knivar till robotgräsklipparen</a> varje säsong oavsett vad appen säger.</p>
        </div>
      </div>
    </section>

    <FAQ items={faqItems} />
  </main>
</BaseLayout>
