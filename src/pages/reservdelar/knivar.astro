const faqItems = [
  {
    question: 'Hur ofta ska jag byta knivar på robotgräsklipparen?',
    answer: 'Byt knivar varje säsong (på våren) eller när du märker att gräset ser ojämnt klippt ut. Med hård mark, stenar eller rotfibrer i gräset slits knivarna snabbare, kontrollera var 4 till 6 vecka.',
  },
  {
    question: 'Passar universalblad i min Husqvarna Automower?',
    answer: 'Ja, universalblad passar de Automower-modeller som använder det vanliga triangulära hållarsystemet, bland annat 105, 115H, 310, 315, 315X, 430X och 450X. Butikerna anger inte alltid en fullständig modellista, så stäm av produktbeskrivningen mot din modellbeteckning innan du beställer.',
  },
  {
    question: 'Behöver jag byta begränsningskabeln?',
    answer: 'Kabeln behöver sällan bytas i sin helhet men kan gå sönder vid grävarbeten, frost eller skadedjur. Använd kabelklämmor för att skärva ihop en bruten kabel, det är enkelt och billigt.',
  },
  {
    question: 'Vad är skillnaden mellan vanliga stålblad och titanblad?',
    answer: 'Titanblad är hårdare och håller skärpan längre, vilket är bra på tuffare mark med stenar eller kvistar. Vanliga stålblad räcker för normalt gräs och är billigare att byta ut. Välj titan om din tomt är krävande.',
  },
  {
    question: 'Hur ser jag att bladen behöver bytas?',
    answer: 'Titta på gräset, inte på bladen. Slöa blad river av strået i stället för att skära ett rent snitt, topparna fransar sig och gräsmattan får en matt, sliten ton trots att roboten går varje dag. Kontrollera bladen var fjärde till sjätte vecka om marken är hård eller stenig, och känn efter om eggen är trubbig eller om något blad har sprickor.',
  },
  {
    question: 'Kan jag byta bara det blad som ser slitet ut?',
    answer: 'Nej, byt alltid alla blad på klippskivan samtidigt. Blandar du gamla och nya blad blir skivan obalanserad, vilket ger vibrationer, högre ljud och ett ojämnt klippresultat. Ett 30- eller 45-pack räcker till många kompletta byten, så det finns ingen anledning att snåla med enstaka blad.',
  },
  {
    question: 'Måste skruvarna bytas när jag byter blad?',
    answer: 'Ja, använd nya skruvar vid varje bladbyte. Skruven är det enda som håller bladet på plats medan skivan roterar, och en trött skruv kan lossna eller gå av under drift. Alla bladpaket innehåller inte skruvar, så kontrollera produktbeskrivningen och beställ dem separat vid behov. Dra åt ordentligt, men inte så hårt att hållaren tar skada.',
  },
  {
    question: 'Hur mycket begränsningskabel behöver jag?',
    answer: 'Det avgörs av tomtens form, inte bara av ytan. Som riktmärke räcker 150 meter till ungefär 1 500 kvadratmeter och 100 meter till mindre tomter. Har du många öar runt rabatter, träd och trampoliner går det åt betydligt mer kabel än på en rektangulär gräsmatta av samma storlek. Köp hellre några meter för mycket, resten är bra att ha vid en framtida reparation.',
  },
  {
    question: 'Passar bladen även robotar utan slinga?',
    answer: 'Ja, men välj ett paket som anger just din modell. Kabellösa robotar som Segway Navimow, Mammotion Luba och Yuka, Dreame och Ecovacs Goat har egna knivpaket, och de hittar du ovan. Det som avgör passformen är hållarsystemet på klippskivan, inte navigeringstekniken. Kontrollera ändå produktbeskrivningen mot din exakta modell innan du beställer, hållare kan skilja sig mellan generationer.',
  },
];

const breadcrumbs = [
  { label: 'Reservdelar', href: '/reservdelar/' },
  { label: 'Knivar & kabel' },
];

const faqSchema = faqItems.map((item) => ({
  "@type": "Question",
  "name": item.question,
  "acceptedAnswer": {
    "@type": "Answer",
    "text": item.answer,
  },
}));
export const articleMeta = {
  title: "Reservknivar till robotgräsklippare 2026: guide och köp",
  description: "Köpguide till reservknivar för robotgräsklippare 2026. Original och kompatibla alternativ till Husqvarna, Gardena och fler. Se byte-intervall och pris.",
  publishDate: "2026-03-29",
  category: "Reservdelar",
  image: "/images/parts-lawn-blade.webp",
};

---

<BaseLayout
  title="Reservknivar till robotgräsklippare 2026: guide och köp"
  description="Köpguide till reservknivar för robotgräsklippare 2026. Original och kompatibla alternativ till Husqvarna, Gardena och fler. Se byte-intervall och pris."
  article={{ datePublished: "2026-03-29", dateModified: "2026-07-27", image: "/images/parts-lawn-blade.webp" }}
>
  <section class="bg-primary text-white py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} light={true} />
    <AuthorByline datePublished="2026-03-29" dateModified="2026-07-27" />
      <h1 class="font-heading text-3xl sm:text-4xl font-bold mb-3">Knivar och kabel till robotgräsklippare</h1>
      <p class="text-gray-200 max-w-2xl">Ersättningsknivar, begränsningskabel och kabelklämmor till Husqvarna Automower, Gardena Sileno och Worx Landroid.</p>
    </div>
  </section>

  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
<p class="text-sm text-text-light mb-2">Senast uppdaterad: juli 2026, {products.length} produkter</p>

    <AnswerBox
      question="Snabbt svar: Vilka knivar passar din robotgräsklippare?"
      answer="Universalblad passar Husqvarna Automower, Gardena Sileno och Greenworks Optimow som använder det vanliga triangulära hållarsystemet. Kabellösa robotar som Segway Navimow, Mammotion Luba och Ecovacs Goat har egna knivpaket. Byt knivarna varje vår innan säsongen, slöa blad river gräset i stället för att klippa det. Har du stenig eller krävande mark håller titanblad skärpan längre än vanliga stålblad."
    />

    <div class="bg-accent/5 border border-accent/20 rounded-xl px-5 py-4 mb-8 text-sm text-text">
      <strong>Byt knivar varje säsong:</strong> Slöa knivar river gräset istället för att klippa det, vilket stressar gräsmattan och ökar risken för sjukdomar. Byt på våren innan säsongsstart.
    </div>

    <h2 class="font-heading text-xl font-bold text-text mb-4">Knivar</h2>
    <div class="space-y-4 mb-10">
      {products.filter((p) => p.group === 'kniv').map((p, i) => (
        <article class="bg-white rounded-xl border border-border shadow-sm transition-shadow p-5">
          <div class="flex flex-col sm:flex-row gap-4">
            <div class="flex-shrink-0 flex flex-col items-center gap-2">
              {i === 0 && p.badge && <span class="text-xs font-bold uppercase px-3 py-1 rounded-full bg-winner/10 text-winner">{p.badge}</span>}
              {i > 0 && p.badge && <span class="text-xs font-bold uppercase px-3 py-1 rounded-full bg-bg-alt text-text-light">{p.badge}</span>}
              {p.img && (
                <div class="w-32 h-32 bg-gray-50 rounded-xl p-2 flex items-center justify-center border border-border">
                  <img src={p.img} alt={p.name} class="w-full h-full object-contain" loading="lazy" width="200" height="200" />
                </div>
              )}
            </div>
            <div class="flex-1 min-w-0">
              <h2 class="font-heading font-bold text-text text-base mb-1">{p.name}</h2>
              <p class="text-xs text-accent font-medium mb-1">{p.compat}</p>
              {p.includes && (
                <p class="text-xs text-text-light mb-1"><strong class="text-text">Innehåller:</strong> {p.includes}</p>
              )}
              {p.detail && <p class="text-xs text-text-light mb-4">{p.detail}</p>}
              <div class="flex flex-wrap items-center gap-3">
                {p.buyUrl && (
                  <a
                    href={p.buyUrl}
                    rel="sponsored nofollow noopener noreferrer"
                    target="_blank"
                    class="inline-flex items-center justify-center bg-cta hover:bg-cta-dark text-white font-semibold px-5 py-2.5 rounded-lg transition-colors text-sm min-h-[44px]"
                  >
                    Bra pris hos {p.store}
                  </a>
                )}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <h2 class="font-heading text-xl font-bold text-text mb-4">Begränsningskabel och klämmor</h2>
    <div class="space-y-4 mb-10">
      {products.filter((p) => p.group === 'kabel').map((p) => (
        <article class="bg-white rounded-xl border border-border shadow-sm transition-shadow p-5">
          <div class="flex flex-col sm:flex-row gap-4">
            <div class="flex-shrink-0 flex flex-col items-center gap-2">
              {p.badge && <span class="text-xs font-bold uppercase px-3 py-1 rounded-full bg-bg-alt text-text-light">{p.badge}</span>}
              {p.img && (
                <div class="w-32 h-32 bg-gray-50 rounded-xl p-2 flex items-center justify-center border border-border">
                  <img src={p.img} alt={p.name} class="w-full h-full object-contain" loading="lazy" width="200" height="200" />
                </div>
              )}
            </div>
            <div class="flex-1 min-w-0">
              <h2 class="font-heading font-bold text-text text-base mb-1">{p.name}</h2>
              <p class="text-xs text-accent font-medium mb-1">{p.compat}</p>
              {p.includes && (
                <p class="text-xs text-text-light mb-1"><strong class="text-text">Innehåller:</strong> {p.includes}</p>
              )}
              {p.detail && <p class="text-xs text-text-light mb-4">{p.detail}</p>}
              <div class="flex flex-wrap items-center gap-3">
                {p.buyUrl && (
                  <a
                    href={p.buyUrl}
                    rel="sponsored nofollow noopener noreferrer"
                    target="_blank"
                    class="inline-flex items-center justify-center bg-cta hover:bg-cta-dark text-white font-semibold px-5 py-2.5 rounded-lg transition-colors text-sm min-h-[44px]"
                  >
                    Bra pris hos {p.store}
                  </a>
                )}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <section class="mb-10">
      <h2 class="font-heading text-xl font-bold text-text mb-4">Mer om knivar och kabel</h2>
      <div class="space-y-6 text-sm text-text-light leading-relaxed">
        <div>
          <h3 class="font-heading text-lg font-bold text-text mb-2">Varför ser gräsmattan sliten ut trots daglig klippning?</h3>
          <p class="mb-3">Slöa knivar river av gräset i stället för att skära ett rent snitt. Topparna fransas, torkar och ger gräsmattan en matt, sliten ton samtidigt som risken för sjukdomar ökar. Byt bladen på våren innan säsongen och kontrollera dem var 4 till 6 vecka om marken är hård eller stenig.</p>
          <p>Kabellösa robotar har egna knivpaket, ovan hittar du blad till Segway Navimow, Mammotion Luba och Yuka, Dreame och Ecovacs Goat. Är du nyfiken på GPS-navigerade klippare utan kabel har vi samlat dem i vår guide till <a href="/robotgrasklippare-utan-slinga/" class="text-accent underline">robotgräsklippare utan slinga</a>.</p>
        </div>
        <div>
          <h3 class="font-heading text-lg font-bold text-text mb-2">Kan du byta bara de blad som ser slitna ut?</h3>
          <p class="mb-3">Nej, byt alltid alla blad på klippskivan samtidigt. Blandar du gamla och nya blad blir skivan obalanserad, vilket ger vibrationer, högre ljud och ett ojämnt klippresultat. Använd alltid nya skruvar vid varje byte, och kontrollera i produktbeskrivningen om skruvar ingår i paketet.</p>
          <p>Med ett 27- till 36-pack räcker en beställning till många kompletta byten, så du kan byta oftare utan att tänka på kostnaden. Modellspecifik kompatibilitet för Automower 105 till 450X hittar du på vår sida med <a href="/reservdelar/husqvarna/" class="text-accent underline">Husqvarna Automower reservdelar</a>.</p>
        </div>
      </div>
    </section>

    <section class="mb-8">
      <h2 class="font-heading text-xl font-bold text-text mb-4">Fler reservdelar</h2>
      <div class="grid sm:grid-cols-2 gap-3">
        <a href="/reservdelar/husqvarna/" class="bg-white border border-border rounded-lg px-4 py-3 hover:border-accent transition-all text-sm font-semibold text-text hover:text-accent">Alla Husqvarna reservdelar</a>
        <a href="/reservdelar/robotgrasklippare/" class="bg-white border border-border rounded-lg px-4 py-3 hover:border-accent transition-all text-sm font-semibold text-text hover:text-accent">Robotgräsklippare reservdelar</a>
        <a href="/reservdelar/filter/" class="bg-white border border-border rounded-lg px-4 py-3 hover:border-accent transition-all text-sm font-semibold text-text hover:text-accent">Filter till robotdammsugare</a>
        <a href="/reservdelar/" class="bg-white border border-border rounded-lg px-4 py-3 hover:border-accent transition-all text-sm font-semibold text-text hover:text-accent">Alla reservdelar</a>
      </div>
    </section>

    <FAQ items={faqItems} />

  </main>
</BaseLayout>
