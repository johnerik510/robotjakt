---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import FAQ from '../../components/FAQ.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AnswerBox from '../../components/AnswerBox.astro';


const products = [
  {
    asin: 'B0CG4RR3W5',
    img: '/images/parts-roborock-s8-kit.webp',
    name: 'Roborock S8 / S8+ / S8 Pro Ultra, komplett tillbehörskit',
    compat: 'Passar: S8, S8+, S8 Pro Ultra, S8 Max Ultra, S8 MaxV Ultra',
    includes: '2 HEPA-filter, 2 huvudborstar, 4 sidoborstar, 4 moppdukar',
    badge: 'Populärast',
    brand: 'Roborock',
  },
  {
    asin: 'B0CY5CWRXQ',
    img: '/images/parts-roborock-qrevo-kit.webp',
    name: 'Roborock Qrevo S / Qrevo Pro / Qrevo MaxV, 20-delars kit',
    compat: 'Passar: Qrevo S, Qrevo Pro, Qrevo MaxV, Qrevo Plus',
    includes: '1 huvudborste, 6 sidoborstar, 4 HEPA-filter, 4 moppkuddar, 4 dammpåsar',
    badge: null,
    brand: 'Roborock',
  },
  {
    asin: 'B0DFBMQ64P',
    img: '/images/parts-dreame-x40-kit.webp',
    name: 'Dreame X40 Ultra / X30 Ultra / L20 Ultra, 18-delars kit',
    compat: 'Passar: X40 Ultra, X30 Ultra, L20 Ultra',
    includes: '1 huvudborste, 4 sidoborstar, 4 HEPA-filter, 4 moppkuddar, 4 dammpåsar',
    badge: null,
    brand: 'Dreame',
  },
  {
    asin: 'B0DTTPX9DW',
    img: '/images/parts-dreame-x40-filter.webp',
    name: 'Dreame X40 Ultra / L10s Pro Ultra Heat, 4-pack filter',
    compat: 'Passar: X40 Ultra Complete, X40 Master, L10s Pro Ultra Heat, X30 Pro Plus',
    includes: '4 HEPA E12-filter',
    badge: 'Bästa pris',
    brand: 'Dreame',
  },
  {
    asin: 'B0DQ84RLZ7',
    img: '/images/parts-ecovacs-x5-kit.webp',
    name: 'Ecovacs Deebot X5 Omni / X5 Pro, 20-delars kit',
    compat: 'Passar: Deebot X5 Omni, X5 Pro',
    includes: '1 rullborste, 4 sidoborstar, 4 HEPA-filter, 6 dammpåsar, 4 mopptorkdukar',
    badge: null,
    brand: 'Ecovacs',
  },
  {
    asin: 'B0DF8695XP',
    img: '/images/parts-ecovacs-x5-brush-kit.webp',
    name: 'Ecovacs Deebot X5 Omni / X5 Pro, borstar + filter + mopp',
    compat: 'Passar: Deebot X5 Omni, X5 Pro',
    includes: '1 huvudborste, 4 sidoborstar, 3 HEPA-filter, 3 dammpåsar, 4 mopptorkdukar',
    badge: null,
    brand: 'Ecovacs',
  },
];

const brands = ['Roborock', 'Dreame', 'Ecovacs'];

const faqItems = [
  {
    question: 'Vilka reservdelar behöver man byta regelbundet?',
    answer: 'HEPA-filter (var 2 till 3 mån), sidoborstar (var 6 till 12 mån), huvudborste (var 12 mån) och moppkuddar (tvätta veckovis, byt vid slitage). Dammpåsar vid behov.',
  },
  {
    question: 'Kostar det mycket att underhålla en robotdammsugare?',
    answer: 'Nej. Ett komplett tillbehörskit räcker i regel 6 till 12 månader och täcker filter, borstar och moppkuddar i samma köp. Det är en liten löpande kostnad jämfört med vad roboten kostade, och den avgör hur bra den städar resten av sin livslängd.',
  },
  {
    question: 'Kan jag köpa originaldelar eller räcker tredjepartskits?',
    answer: 'Tredjepartskits fungerar utmärkt för förbrukningsartiklar som filter och borstar. Välj kit med tydlig kompatibilitetsinfo och goda recensioner.',
  },
  {
    question: 'Hur ser jag att borstarna behöver bytas?',
    answer: 'Sidoborstarna ger sig först. När stråna böjt sig utåt och tappat formen sopar de inte längre in smutsen mot sugöppningen, och då är det dags. Huvudborsten klarar ofta ett år eller mer, men bara om du håller den fri från hår som lindat sig runt valsen. Platta eller missfärgade moppkuddar är samma signal, resultatet sjunker innan delen ser trasig ut.',
  },
  {
    question: 'Vilka extra delar tillkommer med en självtömmande station?',
    answer: 'Dammpåsar är den delen som tillkommer, och de är knutna till exakt stationstyp. I gengäld slipper du tömma behållaren för hand. Har din robot ingen station behöver du inga påsar alls, så köp inte ett kit med dammpåsar till en sådan modell. Stationens tvättbricka och vattenbehållare behöver dessutom sköljas ur med jämna mellanrum.',
  },
  {
    question: 'Räcker det att rengöra filtret i stället för att byta det?',
    answer: 'Nej, men det förlänger livslängden. Knacka rent filtret mellan bytena så håller det hela intervallet ut i stället för att sätta igen i förtid. Filtermaterialet slits ändå och fångar sämre med tiden, så ett byte var 2 till 3 månad står kvar även om du sköter rengöringen. Samma princip gäller huvudborsten: rensa bort hår löpande, men byt den när stråna tappat spänsten.',
  },
  {
    question: 'Varför tappar roboten sugkraft trots nya filter?',
    answer: 'Leta efter hår, inte efter delar. Långt hår lindar sig runt huvudborstens axlar där rullen möter hjulhuset, och det bromsar borsten utan att synas ovanifrån. Nästa ställe är sugkanalen mellan roboten och stationens påse, där tovor fastnar i böjen och gör tömningen sämre. Kontrollera också tätningen där roboten dockar, hår som lagt sig där släpper ut sugtrycket. Alla tre tar en minut att rensa.',
  },
  {
    question: 'Ska sensorerna rengöras när man byter delar?',
    answer: 'Ja, gör det till en vana i samma vända. Torka av LiDAR-tornets fönster, falloghindersensorerna längs kanten och laddkontakterna med en torr mikrofiberduk. Damm på sensorerna märks som att roboten kör ryckigt, tappar bort sig eller ritar om kartan i onödan, och det misstas ofta för ett slitet filter. Använd inte rengöringsmedel eller vatten, och skrapa aldrig bort intorkad smuts från linsfönstret.',
  },
];

const breadcrumbs = [
  { label: 'Reservdelar', href: '/reservdelar/' },
  { label: 'Robotdammsugare' },
];

const faqSchema = faqItems.map((item) => ({
  "@type": "Question",
  "name": item.question,
  "acceptedAnswer": {
    "@type": "Answer",
    "text": item.answer,
  },
}));
export const articleMeta = {
  title: "Reservdelar robotdammsugare 2026: filter, borstar, mopp",
  description: "Komplett guide till reservdelar för robotdammsugare 2026. Filter, sidoborstar, huvudborstar och moppar till alla märken. Se byte-intervall och pris.",
  publishDate: "2026-03-29",
  category: "Reservdelar",
  image: "/images/parts-robot-kit-5.webp",
};

---

<BaseLayout
  title="Reservdelar robotdammsugare 2026: filter, borstar, mopp"
  description="Komplett guide till reservdelar för robotdammsugare 2026. Filter, sidoborstar, huvudborstar och moppar till alla märken. Se byte-intervall och pris."
  article={{ datePublished: "2026-03-29", dateModified: "2026-07-27", image: "/images/parts-robot-kit-5.webp" }}
>
  <section class="bg-primary text-white py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} light={true} />
    <AuthorByline datePublished="2026-03-29" dateModified="2026-07-27" />
      <h1 class="font-heading text-3xl sm:text-4xl font-bold mb-3">Robotdammsugare reservdelar</h1>
      <p class="text-gray-200 max-w-2xl">Kompletta tillbehörskit till Roborock, Dreame och Ecovacs. Filter, borstar och moppkuddar, allt på ett ställe.</p>
    </div>
  </section>

  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <AnswerBox
      question="Snabbt svar: Vilka reservdelar behöver en robotdammsugare?"
      answer="En robotdammsugare behöver nytt HEPA-filter var 2 till 3 månad, nya sidoborstar var 6 till 12 månad och ny huvudborste ungefär var 12 månad. Moppkuddar tvättas varje vecka och byts vid slitage. Ett komplett tredjepartskit till Roborock, Dreame eller Ecovacs räcker i regel 6 till 12 månader."
    />
<p class="text-sm text-text-light mb-6">Senast uppdaterad: juli 2026, {products.length} produkter</p>

    <div class="flex flex-wrap gap-2 mb-8">
      {brands.map(b => (
        <a href={`/reservdelar/${b.toLowerCase()}/`} class="bg-white border border-border rounded-full px-4 py-2 text-sm font-semibold text-text hover:border-accent hover:text-accent transition-colors">{b}</a>
      ))}
      <a href="/reservdelar/filter/" class="bg-white border border-border rounded-full px-4 py-2 text-sm font-semibold text-text hover:border-accent hover:text-accent transition-colors">Bara filter</a>
      <a href="/reservdelar/borstar/" class="bg-white border border-border rounded-full px-4 py-2 text-sm font-semibold text-text hover:border-accent hover:text-accent transition-colors">Bara borstar</a>
    </div>

    <div class="space-y-4 mb-10">
      {products.map((p, i) => (
        <article class="bg-white rounded-xl border border-border shadow-sm transition-shadow p-5">
          <div class="flex flex-col sm:flex-row gap-4">
            <div class="flex-shrink-0 flex flex-col items-center gap-2">
              {i === 0 && <span class="text-xs font-bold uppercase px-3 py-1 rounded-full bg-winner/10 text-winner">{p.badge}</span>}
              {i > 0 && p.badge && <span class="text-xs font-bold uppercase px-3 py-1 rounded-full bg-bg-alt text-text-light">{p.badge}</span>}
              <div class="w-32 h-32 bg-gray-50 rounded-xl p-2 flex items-center justify-center border border-border">
                <img src={p.img} alt={p.name} class="w-full h-full object-contain" loading="lazy" width="200" height="200" />
              </div>
              <span class="text-xs text-text-lighter font-medium">{p.brand}</span>
            </div>
            <div class="flex-1 min-w-0">
              <h2 class="font-heading font-bold text-text text-base mb-1">{p.name}</h2>
              <p class="text-xs text-accent font-medium mb-2">{p.compat}</p>
              <p class="text-xs text-text-light mb-4"><strong class="text-text">Innehåller:</strong> {p.includes}</p>
              <div class="flex flex-wrap items-center gap-3">
                
                
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <section class="mb-10">
      <h3 class="font-heading text-lg font-bold text-text mb-2">Vad händer om jag inte byter HEPA-filtret i tid?</h3>
      <p class="text-sm text-text-light leading-relaxed mb-3">
        Ett igensatt HEPA-filter stryper luftflödet genom roboten, vilket sänker sugkraften och gör att motorn arbetar hårdare än den behöver. Fina partiklar som pollen och dammkvalster fastnar dessutom sämre, vilket märks särskilt i hem med allergiker. Byt filtret var 2 till 3 månad för jämn prestanda.
      </p>
      <p class="text-sm text-text-light leading-relaxed mb-6">
        Knacka rent filtret mellan bytena så håller det intervallet ut. Är filterprestandan extra viktig hemma hos dig, till exempel vid pollenallergi, har vi samlat modellerna med bäst filtrering i vår guide till <a href="/robotdammsugare-allergiker/" class="text-accent underline">robotdammsugare för allergiker</a>.
      </p>

      <h3 class="font-heading text-lg font-bold text-text mb-2">Passar samma reservdelskit till flera märken?</h3>
      <p class="text-sm text-text-light leading-relaxed mb-3">
        Nej, reservdelskit är märkes- och seriespecifika. Ett kit till Roborock S8-serien passar inte en Dreame X40 Ultra eller en Ecovacs Deebot X5 Omni, eftersom filter, borstar och moppkuddar har olika form och fästen. Kontrollera alltid att din exakta modell står med i kompatibilitetslistan.
      </p>
      <p class="text-sm text-text-light leading-relaxed mb-6">
        Även inom samma märke skiljer sig systemen mellan serierna, hos Roborock delar till exempel inte S8-serien och Qrevo-serien några delar. Hela uppdelningen per serie hittar du på vår sida om <a href="/reservdelar/roborock/" class="text-accent underline">Roborock reservdelar</a>.
      </p>

      <h3 class="font-heading text-lg font-bold text-text mb-2">Är det billigare att köpa kit än enstaka delar?</h3>
      <p class="text-sm text-text-light leading-relaxed mb-3">
        Ett komplett kit räcker i regel 6 till 12 månader och innehåller alla delar som slits under den tiden: filter, sidoborstar, huvudborste och moppkuddar. Har däremot bara en enda del gått sönder i förtid är styckköp både snabbare och mer träffsäkert än att beställa om hela kittet.
      </p>
      <p class="text-sm text-text-light leading-relaxed mb-3">
        Delarna slits i olika takt, och det är därför kiten innehåller fler sidoborstar än huvudborstar. Sidoborstarna böjer sig och tappar formen snabbast, filtret sätter igen av fint damm, medan huvudrullen klarar ett helt år eller mer om du håller den fri från hår.
      </p>
      <p class="text-sm text-text-light leading-relaxed mb-6">
        En låda med kitdelar hemma blir därför sällan liggande, du plockar bara nästa del när appen larmar. Är det bara filter du behöver fylla på finns de samlade på vår sida om <a href="/reservdelar/filter/" class="text-accent underline">filter till robotdammsugare</a>.
      </p>

      <h3 class="font-heading text-lg font-bold text-text mb-2">Behöver en robot med basstation fler reservdelar?</h3>
      <p class="text-sm text-text-light leading-relaxed mb-3">
        Ja, en robot med automatisk tömningsstation har dammpåsar som extra förbrukningsdel, och de är knutna till exakt stationstyp. I gengäld slipper du tömma behållaren för hand. Modeller utan station behöver inga påsar alls, så köp inte kit med påsar till en sådan robot.
      </p>
      <p class="text-sm text-text-light leading-relaxed mb-3">
        Stationens moppdel kräver också sitt. Roboten tvättar moppdukarna i stationen, men själva tvättbrickan och vattenbehållarna behöver sköljas ur med jämna mellanrum. Annars börjar det lukta, och smutsen följer med tillbaka ut på golvet vid nästa körning.
      </p>
      <p class="text-sm text-text-light leading-relaxed">
        Funderar du på om stationen är värd merkostnaden i delar och skötsel, går vi igenom vad den faktiskt tar över i vår guide till <a href="/guide/automatisk-tomning/" class="text-accent underline">automatisk tömning i robotdammsugare</a>.
      </p>
    </section>

    <FAQ items={faqItems} />

  </main>
</BaseLayout>
