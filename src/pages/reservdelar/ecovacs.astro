---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import FAQ from '../../components/FAQ.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AnswerBox from '../../components/AnswerBox.astro';


const products = [
  {
    asin: 'B0DQ84RLZ7',
    img: '/images/parts-ecovacs-x5-kit.webp',
    name: 'Ecovacs Deebot X5 Omni / X5 Pro, 20-delars komplett kit',
    compat: 'Passar: Deebot X5 Omni, X5 Pro',
    includes: '1 rullborste, 4 sidoborstar, 4 HEPA-filter, 6 dammpåsar, 4 mopptorkdukar, rengöringsborste',
    badge: 'Bästsäljare',
  },
  {
    asin: 'B0D7D1V4BP',
    img: '/images/parts-robot-kit-5.webp',
    name: 'Ecovacs Deebot X5 Omni / X5 Pro, komplett tillbehörskit',
    compat: 'Passar: Deebot X5 Omni, X5 Pro',
    includes: '1 rullborste, 4 sidoborstar, 3 HEPA-filter, 3 dammpåsar, 4 mopptorkdukar',
    badge: 'Premium',
  },
  {
    asin: 'B0DF8695XP',
    img: '/images/parts-ecovacs-x5-brush-kit.webp',
    name: 'Ecovacs Deebot X5 Omni / X5 Pro, borstar + filter + mopp',
    compat: 'Passar: Deebot X5 Omni, X5 Pro',
    includes: '1 huvudborste, 4 sidoborstar, 3 HEPA-filter, 3 dammpåsar, 4 mopptorkdukar',
    badge: null,
  },
  {
    asin: 'B0DY1DF8HQ',
    img: '/images/parts-ecovacs-kit-2.webp',
    name: 'HIYOUNG, Ecovacs Deebot X5 / X5 Pro Omni, 20-delars kit',
    compat: 'Passar: Deebot X5 Omni, X5 Pro',
    includes: '2 huvudborstar, 4 sidoborstar, 4 HEPA-filter, 6 mopptorkdukar, 4 dammpåsar',
    badge: null,
  },
];

const faqItems = [
  {
    question: 'Passar alla Deebot X5-kit varandra?',
    answer: 'Deebot X5 Omni och X5 Pro delar samma reservdelssystem. Kontrollera att kittet du köper anger X5 Omni eller X5 Pro som kompatibel modell, inte bara "X5". Andra Deebot-serier kan ha andra mått på rullborste, filter och moppfäste, så utgå inte från att X5-delarna passar dem.',
  },
  {
    question: 'Hur ofta byter jag dammpåsar i Ecovacs dockningsstation?',
    answer: 'Byt dammpåsar när de är fyllda till 70 till 80 % eller var 4 till 6 vecka vid daglig städning. Appen meddelar dig när påsen behöver bytas.',
  },
  {
    question: 'Kan jag tvätta moppkuddarna i maskin?',
    answer: 'Ja, de flesta Ecovacs-moppkuddar är tvättbara i 40 grader. Låt dem lufttorka helt innan du sätter tillbaka dem, fuktig moppkudda kan skapa mögel och dålig lukt.',
  },
  {
    question: 'Hur vet jag när HEPA-filtret behöver bytas?',
    answer: 'När sugkraften märkbart försämras. Ett igensatt filter stryper luftflödet, och ofta hör du det först: sugljudet ändrar karaktär och roboten lämnar kvar smuts den tidigare tog. Håll upp filtret mot ljuset, syns nästan inget ljus igenom är det dags. Husdjur och mycket mattor sätter igen filtret snabbare, så i sådana hem behöver du kontrollera det oftare.',
  },
  {
    question: 'Hur länge räcker ett komplett tillbehörskit?',
    answer: 'Det beror på hur många dammpåsar kittet innehåller, för det är de som sätter takten. Byter du påse var fjärde till sjätte vecka räcker de tre påsarna i de mindre kitten i runt tre till fyra månader, medan de sex påsarna i 20-delarskittet täcker ungefär dubbelt så lång tid. Filtren och mopptorkdukarna, tre till fyra respektive fyra till sex per kit, räcker normalt lika länge. Har du husdjur går borstar och filter åt snabbare, då är det större kittet en bättre affär.',
  },
  {
    question: 'Är tredjepartskit lika bra som originaldelar?',
    answer: 'Det varierar mellan tillverkare, och det viktigaste är inte märket utan att modellbeteckningen stämmer exakt. På den här sidan finns både omärkta kit och tillverkare som HIYOUNG, samtliga angivna för Deebot X5 Omni och X5 Pro. Kontrollera alltid att förpackningen listar din exakta modell. En del som nästan passar sitter dåligt, sliter i onödan och kan läcka damm förbi filtret.',
  },
  {
    question: 'När ska moppkuddarna bytas i stället för att tvättas?',
    answer: 'När de blivit tunna, hårda eller slutat torka upp ordentligt. En sliten moppkudde sprider smuts i stället för att ta upp den, och då hjälper ingen tvätt. Kitten på den här sidan innehåller fyra till sex mopptorkdukar var, så du har utbyte hemma när det är dags. Byt hellre en kudde för tidigt än för sent, den kostar lite och påverkar hela moppresultatet.',
  },
  {
    question: 'Hur ofta ska rullborsten och sidoborstarna rensas?',
    answer: 'Rensa hår ur borstarna ungefär en gång i månaden, oftare om ni har husdjur eller långt hår i hushållet. Hår som lindar sig runt rullborsten försämrar upptaget på både mattor och hårda golv, och det sker gradvis utan att roboten säger till. Det stora kittet innehåller en rengöringsborste för just det jobbet. Byt borsten när stråna blivit stumma eller ojämnt slitna.',
  },
];

const breadcrumbs = [
  { label: 'Reservdelar', href: '/reservdelar/' },
  { label: 'Ecovacs' },
];

const faqSchema = faqItems.map((item) => ({
  "@type": "Question",
  "name": item.question,
  "acceptedAnswer": {
    "@type": "Answer",
    "text": item.answer,
  },
}));
export const articleMeta = {
  title: "Reservdelar Ecovacs Deebot 2026: filter och borstar",
  description: "Reservdelar till Ecovacs Deebot 2026. Filter, borstar och moppar till X5 Omni, T30S Pro och fler. Se kompatibilitet, byte-intervall och pris i Sverige.",
  publishDate: "2026-03-29",
  category: "Reservdelar",
  image: "/images/parts-robot-filter-3.webp",
};

---

<BaseLayout
  title="Reservdelar Ecovacs Deebot 2026: filter och borstar"
  description="Reservdelar till Ecovacs Deebot 2026. Filter, borstar och moppar till X5 Omni, T30S Pro och fler. Se kompatibilitet, byte-intervall och pris i Sverige."
  article={{ datePublished: "2026-03-29", dateModified: "2026-07-27", image: "/images/parts-robot-filter-3.webp" }}
>
  <section class="bg-primary text-white py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={breadcrumbs} light={true} />
    <AuthorByline datePublished="2026-03-29" dateModified="2026-07-27" />
      <h1 class="font-heading text-3xl sm:text-4xl font-bold mb-3">Ecovacs Deebot reservdelar</h1>
      <p class="text-gray-200 max-w-2xl">Tillbehörskit, filter, borstar och moppkuddar till Ecovacs Deebot X5 Omni och X5 Pro, håll roboten i toppskick.</p>
    </div>
  </section>

  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
<p class="text-sm text-text-light mb-6">Senast uppdaterad: juli 2026, {products.length} produkter</p>

    <AnswerBox
      question="Snabbt svar: Vilka reservdelar passar Ecovacs Deebot X5?"
      answer="Ecovacs Deebot X5 Omni och X5 Pro delar samma reservdelssystem, så ett kit märkt för endera modellen passar båda. Bästsäljaren är ett 20-delars komplett kit med rullborste, sidoborstar, HEPA-filter, dammpåsar och mopptorkdukar. Byt dammpåsen i dockningsstationen var 4 till 6 vecka vid daglig städning och tvätta moppkuddarna i 40 grader."
    />

    <div class="space-y-4 mb-10">
      {products.map((p, i) => (
        <article class="bg-white rounded-xl border border-border shadow-sm transition-shadow p-5">
          <div class="flex flex-col sm:flex-row gap-4">
            <div class="flex-shrink-0 flex flex-col items-center gap-2">
              {i === 0 && <span class="text-xs font-bold uppercase px-3 py-1 rounded-full bg-winner/10 text-winner">{p.badge}</span>}
              {i > 0 && p.badge && <span class="text-xs font-bold uppercase px-3 py-1 rounded-full bg-bg-alt text-text-light">{p.badge}</span>}
              <div class="w-32 h-32 bg-gray-50 rounded-xl p-2 flex items-center justify-center border border-border">
                <img src={p.img} alt={p.name} class="w-full h-full object-contain" loading="lazy" width="200" height="200" />
              </div>
            </div>
            <div class="flex-1 min-w-0">
              <h2 class="font-heading font-bold text-text text-base mb-1">{p.name}</h2>
              <p class="text-xs text-accent font-medium mb-2">{p.compat}</p>
              <p class="text-xs text-text-light mb-4"><strong class="text-text">Innehåller:</strong> {p.includes}</p>
              <div class="flex flex-wrap items-center gap-3">
                
                
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <section class="mb-10">
      <h2 class="font-heading text-xl font-bold text-text mb-4">Guide: reservdelar till Ecovacs Deebot</h2>
      <div class="space-y-6 text-sm text-text-light leading-relaxed">
        <div>
          <h3 class="font-heading text-lg font-bold text-text mb-2">När ska du byta dammpåse och filter på en Deebot?</h3>
          <p class="mb-3">Byt dammpåsen i dockningsstationen när den är fylld till 70 till 80 procent, i praktiken var 4 till 6 vecka vid daglig städning. Appen säger till när det är dags. HEPA-filtret i själva roboten byter du när sugkraften märkbart försämras, ett igensatt filter stryper luftflödet.</p>
          <p>Kitten på den här sidan innehåller flera filter och dammpåsar per köp, så en beställning täcker många månaders förbrukning. Rekommenderade bytesintervall per modell och märke hittar du i vår översikt över <a href="/reservdelar/filter/" class="text-accent underline">filter till robotdammsugare</a>.</p>
        </div>
        <div>
          <h3 class="font-heading text-lg font-bold text-text mb-2">Hur håller du moppfunktionen fräsch på Deebot X5 Omni?</h3>
          <p class="mb-3">Tvätta moppkuddarna i maskin i 40 grader och låt dem lufttorka helt innan du sätter tillbaka dem. En fuktig kudde som stängs in i roboten kan mögla och börja lukta illa. Byt kuddarna helt när de är slitna, en sliten mopp sprider smuts i stället för att torka upp den.</p>
          <p>Rullborsten och sidoborstarna behöver också tillsyn, hår som lindar sig runt borstarna försämrar upptaget på både mattor och golv. Det stora kittet på sidan innehåller en rengöringsborste just för det jobbet. Hur moppsystemet presterar i praktiken kan du läsa i vårt test av <a href="/ecovacs-deebot-x5-omni/" class="text-accent underline">Ecovacs Deebot X5 Omni</a>.</p>
        </div>
      </div>
    </section>

    <section class="mb-8">
      <h2 class="font-heading text-xl font-bold text-text mb-4">Fler reservdelar</h2>
      <div class="grid sm:grid-cols-2 gap-3">
        <a href="/reservdelar/roborock/" class="bg-white border border-border rounded-lg px-4 py-3 hover:border-accent transition-all text-sm font-semibold text-text hover:text-accent">Roborock reservdelar</a>
        <a href="/reservdelar/dreame/" class="bg-white border border-border rounded-lg px-4 py-3 hover:border-accent transition-all text-sm font-semibold text-text hover:text-accent">Dreame reservdelar</a>
        <a href="/reservdelar/filter/" class="bg-white border border-border rounded-lg px-4 py-3 hover:border-accent transition-all text-sm font-semibold text-text hover:text-accent">Filter till robotdammsugare</a>
        <a href="/reservdelar/borstar/" class="bg-white border border-border rounded-lg px-4 py-3 hover:border-accent transition-all text-sm font-semibold text-text hover:text-accent">Borstar till robotdammsugare</a>
      </div>
    </section>

    <FAQ items={faqItems} />

  </main>
</BaseLayout>
