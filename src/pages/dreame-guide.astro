---
import { ctaRel } from '../lib/cta-rel';
import AuthorByline from '../components/AuthorByline.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import StickyCTA from '../components/StickyCTA.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import EditorialCTA from '../components/EditorialCTA.astro';
import AnswerBox from '../components/AnswerBox.astro';

const breadcrumbs = [
  { label: 'Robotdammsugare', href: '/' },
  { label: 'Dreame guide' },
];

const models = [
  {
    name: 'Dreame X60 Ultra',
    badge: 'BÄST I TEST 2026',
    badgeColor: 'bg-winner',
    rating: '4.8 / 5',
    features: [
      'Utfällbar mopp som når hörnen',
      'Varmvattentvätt av moppar i station',
      'Automatisk mattdetektion med mopp-lyft',
      'Fullautomatisk station, vatten, tömning, tvättning',
      'AI-videokamera för hinderidentifiering',
    ],
    cta: 'https://to.elon.se/t/t?a=1606750995&as=2063681412&t=2&tk=1&cupa_sku=153177&url=https://www.elon.se/dreame-x60-ultra-white-153177',
    ctaText: 'Bra pris hos Elon',
    reviewUrl: '/dreame-x40-ultra/',
    description: 'Dreame X60 Ultra är aktuell toppmodell med den unika utfällbara moppmodulen som faktiskt når in i hörnen, kombinerat med hög sugkraft och fullautomatisk station med varmvattentvätt. Det bästa valet för hem med mycket hårdgolv som kräver riktig moppning.',
  },
  {
    name: 'Dreame X50 Ultra',
    badge: 'PREMIUM, VÄLSORTERAD',
    badgeColor: 'bg-accent',
    rating: '4.6 / 5',
    features: [
      'Hög sugkraft',
      'Utfällbar sidoarm för bättre hörntäckning',
      'AI-hinderdetektion',
      'Automatisk mopplyftning vid mattor',
      'Fullautomatisk station, tömning, tvätt, torkning',
    ],
    cta: 'https://to.elon.se/t/t?a=1606750995&as=2063681412&t=2&tk=1&cupa_sku=151996&url=https://www.elon.se/dreame-x50-ultra-white-151996',
    ctaText: 'Bra pris hos Elon',
    reviewUrl: '/dreame-x30-ultra/',
    description: 'Dreame X50 Ultra är ett premiumval med sidoarm-teknologi och komplett station. Pålitlig AI-hinderdetektion och utmärkt städkvalitet för den som vill ha Dreames toppteknik.',
  },
  {
    name: 'Dreame L40 Ultra',
    badge: 'MELLANKLASS',
    badgeColor: 'bg-accent',
    rating: '4.4 / 5',
    features: [
      'Hög sugkraft',
      'Dubbla roterande moppar',
      'Automatisk station med vattenpåfyllning',
      'LiDAR-navigering med AI-hinder-detektion',
      'Bra pris/prestanda i mellansegmentet',
    ],
    cta: 'https://ion.kjell.com/t/t?a=1487384319&as=2063681412&t=2&tk=1&cupa_sku=65909&url=http://www.kjell.com/se/produkter/hem-fritid/stadning-rengoring/robotdammsugare/dreame-robotdammsugare/dreame-l40-ultra-robotdammsugare-p65909',
    ctaText: 'Bra pris hos Kjell',
    reviewUrl: '/dreame-l20-ultra/',
    description: 'Dreame L40 Ultra är ett prisvärt alternativ i mellansegmentet med dubbla roterande moppar och automatisk station. Den ger mycket städprestanda för pengarna.',
  },
  {
    name: 'Dreame L10s Ultra Gen 3',
    badge: 'BRA PRISKLASS',
    badgeColor: 'bg-text-light',
    rating: '4.2 / 5',
