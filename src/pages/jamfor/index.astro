---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AnswerBox from '../../components/AnswerBox.astro';

/* FAQPage JSON-LD removed: Google's Aug 2023 policy restricts FAQ rich results
   to government/health-authority sites. Data kept för visual FAQ rendering. */
const faqSchema = {
  mainEntity: [
    {
      "@type": "Question",
      name: "Roborock eller Dreame, vilket märke ska jag välja?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Roborock har generellt bättre app och navigering, medan Dreame ofta erbjuder mer sugkraft och lägre pris för samma prestanda. Roborock passar dig som vill ha pålitlig mjukvara, Dreame om du prioriterar råstyrka och pris/prestanda."
      }
    },
    {
      "@type": "Question",
      name: "Vad ska jag jämföra när jag väljer robotdammsugare?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "De viktigaste faktorerna är sugkraft (Pa), navigeringstyp (LiDAR vs kamera), hinderdetektering, tömningsstations-funktion, moppfunktion och pris. För hem med husdjur är hinderdetektering extra viktigt."
      }
    },
    {
      "@type": "Question",
      name: "Är det värt att betala mer för en premiumrobot?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Ja, i de flesta fall. Premiummodellerna ger LiDAR-navigering, självtömmande station och hinderigenkänning som faktiskt sparar tid, medan budgetmodellerna oftast saknar just de funktionerna. Det du betalar extra för är alltså inte högre toppsiffror utan att du slipper göra jobbet själv."
      }
    },
    {
      "@type": "Question",
      name: "Husqvarna eller Mammotion robotgräsklippare?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Båda är slinglösa i sina aktuella serier, så valet handlar inte längre om kabel. Husqvarnas V- och NERA-modeller ritar gränserna virtuellt med satellitpositionering och AI-vision, och märket har ett betydligt bredare service- och reservdelsnät i Sverige. Mammotion har fyrhjulsdrift och tar sig fram på brantare och stökigare mark. Välj Husqvarna för lugn terräng och lokal service, Mammotion för slänter."
      }
    },
    {
      "@type": "Question",
      name: "Behöver jag en robot som både dammsuger och moppar?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Bara om du har mycket hårda golv. På parkett, klinker och laminat gör moppen verklig nytta mot kladd och damm som sugningen lämnar kvar. Har du mest heltäckningsmattor är funktionen överflödig, och roboten måste då kunna lyfta eller fälla upp moppen så att mattorna inte blir blöta. Ingen robotmopp ersätter handskrubbning av riktigt intorkade fläckar."
      }
    },
    {
      "@type": "Question",
      name: "Hur mycket löpande underhåll kräver en robot?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Mer än de flesta räknar med, oavsett märke. Filtret rengörs eller byts ett par gånger per år, borstarna behöver rensas från hår regelbundet, moppdukar byts när de är slitna och dammpåsen i stationen håller ungefär varannan månad. Robotgräsklippare behöver dessutom nya knivar under säsongen. Kontrollera att reservdelarna finns lätt i Sverige innan du binder dig vid ett märke."
      }
    },
    {
      "@type": "Question",
      name: "Lönar det sig att vänta på nästa modellgeneration?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Sällan. Nya modeller kommer varje år, och skillnaden mellan två generationer handlar oftare om högre Pa-siffror och nya appfunktioner än om hur rent det faktiskt blir. Föregångaren blir samtidigt billigare och har fler oberoende omdömen bakom sig. Vänta bara om den nya modellen tillför något du verkligen saknar, till exempel mopplyft eller navigering utan slinga."
      }
    },
    {
      "@type": "Question",
      name: "Hur vet jag vilken kapacitet min robotgräsklippare behöver?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Utgå från gräsmattans yta i kvadratmeter och köp med marginal. En klippare som ligger nära sin maxgräns måste gå längre pass varje dag och slits fortare. Lutning och tomtens form väger minst lika tungt som ytan, eftersom smala passager och branta slänter drar ner den verkliga kapaciteten. Är tomten öppen med fri sikt mot himlen är slingfri GPS oftast enklast."
      }
    }
  ]
};

const comparisons = [
  {
    title: 'Roborock Saros 10R vs Dreame X40 Ultra 2026',
    href: '/jamfor/roborock-saros-10r-vs-dreame-x40-ultra/',
    desc: 'Roborock Saros 10R mot Dreame X40 Ultra. Världens tunnaste robot (7,98 cm) och 20 000 Pa mot utfällbar sidoarm och bäst pris/prestanda. Är extra värt det?',
    tag: 'Roborock vs Dreame',
  },
  {
    title: 'Roborock Saros 10R vs Roborock S8 MaxV Ultra 2026',
    href: '/jamfor/roborock-saros-10r-vs-roborock-s8-maxv-ultra/',
    desc: 'Roborock Saros 10R mot Roborock S8 MaxV Ultra. Ny toppmodell mot beprövat flaggskepp. 7,98 cm och 20 000 Pa mot 9,65 cm och 10 000 Pa, är det värt extra?',
    tag: 'Roborock vs Roborock',
  },
  {
    title: 'Dreame L20 Ultra vs X40 Ultra 2026',
    href: '/jamfor/dreame-l20-ultra-vs-dreame-x40-ultra/',
    desc: 'Budget mot premium inom Dreame-familjen. L20 Ultra eller X40 Ultra, vilken passar ditt hem?',
    tag: 'Dreame vs Dreame',
  },
  {
    title: 'Dreame X40 Ultra vs Roborock S8 MaxV Ultra 2026',
    href: '/dreame-x40-ultra-vs-roborock-s8-maxv-ultra/',
    desc: '12 000 Pa och utfällbar mopp mot 10 000 Pa och AI-djurskydd. Flaggskepp mot flaggskepp.',
    tag: 'Dreame vs Roborock',
  },
  {
    title: 'Roborock Qrevo Master vs Dreame X40 Ultra 2026',
    href: '/jamfor/roborock-qrevo-master-vs-dreame-x40-ultra/',
    desc: 'Roborock Qrevo Master mot Dreame X40 Ultra. FlexiArm och gummirulle mot utfällbar sidoarm och 12 000 Pa.',
    tag: 'Roborock vs Dreame',
  },
  {
    title: 'Roborock Qrevo Master vs S8 MaxV Ultra 2026',
    href: '/jamfor/roborock-qrevo-master-vs-roborock-s8-maxv-ultra/',
    desc: 'Samma sugkraft, skillnad. Är AI-djuravföringsdetektion och ReactiveAI 3.0 värt merkostnaden?',
    tag: 'Roborock vs Roborock',
  },
  {
    title: 'Roborock vs Dreame 2026, märkesjämförelse',
    href: '/roborock-vs-dreame/',
    desc: 'Vilket märke ska du välja? Vi jämför ekosystem, reservdelar, app-kvalitet och total value.',
    tag: 'Märkesjämförelse',
  },
  {
    title: 'Ecovacs X5 Omni vs Dreame X40 Ultra 2026',
    href: '/jamfor/ecovacs-deebot-x5-omni-vs-dreame-x40-ultra/',
    desc: 'Fyrkantig design och 180 min batteri mot 12 000 Pa och utfällbar sidoarm. mot .',
    tag: 'Ecovacs vs Dreame',
  },
  {
    title: 'Ecovacs X5 Omni vs Roborock S8 MaxV Ultra 2026',
    href: '/jamfor/ecovacs-deebot-x5-omni-vs-roborock-s8-maxv-ultra/',
    desc: 'Ecovacs X5 Omni mot Roborock S8 MaxV Ultra. Fyrkantig design och AIVI 3D mot LiDAR och 10 000 Pa. Två flaggskepp i samma klass.',
    tag: 'Ecovacs vs Roborock',
  },
  {
    title: 'Roborock vs Ecovacs 2026, märkesjämförelse',
    href: '/roborock-vs-ecovacs/',
    desc: 'ReactiveAI 3.0 och AI-djurskydd mot 11 000 Pa och hygienisk varmluftstorkning. Vilket märke passar ditt hem?',
    tag: 'Märkesjämförelse',
  },
  {
    title: 'Husqvarna vs Mammotion 2026, robotgräsklippare',
    href: '/husqvarna-vs-mammotion/',
    desc: 'Traditionell slinga mot GPS-navigering utan slinga. Vilket system passar din trädgård?',
    tag: 'Robotgräsklippare',
  },
  {
    title: 'Husqvarna vs Gardena robotgräsklippare 2026',
    href: '/husqvarna-vs-gardena/',
    desc: 'De ägs av samma företag, men skiljer sig i pris, kapacitet och GPS-stöldskydd. Vilket passar din trädgård?',
    tag: 'Robotgräsklippare',
  },
  {
    title: 'Gardena vs Segway Navimow 2026, kabel vs kabelläst GPS',
    href: '/gardena-vs-segway-navimow/',
    desc: 'Perimeterkabel mot slingfri GPS-navigation, pris, installation, kantklippning och vem som vinner.',
    tag: 'Robotgräsklippare',
  },
  {
    title: 'Husqvarna Automower vs Segway Navimow 2026, GPS mot GPS',
    href: '/husqvarna-vs-segway-navimow/',
    desc: 'Båda är kabelläsa GPS-robotar. Vi avgör vilket system som vinner på pris, precision och servicenätverk.',
    tag: 'Robotgräsklippare',
  },
  {
    title: 'Narwal Freo X Ultra vs Dreame X40 Ultra 2026',
    href: '/narwal-freo-x-ultra-vs-dreame-x40-ultra/',
    desc: 'Varmluftsfunktion (40°C) mot 12 000 Pa och utfällbar mopparm. Samma prisklass, helt olika USP:ar.',
    tag: 'Narwal vs Dreame',
  },
];
---

<BaseLayout
  title="Jämförelser, Robotdammsugare och Robotgräsklippare 2026"
  description="Direkta jämförelser mellan de bästa robotarna 2026. Vi svarar på: vilken ska jag välja? Dreame vs Roborock, Husqvarna vs Mammotion och mer."
  article={true}
>
  <section class="bg-primary text-white py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[{ label: 'Robotdammsugare', href: '/' }, { label: 'Jämförelser' }]} />
      <h1 class="font-heading text-3xl font-bold mb-2">Jämförelser 2026</h1>
      <AnswerBox
        question="Snabbt svar: Vilken robotjämförelse ska jag börja med?"
        answer="Börjar du från noll är märkesjämförelsen Roborock vs Dreame den bästa ingången för robotdammsugare, och Husqvarna vs Mammotion för robotgräsklippare. Vet du redan prisklass går du direkt på en modelljämförelse, till exempel Dreame L20 Ultra vs X40 Ultra. Varje jämförelse avslutas med ett tydligt köpråd för olika hemtyper."
      />
      <p class="text-base text-gray-300 max-w-3xl">
        Roborock vs Dreame, Ecovacs vs Eufy, Mammotion vs Segway Navimow. Vi ställer de mest efterfrågade robotdammsugarna och robotgräsklipparna mot varandra med oberoende tester, specifikationsdata och priser. Varje jämförelse ger ett klart svar på vilket alternativ som är värt pengarna.
      </p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {comparisons.map((c) => (
        <a href={c.href} class="block bg-white rounded-xl shadow-sm transition-shadow border border-border overflow-hidden group">
          <div class="h-1 bg-accent"></div>
          <div class="p-6">
            <span class="inline-block text-xs font-semibold text-accent bg-accent/10 px-2 py-0.5 rounded mb-2">{c.tag}</span>
            <h2 class="font-heading text-xl font-bold text-text group-hover:text-accent transition-colors mb-2">
              {c.title}
            </h2>
            <p class="text-text-light text-sm leading-relaxed">{c.desc}</p>
            <span class="inline-block mt-3 text-sm font-semibold text-accent">Se jämförelsen</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 pt-10">
    <h2 class="font-heading text-2xl font-bold text-text mb-6">Så läser du jämförelserna rätt</h2>

    <h3 class="font-heading text-lg font-semibold text-text mb-2">Vad betyder Pa i robotdammsugarnas specifikationer?</h3>
    <p class="text-text-light text-sm leading-relaxed mb-3">
      Pa står för pascal och anger hur starkt undertryck dammsugaren skapar, alltså hur hårt den suger. Fler Pa gör störst nytta på mattor där damm och hår sitter nere i luggen. På hårda golv klarar sig även modeller med måttlig sugkraft bra, där avgör borstar och navigering mer.
    </p>
    <p class="text-text-light text-sm leading-relaxed mb-6">
      Stirra dig därför inte blind på den högsta siffran. En robot med lägre sugkraft men bättre navigering städar ofta renare i praktiken, eftersom den faktiskt täcker hela golvet. Väg alltid Pa-siffran mot golven och mattorna i just ditt hem.
    </p>

    <h3 class="font-heading text-lg font-semibold text-text mb-2">Vad är skillnaden mellan LiDAR och kameranavigering?</h3>
    <p class="text-text-light text-sm leading-relaxed mb-3">
      LiDAR mäter avstånd med laser och bygger en exakt karta över rummen, helt oberoende av belysning. Kamerabaserad AI-navigering tolkar i stället vad den ser och kan känna igen föremål som skor och kablar, men behöver ljus för att fungera väl. Många toppmodeller kombinerar numera båda teknikerna.
    </p>
    <p class="text-text-light text-sm leading-relaxed mb-6">
      I jämförelserna ovan ser du vilken teknik varje modell använder. Vill du fördjupa dig i lasertekniken och se vilka modeller som bygger på den har vi samlat dem i guiden till <a href="/robotdammsugare/lidar/" class="text-accent underline">robotdammsugare med LiDAR</a>.
    </p>

    <h3 class="font-heading text-lg font-semibold text-text mb-2">Hur väljer jag mellan robotgräsklippare med och utan slinga?</h3>
    <p class="text-text-light text-sm leading-relaxed mb-3">
      Slingmodeller som Husqvarnas kräver att en kabel grävs eller pinnas ner runt gräsmattan, beprövat men arbetskrävande vid installationen. Slingfria modeller från Mammotion och Segway Navimow navigerar med GPS och kommer igång utan grävning. Har du en öppen trädgård med fri sikt mot himlen är slingfritt oftast den enklare vägen.
    </p>
    <p class="text-text-light text-sm leading-relaxed mb-6">
      Jämförelserna Husqvarna vs Mammotion och Gardena vs Segway Navimow går igenom skillnaderna modell för modell. Vill du först se hela utbudet av slingfria klippare har vi samlat dem i guiden till <a href="/robotgrasklippare-utan-slinga/" class="text-accent underline">robotgräsklippare utan slinga</a>.
    </p>
  </section>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-10">
    <h2 class="font-heading text-2xl font-bold text-text mb-6">Vanliga frågor om att jämföra robotar</h2>
    <div class="space-y-4">
      {faqSchema.mainEntity.map((item) => (
        <details class="bg-white border border-border rounded-xl overflow-hidden group">
          <summary class="flex items-center justify-between cursor-pointer px-5 py-4 font-semibold text-text hover:text-accent transition-colors list-none">
            <span>{item.name}</span>
            <svg class="w-5 h-5 text-text-light group-open:rotate-180 transition-transform flex-shrink-0 ml-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-5 pb-4 text-text-light text-sm leading-relaxed">{item.acceptedAnswer.text}</div>
        </details>
      ))}
    </div>
  </section>

</BaseLayout>
