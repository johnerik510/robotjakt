    hotWater: true,
    autoRefill: true,
    stationSize: 'Stor',
    features: [
      'Ultraljudsrengöring av moppar',
      'Platt LiDAR-torn, 8 cm hög, passar under all möbler',
      'AI-hinderdetektion',
      'Auto-tömning, mopptvätt och vattenpåfyllning',
      'LiDAR-navigering',
    ],
    cons: ['Stor station kräver 60 till 70 cm väggutrymme', 'Nyare modell, få långtidsomdömen'],
    cta: 'https://to.elon.se/t/t?a=1606750995&as=2063681412&t=2&tk=1&cupa_sku=154763&url=https://www.elon.se/roborock-saros-20-sonic-s20s52-00-svart-154763',
