import ProductCard from '../../components/ProductCard.astro';
import SkillnadsJamforelse from '../../components/SkillnadsJamforelse.astro';

const breadcrumbs = [
  { label: 'Robotdammsugare', href: '/robotdammsugare/' },
  { label: 'Robotdammsugare med basstation' },
];

const products = [
  {
