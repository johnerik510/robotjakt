---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import FAQ from '../../components/FAQ.astro';
import StickyCTA from '../../components/StickyCTA.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import AnswerBox from '../../components/AnswerBox.astro';
import MoneyFeatured from '../../components/MoneyFeatured.astro';
import MoneyComparisonTable from '../../components/MoneyComparisonTable.astro';
import MoneyTOC from '../../components/MoneyTOC.astro';

const breadcrumbs = [
  { label: 'Robotdammsugare', href: '/robotdammsugare/' },
  { label: 'Budget' },
];

const products = [
  {
    rank: 1,
    name: 'Dreame D20 Ultra',
    image: '/images/products/dreame-d20-ultra.webp',
    rating: 4.5,
    badge: 'Bäst i budget',
    pros: ['Billigast med station', 'Självtömmande station ingår', 'LiDAR-navigering', 'Moppfunktion'],
    cons: ['Enklare hinderdetektion', 'Lägre sugkraft än premium'],
    ctaText: 'Bra pris hos Elon',
    ctaUrl: 'https://to.elon.se/t/t?a=1606750995&as=2063681412&t=2&tk=1&cupa_sku=152003&url=https://www.elon.se/dreame-d20-ultra-152003',
    dataProduct: 'Dreame D20 Ultra',
  },
  {
    rank: 2,
    name: 'Dreame D20 Plus',
    image: '/images/products/dreame-d20-plus.webp',
    rating: 4.3,
    badge: 'Billigast 2026',
    pros: ['Lägsta pris med LiDAR', 'LiDAR-navigering', 'Moppfunktion', 'Enkel app-styrning'],
    cons: ['Ingen självtömmande station', 'Manuell tömning'],
    ctaText: 'Bra pris hos Elon',
    ctaUrl: 'https://to.elon.se/t/t?a=1606750995&as=2063681412&t=2&tk=1&cupa_sku=152004&url=https://www.elon.se/dreame-d20-plus-152004',
    dataProduct: 'Dreame D20 Plus',
  },
  {
    rank: 3,
    name: 'Roborock Qrevo S',
    image: '/images/products/roborock-qrevo-s.webp',
    rating: 4.4,
    badge: 'Bäst Roborock budget',
    pros: ['LiDAR-navigering', 'Moppfunktion', 'Roborocks beprövade app'],
    cons: ['Ingen självtömmande station', 'Enklare sugkraft'],
    ctaText: 'Bra pris hos Kjell',
    ctaUrl: 'https://ion.kjell.com/t/t?a=1487384319&as=2063681412&t=2&tk=1&cupa_sku=66011&url=http://www.kjell.com/se/produkter/hem-fritid/stadning-rengoring/robotdammsugare/roborock-robotdammsugare/roborock-qrevo-s-helautomatisk-robotdammsugare-vit-p66011',
    dataProduct: 'Roborock Qrevo S',
  },
  {
    rank: 4,
    name: 'Neatsvor X600 Pro',
    image: '/images/products/neatsvor-x600-pro.webp',
    rating: 4.2,
    badge: 'Prisvärd med LiDAR',
    pros: ['LiDAR-navigering', 'Moppfunktion ingår', 'Fri frakt direkt till dörren'],
    cons: ['Ingen självtömmande station', 'Enklare app'],
    ctaText: 'Bra pris hos Neatsvor',
    ctaUrl: 'https://addrevenue.io/t?c=3467327&a=985945&m=SE&u=https%3A%2F%2Fwww.neatsvor.se%2Fprodukt%2Fneatsvor-x600-pro-robotdammsugare-vit%2F',
    dataProduct: 'Neatsvor X600 Pro',
  },
  {
    rank: 5,
    name: 'Neatsvor X520',
    image: '/images/products/neatsvor-x520.webp',
    rating: 4.1,
    badge: 'Budget',
    pros: ['Moppfunktion ingår', 'App-styrning', 'Fri frakt'],
    cons: ['Enklare navigering', 'Ingen LiDAR'],
    ctaText: 'Bra pris hos Neatsvor',
    ctaUrl: 'https://addrevenue.io/t?c=3467327&a=985945&m=SE&u=https%3A%2F%2Fwww.neatsvor.se%2Fprodukt%2Fneatsvor-x520-robotdammsugare%2F',
    dataProduct: 'Neatsvor X520',
  },
  {
    rank: 6,
    name: 'Neatsvor X500',
    image: '/images/products/neatsvor-x500.webp',
    rating: 4.0,
    badge: 'Billigast',
    pros: ['Lägsta pris', 'Moppfunktion', 'App-styrning', 'Fri frakt'],
    cons: ['Grundläggande navigering', 'Ingen LiDAR, ingen station'],
    ctaText: 'Bra pris hos Neatsvor',
    ctaUrl: 'https://addrevenue.io/t?c=3467327&a=985945&m=SE&u=https%3A%2F%2Fwww.neatsvor.se%2Fprodukt%2Fneatsvor-x500-robotdammsugare-vit%2F',
    dataProduct: 'Neatsvor X500',
  },
];

const faqItems = [
  { question: 'Hur billig kan jag gå utan att ångra mig?', answer: 'Gränsen går där du fortfarande får LiDAR-navigering. Under den blir det gyronavigation eller slumpmässig rörelse, inte värt det.' },
  { question: 'Vad förlorar jag genom att välja budget?', answer: 'Främst tre saker: AI-hinderdetektion (kan smeta ut djuravföring), automatisk tömning (manuellt vart 2 till 4 dygn) och varmvattentvätt av moppar (kan bli mögelluk).' },
  { question: 'Är begagnad ett bra alternativ?', answer: 'Endast om du vet säkert hur många timmar batteriet körts. Litiumjon-batterier förlorar 20 till 30 % kapacitet efter 2 år. Köp original-tillbehör direkt från tillverkaren oavsett.' },
  { question: 'Räcker 5 000 Pa i en lägenhet?', answer: 'Ja, för en normalstor lägenhet med blandade golv och utan stora hundar. På mattor använder roboten boost-läge automatiskt.' },
  { question: 'Vad är vanligaste misstaget när man köper billigt?', answer: 'Att välja bort LiDAR för att hålla nere priset. Utan laserkartläggning kör roboten på gyro och studsar mot möbler, kartan blir grov, ytor missas och du kan inte lägga no-go-zoner i appen. Det är den funktion i budgetklassen som mest avgör om roboten fortsätter användas eller står i garderoben efter ett halvår.' },
  { question: 'Klarar en billig robotdammsugare trösklar mellan rummen?', answer: 'Vanliga trösklar kring 20 mm tar de flesta robotar, men klätterförmågan varierar och anges inte alltid tydligt i budgetklassen, så kontrollera specifikationen för just den modell du väljer. Badrumströsklar är det svåraste, de är ofta både högre och rundade. Mät den högsta tröskeln du vill att roboten ska passera innan du beställer.' },
  { question: 'Går det att moppa och dammsuga i samma pass?', answer: 'Bara om roboten lyfter moppen automatiskt vid matta, annars drar den en fuktig duk rakt över mattan. Alla sex modellerna i listan moppar, men automatisk mopplyft är inte självklart i budgetklassen. Lösningen är att köra mopp och mattrum i separata pass, eller att markera mattrummet som förbjuden zon i appen när moppduken sitter på.' },
  { question: 'Får jag tag på reservdelar till en billig robot?', answer: 'Kontrollera det före köpet, det är inte självklart. Sidoborste, huvudborste, filter och moppduk är förbrukningsdelar på varje robot oavsett pris, och ett filter som inte går att byta gör roboten sämre för varje månad. Välj ett märke som säljer delar till just din modell i Sverige, och håll dig till originaltillbehör. Kopior sitter ofta sämre och släpper förbi finkornigt damm.' },
];

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Bästa budget-robotdammsugare 2026",
  "itemListElement": products.map((p, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": p.name,
    "url": "https://robotjakt.se/robotdammsugare/budget/",
  })),
};
export const articleMeta = {
  title: "Bästa budget-robotdammsugare 2026: jämförda prisval",
  description: "Bästa budget-robotdammsugarna 2026 jämförda. LiDAR och app-styrning till lågt pris. Se topplista med specifikationer, betyg och bästa köp under 3 000 kr.",
  publishDate: "2026-05-15",
  category: "Topplista",
  image: "/images/dreame-d10s-pro.webp",
};

---

<BaseLayout
  title="Bästa budget-robotdammsugare 2026: jämförda prisval"
  description="Bästa budget-robotdammsugarna 2026 jämförda. LiDAR och app-styrning till lågt pris. Se topplista med specifikationer, betyg och bästa köp under 3 000 kr."
  article={{ datePublished: "2026-05-15", dateModified: "2026-07-27", image: "/images/dreame-d10s-pro.webp" }}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6" data-toc-scope>
    <Breadcrumbs items={breadcrumbs} />

    <h1 class="font-heading text-3xl sm:text-4xl font-bold text-text mb-3 leading-tight">
      Billig robotdammsugare 2026, bäst i test
    </h1>
    <AuthorByline datePublished="2026-05-15" dateModified="2026-07-27" />

    <AnswerBox
      question="Snabbt svar: Vilken är den bästa budget-robotdammsugaren 2026?"
      answer="Dreame D20 Ultra är den bästa budget-robotdammsugaren 2026. Den är billigast med en självtömmande station som ingår, och du får både LiDAR-navigering och moppfunktion utan att tumma på navigering eller automatik. Vill du ned i pris är Dreame D20 Plus billigare men saknar station, vilket betyder manuell tömning."
    />

    <MoneyFeatured {...products[0]} />

    <MoneyComparisonTable products={products} title="Jämförelsetabell - budget-robotdammsugare 2026" />

    <p class="text-text-light mb-6 max-w-2xl">
      Dreame D20 Ultra är vår bästa robotdammsugare i budget 2026. Den är billigast med en självtömmande station som ingår, och du får både LiDAR-navigering och moppfunktion. Du behöver alltså inte tumma på navigering eller automatik för att hålla priset nere.
    </p>

    <MoneyTOC />

    <div class="space-y-6 mb-10">
      {products.map((p, i) => (
        <div>
          <h2 class="font-heading text-2xl font-bold text-text mt-8 mb-4">{p.rank ?? i + 1}. {p.name}{p.badge ? `, ${p.badge}` : ''}</h2>
          <ProductCard {...p} />
        </div>
      ))}
    </div>

    <section class="mb-10 bg-bg-alt rounded-xl border border-border p-6">
      <h2 class="font-heading text-xl font-bold text-text mb-3">Vad du absolut inte ska kompromissa på</h2>
      <ul class="list-disc pl-6 text-text-light space-y-2">
        <li>LiDAR-navigering, utan det missar roboten ytor och fastnar oftare. <a href="/guide/lidar-navigation/" class="text-accent underline">Läs varför LiDAR är ett krav</a>.</li>
        <li>Minst 4 000 Pa sugkraft i en lägenhet med hårdgolv.</li>
        <li>App-styrning för att kunna sätta no-go-zoner och scheman.</li>
        <li>Bra varumärkessupport, viktigt vid garanti och firmware-uppdateringar.</li>
      </ul>
    </section>

    <section class="mb-10">
      <h2 class="font-heading text-2xl font-bold text-text mb-5">Köpguide: billig robotdammsugare</h2>

      <h3 class="font-heading text-xl font-semibold text-text mb-3">Vad skiljer LiDAR från enklare navigering?</h3>
      <p class="text-text-light leading-relaxed mb-4">
        LiDAR skickar ut en laserstråle och mäter tiden tillbaka, vilket ger roboten en exakt karta över rummen. Enklare navigering bygger i stället på gyro och studsar mot möbler, kartan blir grov och roboten missar ytor. Utan karta går det heller inte att lägga no-go-zoner i appen.
      </p>
      <p class="text-text-light leading-relaxed mb-4">
        Det är precis skillnaden mellan Neatsvor X600 Pro och X520 i listan, där bara den förra kartlägger med laser. I praktiken märks det på hur lång tid ett pass tar och hur mycket golv som blir kvar bakom stolsben och i rumshörn. En robot utan karta kör tills batteriet tar slut och kan inte tala om vad den faktiskt har städat.
      </p>

      <h3 class="font-heading text-xl font-semibold text-text mb-3">Hur ofta måste du tömma en robot utan station?</h3>
      <p class="text-text-light leading-relaxed mb-4">
        Räkna med manuell tömning vart andra till vart fjärde dygn. Robotens egen dammbehållare är liten, och har du hår eller päls i hemmet fylls den snabbare än så. Missar du tömningen tappar roboten sugkraft långt innan behållaren ser full ut.
      </p>
      <p class="text-text-light leading-relaxed mb-4">
        Frågan är alltså inte om du klarar tömningen, utan om du kommer att göra den. Bara en modell i listan har självtömmande station, och avsaknaden av station är den vanligaste anledningen till att en billig robot slutar användas efter några månader. Ska roboten skötas av någon annan i hushållet är stationen värd merkostnaden, och Dreame D20 Ultra är det billigaste sättet i listan att få den. Vad automatiken gör och var den inte räcker går vi igenom i guiden om <a href="/guide/automatisk-tomning/" class="text-accent underline">automatisk tömning i robotdammsugare</a>.
      </p>

      <h3 class="font-heading text-xl font-semibold text-text mb-3">Klarar en billig robotdammsugare mattor?</h3>
      <p class="text-text-light leading-relaxed mb-4">
        På tunna mattor och trasmattor duger 4 000 till 5 000 Pa, och roboten går automatiskt upp i boostläge när den känner mattkanten. Tjock lugg är gränsen: där räcker budgetsegmentets sugkraft till underhåll mellan städningarna, men inte till den djuprengöring luggen behöver några gånger per år.
      </p>
      <p class="text-text-light leading-relaxed mb-4">
        En sak till att planera för: alla sex modeller moppar, men en fuktig moppduk hör inte hemma på en matta. Saknar modellen automatisk mopplyft kör du antingen mopp och matta i separata pass, eller markerar mattrummet som no-go-zon när moppen sitter på. Hur olika mattyper påverkar resultatet står i guiden om <a href="/guide/robotdammsugare-mattor/" class="text-accent underline">robotdammsugare och mattor</a>.
      </p>

      <h3 class="font-heading text-xl font-semibold text-text mb-3">Vilka förbrukningsdelar behöver du räkna med?</h3>
      <p class="text-text-light leading-relaxed mb-4">
        Sidoborste, huvudborste, filter och moppduk är förbrukningsdelar på varje robot, oavsett pris. Batteriet avgör livslängden: litiumjonceller tappar 20 till 30 procent av kapaciteten efter ett par år, och en robot som inte längre når hela ytan på en laddning blir snabbt irriterande att äga.
      </p>
      <p class="text-text-light leading-relaxed mb-4">
        Kontrollera därför att märket faktiskt säljer delar till just den modell du köper, och att de går att få i Sverige. Ett filter som inte finns att byta gör roboten sämre för varje månad som går. Köp originaltillbehör direkt från tillverkaren, kopior sitter ofta inte tätt och släpper förbi finkornigt damm i stället för att fånga det.
      </p>
    </section>

    <FAQ items={faqItems} />

    <section class="mt-10 p-5 bg-bg-alt rounded-xl border border-border">
      <h2 class="font-heading text-lg font-bold text-text mb-3">Relaterade guider</h2>
      <ul class="space-y-2">
        <li><a href="/billigaste-robotdammsugare/" class="text-accent underline text-sm">Allra billigaste robotdammsugare 2026</a></li>
        <li><a href="/guide/sugkraft/" class="text-accent underline text-sm">Sugkraft i Pa förklarat</a></li>
        <li><a href="/guide/lidar-navigation/" class="text-accent underline text-sm">LiDAR-navigation</a></li>
        <li><a href="/robotdammsugare/husdjur/" class="text-accent underline text-sm">Bäst för husdjur</a></li>
        <li><a href="/robotdammsugare/med-mopp/" class="text-accent underline text-sm">Bäst med mopp</a></li>
      </ul>
    </section>


    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  </div>

  <StickyCTA
    text={products[0].ctaText}
    url={products[0].ctaUrl}
    productName={products[0].name}
  />
</BaseLayout>
