---
import ArticleLayout from '../layouts/ArticleLayout.astro';
import FAQ from '../components/FAQ.astro';
import StickyCTA from '../components/StickyCTA.astro';
import AnswerBox from '../components/AnswerBox.astro';

const breadcrumbs = [
  { label: 'Robotgräsklippare', href: '/robotgrasklippare/' },
  { label: 'Budget', href: '/billigaste-robotgrasklippare/' },
  { label: 'Husqvarna Automower 105' },
];

const specs = [
  { label: 'Klippyta', value: '600 m²' },
  { label: 'Klippbredd', value: '18 cm' },
  { label: 'Lutningstolerans', value: '40%' },
  { label: 'Bullernivå', value: '58 dB' },
  { label: 'Navigering', value: 'Slinga (perimeterkabel)' },
  { label: 'Laddtid', value: '50 min' },
  { label: 'Drifttid', value: '70 min' },
  { label: 'Vikt', value: '7,7 kg' },
  ];

const faqItems = [
  {
    question: 'Kan Husqvarna Automower 105 användas utan app?',
    answer: 'Ja, Husqvarna Automower 105 har ingen app och inget WiFi, allt sköts direkt på roboten via knapparna och displayen. Du ställer in klippschema, klipphöjd och starttider direkt på enheten. Det är faktiskt en fördel för den som vill ha enkelhet: ingen gateway, ingen registrering, inget krångel med nätverk. Installera, ställ in schema, sen sköter den sig.',
  },
  {
    question: 'Hur bra är 40% lutningstolerans i praktiken?',
    answer: 'Husqvarna Automower 105:s 40%-lutningstolerans är bättre än de flesta budgetkonkurrenter som stannar på 25 till 35%. Det innebär att roboten klarar relativt branta sluttningar utan att tappa grepp eller tippa. 40% lutning motsvarar ungefär 22 graders lutning, vilket täcker de flesta normala villaträdgårdar. Har du en extremt brant backe kan du behöva 430X Nera (45%), men för en normal tomt räcker 105an.',
  },
  {
    question: 'Hur lång tid tar installationen av Automower 105?',
    answer: 'För en trädgård på 300 till 600 m² tar installationen normalt 3 till 5 timmar som DIY-projekt. Du drar perimeterkabeln runt gräsytans kant och fäster den med markspikar. Kabeln kan läggas ovanpå gräset, den sjunker ner av sig självt efter några veckor, eller grävs ner 2 till 3 cm om du föredrar det. Husqvarna levererar med allt material och tydliga instruktioner. Mer komplex trädgård med ön och smalpassager tar längre tid.',
  },
  {
    question: 'Vad är skillnaden mellan Husqvarna Automower 105 och 315X?',
    answer: 'Automower 105 är Husqvarnas budgetmodell utan GPS, app eller avancerad navigering. Den klarar upp till 600 m² och . Automower 315X är mellanklassmodellen med GPS+3G, Automower Connect-appen, klarar 1 600 m² och . Välj 105an om du har en enkel trädgård under 600 m² och inte behöver fjärrstyrning. Välj 315X om du vill ha app-kontroll, GPS-navigering och kapacitet för en större tomt.',
  },
  {
    question: 'Har Husqvarna Automower 105 stöldskydd?',
    answer: 'Ja, men bara det mekaniska. Roboten kräver PIN-kod för att starta, lyftsensorn stänger av knivarna direkt om någon lyfter den och tippsensorn stannar den om den välter. Däremot finns varken GPS-spårning eller larm till mobilen, eftersom modellen saknar både app och mobiluppkoppling. Är spårning viktigt för dig får du gå upp till en modell med GPS, exempelvis Automower 315X.',
  },
  {
    question: 'Hur länge klipper Automower 105 innan den måste ladda?',
    answer: 'Cirka 70 minuter per pass, sedan laddar den i ungefär 50 minuter innan nästa runda. Roboten kör alltså flera pass per dygn och håller på så sätt en yta på upp till 600 m² jämn. Klippbredden är 18 cm och klipphöjden ställs mellan 20 och 50 mm. Schema och starttider sätter du på robotens display, ingen app behövs.',
  },
  {
    question: 'Vad har ersatt Husqvarna Automower 105?',
    answer: 'Automower Aspire R6V, Husqvarnas slinglösa instegsmodell. 105:an har utgått ur nyförsäljningen och hittas numera på restlager eller begagnat. Den praktiska skillnaden ligger i installationen: 105:an kräver perimeterkabel runt hela gräsytan medan efterträdaren klarar sig utan slinga. Har du redan kabeln nedgrävd är det ett argument för att stanna kvar i kabeltekniken.',
  },
  {
    question: 'Kan Automower 105 stå ute över vintern?',
    answer: 'Nej, ta in roboten när klippsäsongen är slut. Kyla och fukt sliter på både batteri och kontakter, och en robot som blir stående ute hela vintern startar ofta trögt på våren. Rengör chassit och klippaggregatet från gräsrester, torka av kontaktblecken, ladda batteriet och ställ undan roboten frostfritt. Laddstationen kan sitta kvar ute.',
  },
];

const faqSchema = faqItems.map((item) => ({
  "@type": "Question",
  "name": item.question,
  "acceptedAnswer": {
    "@type": "Answer",
    "text": item.answer,
  },
}));
export const articleMeta = {
  title: "Husqvarna Automower 105 recension 2026: enkel modell",
  description: "Husqvarna Automower 105 testad: enkel robotgräsklippare för trädgårdar upp till 600 m². Se prestanda, installation med slinga och pris i Sverige.",
  publishDate: "2026-05-16",
  category: "Recension",
  image: "/images/husqvarna-automower-105.webp",
};

---

<ArticleLayout
  title="Husqvarna Automower 105 recension 2026: enkel modell"
  description="Husqvarna Automower 105 testad: enkel robotgräsklippare för trädgårdar upp till 600 m². Se prestanda, installation med slinga och pris i Sverige."
  breadcrumbs={breadcrumbs}
  ogImage="/images/husqvarna-automower-105.webp"
  lastUpdated="2026-07-27"
  datePublished="2026-04-23"
>
  <div class="bg-amber-50 border border-amber-300 rounded-xl p-4 mb-6">
    <p class="text-sm text-amber-800 font-semibold mb-1">Denna modell har utgått ur Husqvarnas sortiment.</p>
    <p class="text-sm text-amber-700">Husqvarna Automower 105 ar ersatt av <a href="/robotgrasklippare/" target="_blank" class="underline font-medium">Automower Aspire R6V</a>. Recensionen nedan gäller den utgångna modellen.</p>
  </div>

  <h1 class="font-heading text-3xl sm:text-4xl font-bold text-text mb-4 leading-tight">
    Husqvarna Automower 105, Recension 2026
  </h1>

  <AnswerBox
    question="Snabbt svar: är Husqvarna Automower 105 värd att köpa 2026?"
    answer="Modellen har utgått ur Husqvarnas sortiment, så köper du den blir det på restlager eller begagnat. Tekniken håller fortfarande: 40 procents lutningstolerans, 600 m² kapacitet och Husqvarnas servicenät. Men du får varken app, WiFi eller GPS, och Husqvarnas egen efterträdare är den slinglösa Aspire R6V."
  />

  <!-- Verdict box -->
  <div class="bg-winner/5 border border-winner/20 rounded-xl p-5 mb-8">
    <div class="flex items-start gap-4">
      <div class="flex-1">
        <div class="flex items-center gap-3 mb-2">
          <span class="bg-winner text-white text-xs font-bold px-2 py-1 rounded">BÄST BUDGET HUSQVARNA</span>
          <div class="flex gap-0.5" aria-label="Betyg: 8.0 av 10">
            {[1,2,3,4].map(i => (
              <svg class="w-4 h-4 text-winner" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
            <svg class="w-4 h-4 text-border" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          </div>
          <span class="font-bold text-text">8,0 / 10</span>
        </div>
        <p class="text-text-light text-sm leading-relaxed mb-3">
          Husqvarna Automower 105 är den enklaste och billigaste modellen i Husqvarnas sortiment, och den levererar Husqvarnas välkända tillförlitlighet . Ingen app, ingen GPS, men 40% lutningstolerans, 600 m² kapacitet och Husqvarnas servicenätverk i ryggen. </p>
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <div>
            <p class="text-xs text-text-light">Pris kan variera, jämför alltid</p>
          </div>
          <a
            href="https://go.adt284.net/t/t?a=1870484630&as=2063681412&t=2&tk=1"
            rel="nofollow sponsored noopener"
            target="_blank"
            class="inline-flex items-center justify-center bg-cta hover:bg-cta-dark text-white font-semibold px-6 py-3 rounded-lg transition-colors text-sm min-h-[44px]"
          >
            Bra pris hos Proshop
            <svg class="w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
          </a>
          
        </div>
      </div>
    </div>
  </div>

  <!-- Pros/Cons -->
  <div class="grid sm:grid-cols-2 gap-5 mb-8">
    <div class="bg-white rounded-xl border border-border p-5">
      <h2 class="font-semibold text-text mb-3">Fördelar med Husqvarna Automower 105</h2>
      <ul class="space-y-2">
        {[
          'Husqvarnas tillförlitlighet till budgetpris',
          '40% lutningstolerans, bäst i klassen',
          '600 m², mer yta än Gardena Sileno City 500',
          '70 min drifttid per laddning',
          'Bra servicenätverk i Sverige',
          'Enkel utan krångel, ingen app att konfigurera',
        ].map(pro => (
          <li class="flex items-start gap-2 text-sm text-text-light">
            <span class="text-winner font-bold flex-shrink-0 mt-0.5">+</span>
            {pro}
          </li>
        ))}
      </ul>
    </div>
    <div class="bg-white rounded-xl border border-border p-5">
      <h2 class="font-semibold text-text mb-3">Nackdelar med Husqvarna Automower 105</h2>
      <ul class="space-y-2">
        {[
          'Ingen app eller WiFi-kontroll',
          'Ingen GPS-navigering',
          'Perimeterkabel krävs',
          'Dyrare än Gardena Sileno City 500',
        ].map(con => (
          <li class="flex items-start gap-2 text-sm text-text-light">
            <span class="text-cta font-bold flex-shrink-0 mt-0.5">-</span>
            {con}
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Specs table -->
  <section class="mb-10">
    <h2 class="font-heading text-2xl font-bold text-text mb-4">Tekniska specifikationer Husqvarna Automower 105</h2>
    <div class="bg-bg-alt rounded-xl border border-border overflow-hidden mb-6">
      <table class="cmp-table table-fixed w-full text-sm">
        <tbody class="divide-y divide-border">
          {specs.map((spec, i) => (
            <tr class={i % 2 === 0 ? 'bg-white' : ''}>
              <td class="px-4 py-3 font-medium text-text w-1/2">{spec.label}</td>
              <td class="px-4 py-3 text-text-light">{spec.value}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Detailed review sections -->
  <section class="mb-10">
    <h2 class="font-heading text-2xl font-bold text-text mb-6">Husqvarna Automower 105 i korthet: klippresultat och upplevelse</h2>

    <h3 class="font-heading text-xl font-semibold text-text mb-3">Enklaste Husqvarna-modellen, vad du får och vad som saknas</h3>
    <p class="text-text-light leading-relaxed mb-4">
      Husqvarna Automower 105 är avskalad på ett genomtänkt sätt. Det finns ingen app, ingen WiFi-koppling och ingen GPS. Allt styrs via enhetens knappar och display. Du ställer in klippschema (dag och tid), klipphöjd och eventuella PIN-kodskrav direkt på roboten. Det är allt som krävs, sedan sköter den sig. </p>
    <p class="text-text-light leading-relaxed mb-6">
      Vad du får i stället är Husqvarnas byggkvalitet, ett robust nav- och hjulsystem och tillgång till Husqvarnas servicenätverk i hela Sverige. Reservdelar finns i lager, auktoriserade verkstäder finns i varje större stad och produkten är byggd för att hålla i många säsonger. Det är ett tydligt värdeerbjudande mot billigare märkeslösa alternativ. </p>

    <h3 class="font-heading text-xl font-semibold text-text mb-3">Klippresultat, 40% lutning är bättre än konkurrenterna</h3>
    <p class="text-text-light leading-relaxed mb-4">
      Automower 105 klipper med 18 cm bredd i slumpmässiga mönster och täcker ytor upp till 600 m². Klipphöjden ställs in i intervall från 20 till 50 mm. Resultatet är ett tätt och jämnt gräs, samma princip som i resten av Automower-serien. </p>
    <p class="text-text-light leading-relaxed mb-6">
      Lutningstoleransens 40% sticker ut i budgetklassen. Gardena Sileno City 500 och de flesta konkurrenter stannar på 35%. Det innebär att Automower 105 klarar brantare sluttningar utan att stanna eller tappa grepp, en konkret fördel för tomter med nivåskillnader. För en plan trädgård spelar detta ingen roll, men har du en backe är det ett starkt argument för 105an. </p>

    <h3 class="font-heading text-xl font-semibold text-text mb-3">Installation, standard perimeterkabel</h3>
    <p class="text-text-light leading-relaxed mb-4">
      Installationen följer Husqvarnas standard: perimeterkabel dras längs gräsytans kant och fästs med medföljande markspikar. Kabeln ansluts till laddstationen som placeras vid ett fast underlag med tillgång till eluttag. Husqvarna levererar med installations-kit och tydlig steg-för-steg-guide. </p>
    <p class="text-text-light leading-relaxed mb-6">
      För en trädgård på 300 till 600 m² tar installationen 3 till 5 timmar som DIY-projekt. Har du en mer komplex trädgård med ön, blomrabatter och smalpassager räkna med mer tid. Professionell installation via Husqvarnas auktoriserade återförsäljare kostar normalt och är ett alternativ om du vill ha det gjort snabbt och korrekt. </p>

    <h3 class="font-heading text-xl font-semibold text-text mb-3">Säkerhet, PIN-kod, lyftsensor och tippsensor</h3>
    <p class="text-text-light leading-relaxed mb-4">
      Automower 105 inkluderar Husqvarnas kompletta säkerhetspaket: PIN-kod krävs för att starta roboten, lyftsensor stänger av knivarna omedelbart om enheten lyfts, och tippsensorn stannar roboten vid välvning. Dessa funktioner är branschstandard för Husqvarna och finns i hela Automower-serien. </p>
    <p class="text-text-light leading-relaxed mb-6">
      Utan app finns inget stöldlarm via mobilnotis, ett medvetet avkall för den enkla prisklassen. För de flesta hem räcker PIN-koden som tillräckligt avskräckande skydd. Husqvarnas stöldregistreringssystem täcker inte 105an på samma sätt som GPS-modellerna, vilket är värt att känna till om stöldskydd är en prioritet. </p>

    <h3 class="font-heading text-xl font-semibold text-text mb-3">Är det värt att köpa en utgången Automower 105 begagnat?</h3>
    <p class="text-text-light leading-relaxed mb-4">
      Det kan vara en bra affär, men batteriet avgör. Ett litiumbatteri tappar kapacitet med åren, och en robot som knappt hinner runt ett pass innan den måste ladda kostar snart mer i ny batterisats än vad prisskillnaden mot en ny modell var. Fråga alltid hur många säsonger enheten gått.
    </p>
    <p class="text-text-light leading-relaxed mb-6">
      Kontrollera fyra saker vid ett begagnatköp. Att laddstationen, transformatorn och kabelskarvarna finns med, eftersom en komplett installationssats separat blir en märkbar del av budgeten. Att PIN-koden är återställd eller känd av säljaren. Att hjulmotorernas drev inte glappar när du snurrar hjulen för hand. Och att chassit inte har sprickor efter kollisioner med sten. Går allt igenom är 105an en robust maskin, den är byggd runt samma mekanik som resten av Automower-serien och slitdelarna är utbytbara.
    </p>

    <h3 class="font-heading text-xl font-semibold text-text mb-3">Finns det reservdelar till Automower 105?</h3>
    <p class="text-text-light leading-relaxed mb-4">
      Ja, de delar som slits mest är också de som är enklast att få tag på: knivblad, batteri, hjul och kabelskarvar. Att modellen utgått ur nyförsäljningen betyder inte att den blir omöjlig att hålla i drift, men kontrollera alltid modellbeteckningen mot delen innan du beställer.
    </p>
    <p class="text-text-light leading-relaxed mb-6">
      Utgå aldrig från att ett blad som passar en annan Automower-generation passar 105an. Knivfäste och bladtjocklek varierar mellan serier, och ett blad som sitter med minsta glapp ger obalans som vandrar vidare till klippmotorns lager. Samma sak gäller batteri, där både kontaktdon och kapslingens mått skiljer sig. Vi har listat delarna per modell i vår översikt över <a href="/reservdelar/knivar/" class="text-accent underline">reservknivar till robotgräsklippare</a>.
    </p>

    <h3 class="font-heading text-xl font-semibold text-text mb-3">Ska du välja slinga eller slinglöst i dag?</h3>
    <p class="text-text-light leading-relaxed mb-4">
      Slingan är förutsägbar men fast, slinglöst är flexibelt men beroende av sikt. Med perimeterkabel vet roboten alltid exakt var gränsen går, oavsett träd och husväggar. Med virtuella gränser slipper du kabelgrävet och kan flytta gränsen i appen, men navigeringen vill ha relativt fri himmel.
    </p>
    <p class="text-text-light leading-relaxed mb-6">
      Det gör valet till en fråga om din tomt, inte om vilken teknik som är nyare. En kringbyggd villaträdgård med höga häckar, stora lövträd och smala passager är fortfarande hemmaplan för en kabelrobot som 105an. En öppen gräsmatta där du gärna ändrar rabatter och möblering mellan säsongerna vinner mer på en slinglös. Har du redan kabeln i marken är den ett argument för att stanna i samma teknik nästa gång också. Vi går igenom skillnaderna i praktiken i vår topplista över <a href="/robotgrasklippare-utan-slinga/" class="text-accent underline">robotgräsklippare utan slinga</a>.
    </p>
  </section>

  <!-- Comparison with 315X -->
  <section class="mb-10 bg-bg-alt rounded-xl border border-border p-6">
    <h2 class="font-heading text-xl font-bold text-text mb-3">Jämförelse mot Husqvarna 315X, när räcker 105an?</h2>
    <div class="spec-table-wrap">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-border">
            <th class="text-left py-2 pr-4 font-semibold text-text">Egenskap</th>
            <th class="text-left py-2 pr-4 font-semibold text-text">Automower 105</th>
            <th class="text-left py-2 font-semibold text-text">Automower 315X</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border text-text-light">
          <tr>
            <td class="py-2 pr-4 font-medium text-text">Max yta</td>
            <td data-col="Automower 105" class="py-2 pr-4">600 m²</td>
            <td data-col="Automower 315X" class="py-2">1 600 m²</td>
          </tr>
          <tr>
            <td class="py-2 pr-4 font-medium text-text">Navigering</td>
            <td data-col="Automower 105" class="py-2 pr-4">Slinga</td>
            <td data-col="Automower 315X" class="py-2">GPS + 3G</td>
          </tr>
          <tr>
            <td class="py-2 pr-4 font-medium text-text">App</td>
            <td data-col="Automower 105" class="py-2 pr-4">Nej</td>
            <td data-col="Automower 315X" class="py-2">Automower Connect</td>
          </tr>
          <tr>
            <td class="py-2 pr-4 font-medium text-text">Lutning</td>
            <td data-col="Automower 105" class="py-2 pr-4">40%</td>
            <td data-col="Automower 315X" class="py-2">40%</td>
          </tr>
          <tr>
            <td class="py-2 pr-4 font-medium text-text">Pris</td>
            <td data-col="Automower 105" class="py-2 pr-4 text-winner font-semibold"></td>
            <td data-col="Automower 315X" class="py-2"></td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="text-text-light text-sm mt-4">
      Välj 105an om din trädgård är under 600 m² och du inte behöver app-kontroll eller GPS. Välj 315X om du vill ha fjärrstyrning, GPS-navigering eller en trädgård på 600 till 1 600 m². Lutningstoleransens är identisk, det är yta, app och pris som skiljer. </p>
    <p class="text-sm mt-3">
      <a href="/husqvarna-automower-315x/" class="text-accent underline font-medium">Läs vår recension av Husqvarna Automower 315X</a>
    </p>
  </section>

  <!-- För whom -->
  <section class="mb-10 bg-bg-alt rounded-xl border border-border p-6">
    <h2 class="font-heading text-xl font-bold text-text mb-3">Vem passar Husqvarna Automower 105 för?</h2>
    <p class="text-text-light leading-relaxed mb-3">
      Automower 105 passar dig som vill ha ett pålitligt och välbyggt märke utan att betala för GPS och app-funktioner. Det är rätt val för en villa- eller radhustomt upp till 600 m² med enkel till måttlig form, och där du inte har behov av att styra roboten från mobilen. </p>
    <p class="text-text-light leading-relaxed">
      Har du en brant tomt är 40%-lutningen ett starkt argument. Vill du ha den trygghet som Husqvarnas servicenät ger, och föredrar att betala lite mer för ett etablerat märke framför en okänd budgetmodell, är Automower 105 det naturliga valet i sin prisklass. </p>
  </section>

  <!-- Internal links -->
  <section class="mb-10 bg-white rounded-xl border border-border p-5">
    <h2 class="font-heading text-lg font-bold text-text mb-3">Relaterade guider</h2>
    <ul class="space-y-2">
      <li>
