---
/**
 * Startsidan är ett NAV, inte en topplista.
 *
 * Kannibaliseringsfix 2026-07-27: H1:n löd tidigare "Bästa robotdammsugare
 * 2026: 15 modeller rankade" och slogs mot /robotdammsugare/ på exakt samma
 * köpsökord, samtidigt som siten jämför fyra robotkategorier. Startsidan
 * beskriver nu bredden och skickar vidare; varje kategorisida äger sin egen
 * köpterm. Ingen enskild kommersiell term ligger kvar i startsidans H1.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import EditorProfile from '../components/EditorProfile.astro';
import HubTop3 from '../components/HubTop3.astro';
import { HUB, HUB_TOTAL } from '../data/hub-top3';

const introPerKategori: Record<string, string> = {
  robotdammsugare: `De tre högst rankade av ${HUB[0].total} robotdammsugare vi jämför, valda på sugkraft, navigering och hur moppen faktiskt sköter sig.`,
  robotgrasklippare: `De tre högst rankade av ${HUB[1].total} robotgräsklippare. Kabelfri navigering och lutningsförmåga väger tyngst.`,
  poolrobot: `De tre högst rankade av ${HUB[2].total} poolrobotar, bedömda på sugteknik, filterkapacitet och om de klarar väggarna.`,
  dronare: `De tre högst rankade av ${HUB[3].total} drönare, där kamera, flygtid och vilken regelklass drönaren hamnar i avgör.`,
};

// Fler ingångar än de fyra rankade kategorierna. Egna sidor, ingen egen topp 3.
const merKategorier = [
  { href: '/fonsterputsrobot/', namn: 'Fönsterputsrobot', lede: 'Sugkraft mot glas, täckningsgrad och hur roboten beter sig vid kanter.' },
  { href: '/reservdelar/', namn: 'Reservdelar', lede: 'Filter, borstar och knivar till Roborock, Dreame, Ecovacs och Husqvarna.' },
  { href: '/guide/', namn: 'Guider', lede: 'Installation, sugkraft, LiDAR, underhåll och vinterförvaring, förklarat.' },
  { href: '/jamfor/', namn: 'Jämförelser', lede: 'Modell mot modell och märke mot märke, med en tydlig slutsats per par.' },
];

const guideLankar = [
  { label: 'Köpguide robotdammsugare', href: '/kopguide-robotdammsugare/' },
  { label: 'Köpguide robotgräsklippare', href: '/guide/robotgrasklippare-koparguide/' },
  { label: 'Köpguide poolrobot', href: '/kopguide-poolrobot/' },
  { label: 'Sugkraft i Pa, vad behöver du?', href: '/guide/sugkraft/' },
  { label: 'LiDAR-navigering förklarad', href: '/guide/lidar-navigation/' },
  { label: 'Installation steg för steg', href: '/guide/installation/' },
  { label: 'Underhåll av robotdammsugare', href: '/guide/underhall/' },
  { label: 'Vinterförvaring av robotgräsklippare', href: '/guide/vinterforvaring-robotgrasklippare/' },
  { label: 'Robotdammsugare och mattor', href: '/guide/robotdammsugare-mattor/' },
];

const allMods = import.meta.glob('./**/*.astro', { eager: true })
type ArtMeta = { title: string; description: string; publishDate: string; category: string; image: string }
const senasteRecensioner = Object.entries(allMods)
  .filter(([path, mod]) => path !== './index.astro' && !path.endsWith('/index.astro') && !!(mod as any).articleMeta)
  .map(([path, mod]) => {
    const meta = (mod as any).articleMeta as ArtMeta
    const href = '/' + path.replace(/^\.\//, '').replace(/\.astro$/, '/')
    const image = meta.image || '/images/cat-robotdammsugare.webp'
    return { ...meta, image, href }
  })
  .sort((a, b) => b.publishDate.localeCompare(a.publishDate))
  .slice(0, 6)

function fmtDate(d: string) {
  return new Date(d + 'T12:00:00').toLocaleDateString('sv-SE', { year: 'numeric', month: 'long', day: 'numeric' })
}

// Hubb-nivå-frågor: vilken robottyp, inte vilken modell. Modellfrågorna hör
// hemma på respektive topplista, annars konkurrerar sidorna om samma queries.
const faqItems = [
  {
    question: 'Vilken typ av robot ska man köpa först?',
    answer: 'Räkna på tiden du faktiskt lägger. Dammsugning sker året runt, så en robotdammsugare betalar sig snabbast för de flesta hushåll. Har du stor tomt och lägger timmar i veckan på gräset vänds kalkylen, och då är robotgräsklipparen det självklara förstaköpet.',
  },
  {
    question: 'Hur jämför Robotjakt robotarna?',
    answer: 'Vi väger samman tekniska specifikationer från tillverkarna, oberoende tester och recensioner samt aktuella priser hos svenska butiker. Varje kategori rankas på de kriterier som faktiskt skiljer bra från dåligt just där, och vi skriver alltid ut nackdelarna.',
  },
  {
    question: 'Köper ni in och testar robotarna själva?',
    answer: 'Delvis. Redaktören kör två robotdammsugare dagligen hemma, en Dreame X50 Ultra och en äldre Roborock S5 Max, och den erfarenheten ligger bakom vad vi lägger vikt vid. Men vi köper inte in och labbtestar varje modell vi jämför. För övriga robotar går vi igenom verifierbar data: specifikationer, oberoende tester, långtidsrecensioner och priser. Hela arbetssättet är beskrivet öppet på sidan om hur vi jämför.',
  },
  {
    question: 'Är kabelfri robotgräsklippare värt merpriset?',
    answer: 'Oftast ja, om trädgården är krokig eller har flera ytor. Du slipper gräva ner slinga och kan ändra klippzonerna i appen efteråt. På en enkel rektangulär gräsmatta gör en kabelbaserad modell samma jobb för mindre pengar.',
  },
  {
    question: 'Behöver en robotdammsugare basstation?',
    answer: 'Basstationen är det du betalar mest för, och den som gör att du slipper göra jobbet själv. Med självtömning räcker det att byta påse ungefär varannan månad. Utan station tömmer du behållaren efter varje körning.',
  },
  {
    question: 'Hur ofta uppdaterar ni topplistorna?',
    answer: 'Löpande. Vi kontrollerar att produkterna finns kvar hos butikerna, byter ut modeller som utgått och lägger in nya när de börjar säljas i Sverige. Varje sida visar datumet för den senaste kontrollen.',
  },
  {
    question: 'Klarar en robotgräsklippare svensk vinter?',
    answer: 'Roboten ska in. Frost och fukt skadar både elektronik och batteri, så den förvaras torrt och frostfritt, oftast från oktober eller november. Förvara batteriet på 60 till 80 procent laddning i stället för fullt, eftersom litiumjonceller åldras snabbast vid full laddning under lång tid. Laddstationen får stå kvar ute om du drar ur nätadaptern, och begränsningskabeln i marken tål frost orörd.',
  },
  {
    question: 'Fungerar robotdammsugare på mattor?',
    answer: 'Ja, upp till en viss tjocklek. De flesta premiummodeller klarar mattor upp till omkring 20 mm och höjer sugkraften automatiskt när de känner av matta. Långhårig flokati är gränsfallet, där kan borstvalsen fastna. Har roboten mopp bör den ha automatiskt mattlyft, annars drar den en fuktig mopp rakt över mattan.',
  },
  {
    question: 'Vilka regler gäller för drönare i Sverige?',
    answer: 'Två krav blandas ofta ihop. Drönarkortet, alltså A1/A3-kompetensbeviset, krävs från 250 gram och uppåt men inte för C0-modeller under den gränsen. Operatörsregistrering hos Transportstyrelsen krävs däremot så snart drönaren har kamera eller annan sensor som kan lagra personuppgifter, vilket gäller även Mini-modeller under 250 gram. Registreringen kostar 190 kr plus 250 kr per år.',
  },
];
---

<BaseLayout
  title="Robotjakt: vi jämför och rankar robotar för hem och trädgård"
  description={`Robotjakt jämför ${HUB_TOTAL} robotar i fyra kategorier: robotdammsugare, robotgräsklippare, poolrobotar och drönare. Oberoende rankning med nackdelarna utskrivna.`}
>
  <link slot="head" rel="preload" as="image" href="/images/hero-robotjakt-2.webp" type="image/webp" fetchpriority="high" media="(min-width: 768px)" />
  <link slot="head" rel="preload" as="image" href="/images/hero-robotjakt-2-mobil.webp" type="image/webp" fetchpriority="high" media="(max-width: 767px)" />

  <!-- Hero: foto + riktad mörkzon. Mobil ankrar texten i botten där
       gradienten är tätast, desktop lägger mörkzonen till vänster. -->
  <section class="relative overflow-hidden min-h-[420px] md:min-h-[500px] flex items-end md:items-center">
    <picture>
      <source media="(min-width: 768px)" srcset="/images/hero-robotjakt-2.webp" width="1672" height="941" />
      <img
        src="/images/hero-robotjakt-2-mobil.webp"
        alt="Robotdammsugare med LiDAR-torn städar ett ekgolv i ett vardagsrum i skymningsljus"
        class="absolute inset-0 w-full h-full object-cover object-[62%_center] md:object-[70%_center]"
        loading="eager"
        fetchpriority="high"
        width="1000"
        height="941"
      />
    </picture>
    <div class="absolute inset-0 bg-gradient-to-t from-primary-dark/92 via-primary-dark/62 via-40% to-primary-dark/10 md:bg-gradient-to-r md:from-primary-dark/92 md:via-primary-dark/55 md:via-52% md:to-primary-dark/5" aria-hidden="true"></div>

    <div class="relative w-full max-w-6xl mx-auto px-4 pb-10 pt-24 md:py-16">
      <div class="max-w-xl">
        <h1 class="font-heading text-3xl md:text-[2.6rem] font-extrabold leading-tight mb-4 text-white">
          <span class="block">Vi jämför och rankar</span>
          <span class="rullord-rad"><span class="rullord" data-ord='["robotdammsugare","robotgräsklippare","poolrobotar","drönare"]'>robotdammsugare</span><span class="rullord-markor" aria-hidden="true"></span></span>
        </h1>
        <p class="text-base md:text-lg text-white/85 max-w-md leading-relaxed">
          {HUB_TOTAL} robotar i fyra kategorier, rankade på sugkraft, navigering och räckvidd. Oberoende av tillverkarna, och alltid med nackdelarna utskrivna.
        </p>
      </div>
    </div>
  </section>

  <!-- Kategoriband: de fyra ingångarna direkt under heron -->
  <section class="bg-white border-b border-border" aria-labelledby="kategorier-heading">
    <div class="max-w-6xl mx-auto px-4 py-10 md:py-12">
      <h2 id="kategorier-heading" class="font-heading text-xl md:text-2xl font-bold text-text mb-6">Hitta din robot</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-5">
        {HUB.map((kat) => (
          <a href={kat.href} class="group flex flex-col bg-white rounded-xl border border-border hover:border-accent transition-colors overflow-hidden">
            <span class="relative block w-full aspect-[4/3] bg-gray-50 border-b border-border">
              <span class="absolute top-2.5 left-2.5 z-10 inline-flex bg-primary text-white text-[11px] font-bold rounded-full px-2 py-0.5">{kat.total} modeller</span>
              <img src={kat.bild} alt={`${kat.namn}: ${kat.items[0].name}`} loading="eager" decoding="async" width="320" height="240" class="absolute inset-0 w-full h-full object-contain p-3" />
            </span>
            <span class="flex flex-col flex-1 p-3.5 md:p-4">
              <span class="block font-heading text-base md:text-lg font-bold text-text group-hover:text-accent-dark transition-colors">{kat.namn}</span>
              <span class="block text-xs text-text-light leading-relaxed mt-1">{kat.kriterier}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var el = document.querySelector('.rullord');
      if (!el) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var ord;
      try { ord = JSON.parse(el.getAttribute('data-ord')); } catch (e) { return; }
      if (!ord || ord.length < 2) return;
      var i = 0, SUDD = 45, SKRIV = 70, PAUS_FULL = 2400, PAUS_TOM = 320;
      function sudda() {
        var t = el.textContent;
        if (t.length === 0) { i = (i + 1) % ord.length; setTimeout(skriv, PAUS_TOM); return; }
        el.textContent = t.slice(0, -1);
        setTimeout(sudda, SUDD);
      }
      function skriv() {
        var mal = ord[i], n = el.textContent.length;
        if (n >= mal.length) { setTimeout(sudda, PAUS_FULL); return; }
        el.textContent = mal.slice(0, n + 1);
        setTimeout(skriv, SKRIV);
      }
      setTimeout(sudda, PAUS_FULL);
    })();
  </script>

  <!-- Topp 3 per kategori: bredden här, djupet på kategorisidan -->
  {HUB.map((kat, i) => (
    <HubTop3
      kategori={kat}
      intro={introPerKategori[kat.id]}
      ton={i % 2 === 0 ? 'papper' : 'vit'}
      eager={i === 0}
    />
  ))}

  <EditorProfile />

  <!-- Fler ingångar -->
  <section class="max-w-6xl mx-auto px-4 py-10 md:py-12" aria-labelledby="mer-heading">
    <h2 id="mer-heading" class="font-heading text-2xl md:text-3xl font-bold text-text mb-6">Mer på Robotjakt</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {merKategorier.map((kat) => (
        <a href={kat.href} class="group bg-white rounded-xl border border-border p-5 hover:border-accent transition-colors">
          <h3 class="font-heading font-bold text-text group-hover:text-accent-dark transition-colors mb-1">{kat.namn}</h3>
          <p class="text-sm text-text-light leading-relaxed">{kat.lede}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Senaste artiklar -->
  {senasteRecensioner.length > 0 && (
    <section class="bg-white border-y border-border" aria-labelledby="senaste-heading">
      <div class="max-w-6xl mx-auto px-4 py-10 md:py-12">
        <h2 id="senaste-heading" class="font-heading text-2xl md:text-3xl font-bold text-text mb-6">Senast publicerat</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {senasteRecensioner.map((art) => (
            <article class="group bg-white border border-border rounded-xl overflow-hidden hover:border-accent transition-colors">
              <a href={art.href} class="block aspect-[16/9] overflow-hidden bg-bg-alt" tabindex="-1" aria-hidden="true">
                <img src={art.image} alt="" class="w-full h-full object-cover" loading="lazy" width="480" height="270" />
              </a>
              <div class="p-5">
                <div class="flex items-center gap-2 mb-2">
                  <span class="text-xs font-bold text-accent-dark">{art.category}</span>
                  <span class="text-text-light">·</span>
                  <time datetime={art.publishDate} class="text-xs text-text-light">{fmtDate(art.publishDate)}</time>
                </div>
                <h3 class="font-heading font-bold text-text leading-snug mb-2">
                  <a href={art.href} class="hover:text-accent-dark transition-colors">{art.title}</a>
                </h3>
                <p class="text-sm text-text-light leading-relaxed">{art.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Guider -->
  <section class="max-w-6xl mx-auto px-4 py-10 md:py-12" aria-labelledby="guider-heading">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 mb-2">
      <h2 id="guider-heading" class="font-heading text-2xl md:text-3xl font-bold text-text">Alla våra robotguider</h2>
      <a href="/guide/" class="text-sm font-semibold text-accent-dark hover:text-accent underline underline-offset-2">Se guidebiblioteket</a>
    </div>
    <p class="text-text-light mb-6 max-w-2xl leading-relaxed">Tekniken bakom robotarna, förklarad utan säljsnack. Läs innan du väljer modell.</p>
    <nav aria-label="Guider" class="flex flex-wrap gap-2">
      {guideLankar.map((g) => (
        <a href={g.href} class="inline-flex items-center bg-white border border-border text-text text-sm font-semibold px-3.5 py-2 rounded-lg hover:border-accent hover:text-accent-dark transition-colors">
          {g.label}
        </a>
      ))}
    </nav>
  </section>

  <!-- Hubb-långform: binder ihop kategorierna och förklarar upplägget -->
  <section class="bg-white border-t border-border">
    <div class="max-w-3xl mx-auto px-4 py-14">
      <div class="seo-prose">
        <h2 id="hela-guiden">{HUB_TOTAL} robotar i fyra kategorier: så hänger guiden ihop</h2>
        <p>
          Robotjakt jämför {HUB_TOTAL} robotar fördelade på fyra kategorier: {HUB[0].total} robotdammsugare,
          {' '}{HUB[1].total} robotgräsklippare, {HUB[2].total} poolrobotar och {HUB[3].total} drönare. Varje kategori
          har en egen topplista där modellerna rankas med samma metod. Startsidan är navet: här väljer du
          kategori, och i topplistan görs själva jämförelsen, modell för modell.
        </p>
        <p>
          Inomhus handlar det mest om <a href="/robotdammsugare/">robotdammsugare</a>, där Dreame och Roborock
          driver utvecklingen och sugkraft, navigering och moppfunktion avgör rankningen. Vi bryter ut de
          vanligaste behoven i egna listor: <a href="/robotdammsugare/husdjur/">robotdammsugare för husdjur</a>,
          {' '}<a href="/robotdammsugare/med-mopp/">modeller med moppfunktion</a> och
          {' '}<a href="/robotdammsugare-under-5000/">robotdammsugare under 5 000 kr</a>.
        </p>
        <p>
          Utomhus är <a href="/robotgrasklippare/">robotgräsklippare</a> den kategori som förändrats mest, sedan
          kabelfri GPS-navigering slog igenom brett. Husqvarna, Segway Navimow, Mammotion och Dreame konkurrerar
          nu på samma villkor, och vi delar upp listan efter det som faktiskt begränsar dig:
          {' '}<a href="/robotgrasklippare-utan-slinga/">modeller utan slinga</a>,
          {' '}<a href="/robotgrasklippare-for-lutning/">robotgräsklippare för brant lutning</a> och
          {' '}<a href="/robotgrasklippare-stor-tradgard/">stora trädgårdar</a>.
        </p>
        <p>
          <a href="/poolrobot/">Poolrobotarna</a> är en säsongskategori där Zodiac och Planet Pool dominerar det
          svenska utbudet, och skillnaden ligger i om roboten klarar väggarna eller bara botten.
          {' '}<a href="/dronare/">Drönarna</a> är DJI-dominerade, och där är 250-gramsgränsen viktigare än
          kameran: under den vikten gäller enklare regler. <a href="/fonsterputsrobot/">Fönsterputsrobotar</a> har
          en egen sida men ingen rankad topplista, det svenska utbudet är för tunt för det.
        </p>

        <h2 id="valj-ratt-robottyp">Så väljer du rätt robottyp</h2>
        <p>
          Välj robotdammsugare om du vill slippa ett återkommande inomhusjobb året runt. Välj robotgräsklippare
          om gräsklippningen äter helger under halva året. Poolroboten är för dig som redan har poolen och tröttnat
          på att håva. Drönaren är den enda kategorin som inte tar bort ett hushållsarbete, den köper du för
          bildernas skull.
        </p>
        <p>
          Gränsfallen är där de flesta fastnar. Har du både husdjur och mycket mattor blir sugkraft och
          borsttyp viktigare än moppfunktionen, och då är
          {' '}<a href="/robotdammsugare/husdjur/">robotdammsugare för husdjur</a> rätt ingång. Har du kuperad tomt
          spelar arealsiffran mindre roll än lutningsförmågan, vilket
          {' '}<a href="/robotgrasklippare-for-lutning/">robotgräsklippare för lutning</a> går igenom modell för modell.
        </p>

        <h2 id="vad-kostar-det">Vad kostar det?</h2>
        <p>
          Prisbilden skiljer sig kraftigt mellan kategorierna, men mönstret är detsamma: det du betalar extra för
          är sällan högre toppsiffror utan bättre navigering, en station som sköter sig själv och ett servicenät
          som finns kvar om fem år. En robot vars reservdelar slutat tillverkas är svår att rädda.
        </p>
        <p>
          Vill du hitta golvet i varje kategori finns budgetlistorna:
          {' '}<a href="/billigaste-robotdammsugare/">billigaste robotdammsugarna</a>,
          {' '}<a href="/robotgrasklippare-under-5000/">robotgräsklippare under 5 000 kr</a>,
          {' '}<a href="/billigaste-poolrobot/">billigaste poolroboten</a> och
          {' '}<a href="/billigaste-fonsterputsrobot/">billigaste fönsterputsroboten</a>. Där syns tydligt vad som
          faller bort först när priset pressas: stationen, navigeringen och garantin.
        </p>

        <h2 id="samma-metod">Samma metod i alla kategorier</h2>
        <p>
          Varje kategori rankas på kriterier anpassade efter vad som skiljer bra från dåligt just där:
          sugkraft och borsttyp för dammsugare, lutning och navigering för gräsklippare, filterkapacitet för
          poolrobotar, regelklass för drönare. Vi köper inte in varje robot vi rankar utan väger samman
          tillverkarnas specifikationer, oberoende tester och priser hos svenska butiker. Ingen tillverkare kan
          betala för placering, och hela arbetssättet är beskrivet i
          {' '}<a href="/sa-testar-vi/">metoden bakom betygen</a>.
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <FAQ items={faqItems} />
  </div>

</BaseLayout>
