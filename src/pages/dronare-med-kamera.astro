---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import FAQ from '../components/FAQ.astro';
import StickyCTA from '../components/StickyCTA.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AuthorByline from '../components/AuthorByline.astro';
import AnswerBox from '../components/AnswerBox.astro';
import MoneyFeatured from '../components/MoneyFeatured.astro';
import MoneyComparisonTable from '../components/MoneyComparisonTable.astro';
import MoneyTOC from '../components/MoneyTOC.astro';

const products = [
  {
    rank: 1,
    name: 'DJI Air 3S',
    image: '/images/dji-air-3s.webp',
    rating: 4.8,
    badge: 'Bäst kamera 2026',
    pros: [
      'Dubbla kameror, 1-tums vidvinkel + 70 mm tele',
      '4K HDR, 14 steg dynamiskt omfång',
      '45 min flygtid, längst i klassen',
      '42 GB internlagring',
      'Nightscape hinderdetektering, säker i mörker',
    ],
    cons: [
      '724 g, C1-klass, kräver drönarkort A1/A3',
      'Högt pris',
    ],
    ctaText: 'Bra pris hos Dronarbutiken',
    ctaUrl: 'https://addrevenue.io/t?c=3467327&a=987736&m=SE&u=https%3A%2F%2Fdronarbutiken.se%2Fproducts%2Fdji-air-3s-dji-rc-n3',
    dataProduct: 'DJI Air 3S',
    reviewUrl: '/dji-air-3s/',
  },
  {
    rank: 2,
    name: 'DJI Mini 5 Pro',
    image: '/images/dji-mini-5-pro.webp',
    rating: 4.7,
    badge: 'Bäst kamera under 250 g',
    pros: [
      '1-tums sensor, 50 MP och 4K/120 fps',
      'Under 250 g, C0-klass, enklare regler',
      'Omnidirektionell hinderdetektering',
      'Bästa kameran i Mini-serien',
    ],
    cons: [
      'Ingen telekamera',
      'Ny modell, begränsad testdata',
    ],
    ctaText: 'Bra pris hos Kjell',
    ctaUrl: 'https://ion.kjell.com/t/t?a=1487384319&as=2063681412&t=2&tk=1&cupa_sku=57972&url=https://www.kjell.com/se/produkter/hem-fritid/fritid/dronare/dji-dronare/dji-mini-5-pro-hopfallbar-dronare-med-50-mp-kamera-p57972',
    dataProduct: 'DJI Mini 5 Pro',
    reviewUrl: '/dji-mini-5-pro/',
  },
  {
    rank: 3,
    name: 'DJI Mini 4 Pro',
    image: '/images/dji-mini-4-pro.webp',
    rating: 4.5,
    badge: 'Prisvärd 4K',
    pros: [
      'Bra 4K/60fps-kamera',
      'Under 250 g, inget drönarkort krävs',
      'Hinderdetektering åt alla håll',
    ],
    cons: [
      'Äldre sensor än Mini 5 Pro',
      'Ny modell gör den lite daterad',
    ],
    ctaText: 'Bra pris hos Kjell',
    ctaUrl: 'https://ion.kjell.com/t/t?a=1487384319&as=2063681412&t=2&tk=1&cupa_sku=57765&url=https://www.kjell.com/se/produkter/hem-fritid/fritid/dronare/dji-dronare/dji-mini-4-pro-fly-more-combo-p57765',
    dataProduct: 'DJI Mini 4 Pro',
  },
];

const faqItems = [
  {
    question: 'Vilken drönare ger bäst bildkvalitet 2026?',
    answer: 'DJI Air 3S ger den bästa bildkvaliteten av konsumentdrönarna 2026. Den kombinerar en 1-tums vidvinkelkamera (50 MP) med en 70 mm telekamera (48 MP), filmar i 4K HDR med 14 steg dynamiskt omfång och har 42 GB internlagring. Vill du ha bästa kamera under 250 g, välj DJI Mini 5 Pro med sin 1-tums sensor.',
  },
  {
    question: 'Vad är skillnaden på 1-tums och 1/1.3-tums sensor i drönare?',
    answer: 'En 1-tums sensor är fysiskt större och samlar in mer ljus, vilket ger bättre bilder i dåligt ljus, mer naturlig bakgrundsoskärpa (bokeh) och bättre dynamiskt omfång. DJI Air 3S och Mini 5 Pro har 1-tums sensorer. Mini 4 Pro har en 1/1.3-tums sensor som är bra men inte lika stark i svårt ljus.',
  },
  {
    question: 'Behöver man drönarkort för att filma med drönare i Sverige?',
    answer: 'Det beror på drönarens vikt. Drönare under 250 g som DJI Mini 5 Pro kräver inget drönarkort för hobbyflygning. DJI Air 3S på 724 g kräver A1/A3-kompetensbevis. Operatörsregistrering hos Transportstyrelsen krävs dock för varje drönare med kamera, alltså även de under 250 g, och det gäller oavsett om du filmar för nöjes skull. Kommersiell användning (betalt uppdrag) kräver normalt mer dokumentation oavsett vikt.',
  },
];

const faqSchema = faqItems.map((item) => ({
  "@type": "Question",
  "name": item.question,
  "acceptedAnswer": { "@type": "Answer", "text": item.answer },
}));

const breadcrumbs = [
  { label: 'Drönare', href: '/dronare/' },
  { label: 'Med kamera' },
];

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Bästa drönare med kamera 2026",
  "itemListElement": products.map((p, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": p.name,
    "url": "https://robotjakt.se/dronare-med-kamera/",
  })),
};
export const articleMeta = {
  title: "Bästa drönare med kamera 2026: jämförda och rankade",
  description: "Vi jämför de bästa kameradrönarna 2026. DJI Mini 4 Pro, Air 3 och fler jämförs på bildkvalitet, flygtid och pris. Hitta rätt kameradrönare för dina behov.",
  publishDate: "2026-03-15",
  category: "Topplista",
  image: "/images/dji-air-3s.webp",
};

---

<BaseLayout
  title="Bästa drönare med kamera 2026: jämförda och rankade"
  description="Vi jämför de bästa kameradrönarna 2026. DJI Mini 4 Pro, Air 3 och fler jämförs på bildkvalitet, flygtid och pris. Hitta rätt kameradrönare för dina behov."
  ogImage="/images/dji-air-3s.webp"
  article={{ datePublished: "2026-03-15", dateModified: "2026-07-27", image: "/images/dji-air-3s.webp" }}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6" data-toc-scope>
    <Breadcrumbs items={breadcrumbs} />
    <h1 class="font-heading text-3xl sm:text-4xl font-bold text-text mb-4 leading-tight mt-2">
      Bästa Drönare med Kamera 2026
    </h1>
    <AuthorByline datePublished="2026-03-15" dateModified="2026-07-27" />

    <AnswerBox
      question="Snabbt svar: Vilken drönare med kamera är bäst 2026?"
      answer="DJI Air 3S är vår bästa drönare med kamera 2026. Den har dubbla kameror med 1-tums vidvinkel och 70 mm tele, filmar 4K HDR med 14 steg dynamiskt omfång och flyger 45 minuter. Behöver du hålla dig under 250 g är DJI Mini 5 Pro bäst."
    />

    <MoneyFeatured {...products[0]} />

    <MoneyComparisonTable products={products} title="Jämförelsetabell - bästa drönare med kamera 2026" />

    <MoneyTOC />

    <section class="mb-10">
      <h2 class="font-heading text-2xl font-bold text-text mb-4">Bästa drönare med kamera 2026</h2>
      <p class="text-text-light leading-relaxed mb-6">
        Alla moderna DJI-drönare har bra kameror, men skillnaden i sensorstorlek och kameradesign är stor. En 1-tums sensor ger märkbar skillnad i bildkvalitet jämfört med mindre sensorer, framförallt i varierande ljus och för video med HDR.
      </p>
      <div class="space-y-6">
        {products.map((p, i) => (
          <div>
            <h2 class="font-heading text-2xl font-bold text-text mt-8 mb-4">{p.rank ?? i + 1}. {p.name}{p.badge ? `, ${p.badge}` : ''}</h2>
            <ProductCard {...p} />
          </div>
        ))}
      </div>
    </section>

    <section class="mb-10">
      <h2 class="font-heading text-2xl font-bold text-text mb-4">Vad ska du tänka på när du väljer kameradrönare?</h2>

      <h3 class="font-heading text-xl font-semibold text-text mb-3">Sensorstorlek</h3>
      <p class="text-text-light leading-relaxed mb-4">
        Sensorstorlek är den viktigaste faktorn för bildkvalitet. 1-tums sensor (DJI Air 3S, DJI Mini 5 Pro) ger klart bättre resultat i dåligt ljus och mer naturlig bakgrundsoskärpa. 1/1.3-tums (DJI Mini 4 Pro) är bra men märkbart svagare när ljuset sviktar.
      </p>

      <h3 class="font-heading text-xl font-semibold text-text mb-3">En eller två kameror?</h3>
      <p class="text-text-light leading-relaxed mb-4">
        DJI Air 3S har dubbla kameror, vidvinkel och 70 mm tele. Det låter dig variera berättandet utan att flyga om tagningen. DJI Mini 5 Pro och Mini 4 Pro har bara vidvinkelkamera men kompenserar med hög bildkvalitet till lägre pris och vikt.
      </p>

      <h3 class="font-heading text-xl font-semibold text-text mb-3">Video vs foto</h3>
      <p class="text-text-light leading-relaxed mb-4">
        Prioriterar du video framför stillbilder, välj DJI Air 3S för dess HDR, dynamiskt omfång och möjlighet att filma i D-Log M för färggradering i post. Vill du primärt ta luftbilder till sociala medier räcker DJI Mini 5 Pro mer än väl.
      </p>

      <h3 class="font-heading text-xl font-semibold text-text mb-3">Vad betyder dynamiskt omfång i praktiken?</h3>
      <p class="text-text-light leading-relaxed mb-4">
        Dynamiskt omfång är hur stor skillnad i ljus kameran kan behålla detaljer i samtidigt. Med 14 steg, som DJI Air 3S levererar i 4K HDR, kan du ha både ljus himmel och skuggig skog i samma bild utan att himlen blir vit eller skogen svart.
      </p>
      <p class="text-text-light leading-relaxed mb-4">
        Det märks tydligast vid soluppgång och solnedgång, alltså när flygbilder brukar bli som bäst. En kamera med snävare omfång tvingar dig att välja mellan korrekt himmel och korrekt mark, och det valet syns i den färdiga filmen.
      </p>
      <p class="text-text-light leading-relaxed mb-6">
        Sensorstorleken hänger ihop med det här. En 1-tums sensor i DJI Air 3S och DJI Mini 5 Pro samlar mer ljus per bildpunkt än 1/1.3-tums sensorn i DJI Mini 4 Pro, vilket ger mer marginal i både skuggor och högdagrar.
      </p>

      <h3 class="font-heading text-xl font-semibold text-text mb-3">Behöver du filma i D-Log M?</h3>
      <p class="text-text-light leading-relaxed mb-4">
        Bara om du tänker färgsätta materialet efteråt. D-Log M spelar in en platt, urtvättad bild som behåller maximal information för färggradering i redigeringsprogrammet. Klipper du direkt utan efterarbete ser det platta materialet bara trist ut, då är standardprofilen ett bättre och snabbare val.
      </p>
      <p class="text-text-light leading-relaxed mb-6">
        DJI Air 3S är den modell i listan som tjänar mest på ett riktigt redigeringsflöde. Filmar du till sociala medier och vill ha klippet klart samma kväll finns det ingen anledning att göra det svårare för dig. Hur modellen presterar i detalj går vi igenom i vår <a href="/dji-air-3s/" class="text-accent underline">DJI Air 3S recension</a>.
      </p>

      <h3 class="font-heading text-xl font-semibold text-text mb-3">Hur mycket betyder flygtiden när du filmar?</h3>
      <p class="text-text-light leading-relaxed mb-4">
        Mer än du tror. Flygtiden avgör hur många tagningar du får ur ett batteri och hur lugnt du kan komponera. DJI Air 3S ligger på 45 minuter och är längst i klassen, vilket i praktiken betyder att du hinner leta upp rätt vinkel i stället för att skynda hem.
      </p>
      <p class="text-text-light leading-relaxed mb-4">
        Räkna alltid med mindre än den angivna siffran. Vind, kyla och mycket hovrande drar batteri snabbare, och du vill landa med marginal kvar. En längre grundflygtid ger dig helt enkelt större felmarginal.
      </p>
      <p class="text-text-light leading-relaxed mb-4">
        Ska du filma på en plats du inte kan komma tillbaka till väger flygtid och extra batterier tyngre än en sista procent bildkvalitet. Är låg vikt viktigare för dig hittar du fler alternativ i vår guide till <a href="/dronare-for-nyborjare/" class="text-accent underline">bästa drönare för nybörjare</a>.
      </p>
    </section>

    <section class="mb-10 bg-bg-alt rounded-xl border border-border p-5">
      <h2 class="font-heading text-lg font-bold text-text mb-3">Fler drönare-guider</h2>
      <ul class="space-y-2 text-sm">
        <li><a href="/dronare/" class="text-accent underline">Bästa drönaren 2026, komplett topplista</a></li>
        <li><a href="/dronare-for-nyborjare/" class="text-accent underline">Bästa drönare för nybörjare</a></li>
        <li><a href="/dji-air-3s/" class="text-accent underline">DJI Air 3S fullständig recension</a></li>
        <li><a href="/dji-mini-5-pro/" class="text-accent underline">DJI Mini 5 Pro fullständig recension</a></li>
      </ul>
    </section>

    <FAQ items={faqItems} />


    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  </div>

  <StickyCTA
    text={products[0].ctaText}
    url={products[0].ctaUrl}
    productName={products[0].name}
  />
</BaseLayout>
