// Antal produkter räknas vid build ur ProductCard-korten (name-prop) plus
// startsidans och hubbarnas produktarrayer, aldrig hårdkodat.
const pageSources = import.meta.glob('../pages/**/*.astro', { query: '?raw', import: 'default', eager: true });
const produktNamn = new Set<string>();
for (const src of Object.values(pageSources) as string[]) {
  for (const m of src.matchAll(/<ProductCard[\s\S]{0,400}?name="([^"]+)"/g)) {
    produktNamn.add(m[1].toLowerCase().trim());
  }
  for (const m of src.matchAll(/rank:\s*\d+,?\s*\n\s*name:\s*'([^']+)'/g)) {
    produktNamn.add(m[1].toLowerCase().trim());
  }
}
const antalProdukter = Math.floor(produktNamn.size / 10) * 10;

const uspItems = [
  ...(antalProdukter >= 10 ? [`${antalProdukter}+ robotar jämförda`] : []),
  'Oberoende recensioner',
  'Uppdaterat 2026',
];
---

<!-- E-E-A-T-rad: icke-sticky, scrollar bort och äter inte above the fold -->
<div class="hidden md:block bg-primary-dark text-white/80 text-xs font-semibold">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-9 flex items-center justify-between gap-4">
    <div class="flex items-center gap-6">
      {uspItems.map((item) => (
        <span class="flex items-center gap-1.5">
          <svg class="w-3 h-3 flex-shrink-0 text-accent-light" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          {item}
        </span>
      ))}
    </div>
    <div class="flex items-center gap-5">
      <a href="/sa-testar-vi/" class="hover:text-white transition-colors">Så testar vi</a>
      <a href="/om-redaktionen/" class="hover:text-white transition-colors">Om redaktionen</a>
    </div>
  </div>
</div>

<header class="sticky top-0 z-50">
  <!-- Mörk grafit-nav -->
  <div class="bg-primary text-white border-b border-primary-light relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <a href="/" class="flex items-center hover:opacity-90 transition-opacity flex-shrink-0">
          <img src="/images/logo.svg" alt="Robotjakt.se" class="h-9 md:h-10 w-auto flex-shrink-0" width="268" height="40" />
        </a>

        <!-- Desktop nav: fyra mega-grupper -->
        <nav class="hidden lg:flex items-center gap-0.5" aria-label="Huvudnavigering">
          {megaGroups.map((grupp) => (
            <div class="group">
              <a
                href={grupp.href}
                class="relative flex items-center gap-1 px-3 py-2 text-sm font-semibold text-gray-200 hover:text-white transition-colors whitespace-nowrap"
                aria-haspopup="true"
              >
                {grupp.label}
                <svg class="w-3.5 h-3.5 opacity-60 transition-transform duration-200 group-hover:rotate-180 motion-reduce:transition-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                </svg>
                <span class="absolute left-3 right-3 -bottom-px h-0.5 bg-accent-light scale-x-0 group-hover:scale-x-100 group-focus-within:scale-x-100 origin-left transition-transform duration-200 motion-reduce:transition-none" aria-hidden="true"></span>
              </a>
              <!-- Mega-panel: full bredd under naven, innehållet slutar vid innehållsbredden -->
              <!-- before: osynlig hover-brygga över gapet mellan knapp och panel -->
              <div class="absolute left-0 right-0 top-full pt-2 hidden group-hover:block group-focus-within:block z-50 before:content-[''] before:absolute before:left-0 before:right-0 before:-top-4 before:h-4">
                <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
                  <div class="bg-white text-text shadow-xl rounded-lg overflow-hidden">
                    <div class="grid grid-cols-12">
                      <div class={`col-span-12 ${grupp.featured ? 'lg:col-span-9' : ''} grid grid-cols-3 gap-x-8 gap-y-6 p-7`}>
                        {grupp.columns.map((col) => (
                          <div>
                            {col.href ? (
                              <a href={col.href} class="block text-xs font-semibold uppercase tracking-wider text-text-light mb-2.5 pb-2 border-b border-border hover:text-accent transition-colors">
                                {col.title}
                              </a>
                            ) : (
                              <p class="text-xs font-semibold uppercase tracking-wider text-text-light mb-2.5 pb-2 border-b border-border">
                                {col.title}
                              </p>
                            )}
                            <ul class="space-y-0.5">
                              {col.items.map((item) => (
                                <li>
                                  <a href={item.href} class="block py-1 text-sm text-text-light hover:text-accent-dark transition-colors">
                                    {item.label}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        ))}
                      </div>
                      {grupp.featured && (
                        <aside class="hidden lg:block lg:col-span-3 bg-bg border-l border-border p-6">
                          <p class="text-xs font-semibold uppercase tracking-wider text-accent-dark mb-3">Bäst i test</p>
                          {grupp.featured.image && (
                            <a href={grupp.featured.href} tabindex="-1" aria-hidden="true" class="block bg-white border border-border rounded-lg mb-3 aspect-square">
                              <img src={grupp.featured.image} alt="" loading="lazy" width="200" height="200" class="w-full h-full object-contain p-3" />
                            </a>
                          )}
                          {grupp.featured.brand && (
                            <p class="text-xs font-semibold uppercase tracking-wider text-text-light mb-0.5">{grupp.featured.brand}</p>
                          )}
                          <p class="font-heading font-bold text-text leading-snug mb-1.5">
                            <a href={grupp.featured.href} class="hover:text-accent transition-colors">{grupp.featured.name}</a>
                          </p>
                          <p class="text-[13px] text-text-light leading-relaxed mb-4">{grupp.featured.blurb}</p>
                          <a href={grupp.featured.href} class="inline-flex w-full items-center justify-center bg-cta hover:bg-cta-dark text-white text-sm font-semibold px-4 py-2.5 rounded-md transition-colors">
                            {grupp.featured.cta}
                          </a>
                        </aside>
                      )}
                    </div>
                    <div class="px-7 py-3 bg-bg-alt border-t border-border">
                      <p class="text-[13px] text-text-light">{grupp.trust}</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </nav>

        <!-- Mobile menu button -->
        <button id="mobile-menu-btn" class="lg:hidden p-2.5 rounded-md hover:bg-primary-light transition-colors min-w-[44px] min-h-[44px] flex items-center justify-center" aria-label="Öppna meny" aria-expanded="false" aria-controls="mobile-menu">
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobilmeny: fullskärm ner till botten, accordion per grupp -->
  <nav id="mobile-menu" class="hidden lg:hidden fixed left-0 right-0 bottom-0 z-40 bg-primary-dark border-t border-primary-light overflow-y-auto overscroll-contain" style="top: var(--header-height, 0px);" aria-label="Mobilnavigering">
    <div class="px-4 py-2 divide-y divide-primary-light/40">
      {megaGroups.map((grupp) => (
        <div class="mobile-section">
          <button class="mobile-toggle w-full flex items-center justify-between px-2 py-4 text-sm font-semibold text-gray-100 hover:text-white" aria-expanded="false">
            <span>{grupp.label}</span>
            <svg class="toggle-chevron w-4 h-4 opacity-60 transition-transform duration-200 motion-reduce:transition-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="mobile-dropdown hidden pb-2">
            {grupp.columns.map((col) => (
              <div class="mb-2">
                {col.href ? (
                  <a href={col.href} class="block text-xs font-semibold uppercase tracking-wider text-accent-light mt-2 mb-1 px-3">{col.title}</a>
                ) : (
                  <p class="text-xs font-semibold uppercase tracking-wider text-accent-light mt-2 mb-1 px-3">{col.title}</p>
                )}
                {col.items.map((item) => (
                  <a href={item.href} class="block px-4 py-2.5 text-sm text-gray-300 hover:text-white hover:bg-primary-light rounded-md transition-colors">
                    {item.label}
                  </a>
                ))}
              </div>
            ))}
          </div>
        </div>
      ))}
      <div class="py-2">
        <a href="/sa-testar-vi/" class="block px-2 py-3 text-sm font-semibold text-gray-400 hover:text-white transition-colors">Så testar vi</a>
        <a href="/om-redaktionen/" class="block px-2 py-3 text-sm font-semibold text-gray-400 hover:text-white transition-colors">Om redaktionen</a>
        <a href="/kontakt/" class="block px-2 py-3 text-sm font-semibold text-gray-400 hover:text-white transition-colors">Kontakt</a>
      </div>
    </div>
  </nav>
  <!-- Backdrop: stänger menyn vid klick utanför -->
  <div id="mobile-backdrop" class="hidden fixed inset-0 z-30" aria-hidden="true"></div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const backdrop = document.getElementById('mobile-backdrop');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  function openMenu() {
    const headerEl = document.querySelector('header');
    const h = headerEl ? headerEl.getBoundingClientRect().bottom : 0;
    (menu as HTMLElement).style.top = h + 'px';
    menu?.classList.remove('hidden');
    backdrop?.classList.remove('hidden');
    btn?.setAttribute('aria-expanded', 'true');
    iconOpen?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }
  function closeMenu() {
    menu?.classList.add('hidden');
    backdrop?.classList.add('hidden');
    btn?.setAttribute('aria-expanded', 'false');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    document.body.style.overflow = '';
    document.querySelectorAll('.mobile-dropdown').forEach((c) => c.classList.add('hidden'));
    document.querySelectorAll('.toggle-chevron').forEach((i) => i.classList.remove('rotate-180'));
    document.querySelectorAll('.mobile-toggle').forEach((b) => b.setAttribute('aria-expanded', 'false'));
  }

  btn?.addEventListener('click', () => {
    menu?.classList.contains('hidden') ? openMenu() : closeMenu();
  });

  backdrop?.addEventListener('click', closeMenu);

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.querySelectorAll('.mobile-toggle').forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const section = toggle.closest('.mobile-section');
      const dropdown = section?.querySelector('.mobile-dropdown');
      const chevron = toggle.querySelector('.toggle-chevron');
      const isOpen = !dropdown?.classList.contains('hidden');
      dropdown?.classList.toggle('hidden', isOpen);
      chevron?.classList.toggle('rotate-180', !isOpen);
      toggle.setAttribute('aria-expanded', String(!isOpen));
    });
  });
</script>
