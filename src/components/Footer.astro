---
// Footer 2.0 (2026-07-27): kompakt och kurerad. Mega-menyn bär de djupa
// länkarna sitewide, footern håller kategorier, populära topplistor och
// redaktionellt. Affiliate-disclosure ligger HÄR och bara här (hård regel),
// max två rader, låg emfas.
const kategorier = [
  { label: 'Robotgräsklippare bäst i test', href: '/robotgrasklippare/' },
  { label: 'Robotdammsugare bäst i test', href: '/robotdammsugare/' },
  { label: 'Bästa poolroboten', href: '/poolrobot/' },
  { label: 'Fönsterputsrobot', href: '/fonsterputsrobot/' },
  { label: 'Bästa drönaren', href: '/dronare/' },
  { label: 'Reservdelar', href: '/reservdelar/' },
];

const popularaGuider = [
  { label: 'Mammotion vs Segway Navimow', href: '/mammotion-vs-segway-navimow/' },
  { label: 'Husqvarna vs Mammotion', href: '/husqvarna-vs-mammotion/' },
  { label: 'Robotgräsklippare för brant lutning', href: '/robotgrasklippare-for-lutning/' },
  { label: 'Robotgräsklippare utan slinga', href: '/robotgrasklippare-utan-slinga/' },
  { label: 'Robotdammsugare för husdjur', href: '/robotdammsugare/husdjur/' },
  { label: 'Roborock vs Dreame', href: '/roborock-vs-dreame/' },
  { label: 'Köpguide robotdammsugare', href: '/kopguide-robotdammsugare/' },
  { label: 'Köpguide robotgräsklippare', href: '/guide/robotgrasklippare-koparguide/' },
];

const omRobotjakt = [
  { label: 'Om Robotjakt', href: '/om-oss/' },
  { label: 'Om redaktionen', href: '/om-redaktionen/' },
  { label: 'Så testar vi', href: '/sa-testar-vi/' },
  { label: 'Redaktionell policy', href: '/redaktionell-policy/' },
  { label: 'Kontakt', href: '/kontakt/' },
  { label: 'Integritetspolicy', href: '/integritetspolicy/' },
];
---

<footer class="bg-primary text-gray-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4 lg:grid-cols-[2fr_1fr_1.3fr_1fr]">
      <div class="col-span-2 md:col-span-4 lg:col-span-1 lg:pr-8">
        <a href="/" class="inline-block mb-4">
          <img src="/images/logo-v2.svg" alt="Robotjakt.se" class="h-8 w-auto" width="215" height="32" loading="lazy" />
        </a>
        <p class="text-sm leading-relaxed text-gray-400">
          Robotjakt jämför konsumentrobotar för den svenska marknaden: robotdammsugare, robotgräsklippare, poolrobotar och drönare. Oberoende recensioner med nackdelarna utskrivna.
        </p>
      </div>
      <div>
        <p class="font-heading text-white text-sm font-bold uppercase tracking-wider mb-4">Kategorier</p>
        <ul class="space-y-2.5">
          {kategorier.map((item) => (
            <li>
              <a href={item.href} class="text-sm hover:text-white transition-colors">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="font-heading text-white text-sm font-bold uppercase tracking-wider mb-4">Populära jämförelser</p>
        <ul class="space-y-2.5">
          {popularaGuider.map((item) => (
            <li>
              <a href={item.href} class="text-sm hover:text-white transition-colors">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="font-heading text-white text-sm font-bold uppercase tracking-wider mb-4">Redaktionellt</p>
        <ul class="space-y-2.5">
          {omRobotjakt.map((item) => (
            <li>
              <a href={item.href} class="text-sm hover:text-white transition-colors">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="mt-12 pt-8 border-t border-primary-light">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-3">
        <p class="text-sm text-gray-400">
          &copy; 2026 Robotjakt.se. Alla rättigheter förbehållna.
        </p>
        <p class="text-xs text-gray-400 md:text-right md:max-w-md">
          Robotjakt.se innehåller affiliatelänkar.
        </p>
      </div>
      <p class="mt-4 text-xs text-gray-400">
        ELS Catalyst AB &middot; Org.nr 559583-6163 &middot; <!--email_off--><a href="mailto:info@robotjakt.se" class="hover:text-gray-200 transition-colors">info@robotjakt.se</a><!--/email_off-->
      </p>
    </div>
  </div>
</footer>
