---
/**
 * Slim redaktionell byline (money page-mallen): redaktionsnamn (länkad) ·
 * publiceringsdatum · "Uppdaterad [datum]" · lästid, allt på en rad.
 * Ingen undertitel, ingen separat "Publicerad:"-rad. Organization JSON-LD
 * för E-E-A-T. Lästid beräknas client-side från artikelns text.
 */
interface Props {
  author?: string;
  authorTitle?: string;
  authorBio?: string;
  authorImage?: string;
  authorHref?: string;
  authorType?: 'Organization' | 'Person';
  datePublished?: string;
  dateModified?: string;
  /** true när bylinen ligger på ett mörkt band (grafit-hero). */
  light?: boolean;
}

const {
  author = 'Axel Jönemyr',
  authorTitle = 'Grundare och redaktör, Robotjakt',
  authorBio = 'Axel kör två robotdammsugare dagligen hemma och jämför robotdammsugare och robotgräsklippare utifrån navigering, sugkraft, räckvidd och pris.',
  authorImage = '/images/axel-jonemyr-robot.webp',
  authorHref = '/om-redaktionen/',
  authorType = 'Person',
  datePublished,
  dateModified,
  light = false,
} = Astro.props;

const formatDate = (dateStr: string) => {
  const d = new Date(dateStr);
  return d.toLocaleDateString('sv-SE', { day: 'numeric', month: 'long', year: 'numeric' });
};

const showPublished = !!datePublished;
const showUpdated = !!dateModified && dateModified !== datePublished;

const wrapCls = light
  ? 'flex items-start gap-2.5 py-2 mb-4 border-b border-white/15'
  : 'flex items-start gap-2.5 py-2 mb-4 border-b border-border';
const nameCls = light
  ? 'block text-[13px] font-semibold text-white hover:text-accent-light transition-colors leading-tight'
  : 'block text-[13px] font-semibold text-text hover:text-accent transition-colors leading-tight';
const metaCls = light
  ? 'flex flex-wrap items-center gap-x-3 gap-y-0.5 text-xs text-white/70 mt-0.5'
  : 'flex flex-wrap items-center gap-x-3 gap-y-0.5 text-xs text-text-light mt-0.5';
const ringCls = light ? 'ring-white/25' : 'ring-border';
---

<!--
  Byline-layout portad från bebisguidens fix 2026-07-26 (verifierad på riktig
  iPhone 14): fristående "·"-separatorer mellan namn/datum/lästid i EN
  flex-wrap-rad kunde hamna ensamma i radens start eller slut när raden bröt
  på smal skärm. Nu ligger namnet på egen rad och metadata i en egen rad
  under, utan separatorer. Avståndet gör jobbet i stället.
-->
<div class={wrapCls}>
  <a href={authorHref} aria-label={`Om ${author}`} class="shrink-0">
    {authorImage ? (
      <img src={authorImage} alt={author} width="32" height="32" loading="lazy" class={`w-8 h-8 rounded-full object-cover ring-1 ${ringCls}`} />
    ) : (
      <span class="flex items-center justify-center w-8 h-8 rounded-full bg-accent/10 text-accent" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-4.5 h-4.5"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M9 9.75h6M9 12h6m-6 2.25h3"/></svg>
      </span>
    )}
  </a>
  <div class="min-w-0">
    <a href={authorHref} class={nameCls}>{author}</a>
    <div class={metaCls}>
      {showPublished && (<time datetime={datePublished} class="whitespace-nowrap">{formatDate(datePublished!)}</time>)}
      {showUpdated && (<span class="whitespace-nowrap">Uppdaterad <time datetime={dateModified}>{formatDate(dateModified!)}</time></span>)}
      <span class="inline-flex items-center gap-1 whitespace-nowrap">
        <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span id="article-reading-time">Beräknar lästid...</span>
      </span>
    </div>
  </div>
</div>

<script>
  (() => {
    const el = document.getElementById('article-reading-time');
    if (!el) return;
    const scope = document.querySelector('[data-toc-scope]') || document.querySelector('main') || document.body;
    const text = (scope as HTMLElement)?.innerText || '';
    const words = text.trim().split(/\s+/).filter(Boolean).length;
    const min = Math.max(1, Math.round(words / 200));
    el.textContent = `${min} min läsning`;
  })();
</script>

{/* Ingen egen Person/Organization JSON-LD här: BaseLayout emitterar redan hela
    entitetsgrafen (Organization -> WebSite -> Person, @id https://robotjakt.se/#axel)
    på varje sida. En egen kopia här skulle bara duplicera samma noder utan @id-koppling. */}
