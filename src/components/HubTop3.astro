---
/**
 * Hubb-sektion: en kategoris tre högst rankade robotar i kompakta kort.
 * Startsidan visar bredden, djupet ligger kvar på kategorisidan. Sektionen
 * gör startsidan till ett nav, inte till en topplista per kategori (det är
 * också det som håller startsidan ifrån kategorisidornas köpsökord).
 *
 * All data kommer från src/data/hub-top3.ts, som i sin tur speglar
 * kategorisidans egen produktarray. Konstruera aldrig en ctaUrl här.
 */
import { ctaRel } from '../lib/cta-rel';
import type { HubCategory } from '../data/hub-top3';

interface Props {
  kategori: HubCategory;
  /** 'vit' ger sektionen ett eget vitt band mot sidans kalla papper. */
  ton?: 'papper' | 'vit';
  /** Sant för den första sektionen på sidan, ger eager-laddad toppbild. */
  eager?: boolean;
  intro: string;
}

const { kategori, ton = 'papper', eager = false, intro } = Astro.props;
const STAR = 'M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z';
---

<div class={ton === 'vit' ? 'bg-white border-y border-border' : ''}>
  <section class="max-w-6xl mx-auto px-4 py-10 md:py-12" aria-labelledby={`${kategori.id}-heading`}>
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 mb-1.5">
      <h2 id={`${kategori.id}-heading`} class="font-heading text-2xl md:text-3xl font-bold text-text">
        Topp 3 {kategori.namn.toLowerCase()}
      </h2>
      <a href={kategori.href} class="text-sm font-semibold text-accent-dark hover:text-accent underline underline-offset-2 shrink-0">
        Visa alla {kategori.total} {kategori.namn.toLowerCase()}
      </a>
    </div>
    <p class="text-text-light mb-6 max-w-2xl leading-relaxed">{intro}</p>

    {/*
      Mobil: snap-karusell med en flik av nästa kort synlig, så att läsaren
      ser att listan fortsätter. Desktop: rutnät. Karusellen scrollar bara
      inuti sin egen container, aldrig hela sidan, och är ett medvetet
      undantag från sidledsscroll-förbudet (som gäller datatabeller).
    */}
    <div
      class="hub-karusell flex md:grid md:grid-cols-3 gap-4 md:gap-5 snap-x snap-mandatory scroll-px-4 -mx-4 px-4 md:mx-0 md:px-0 pb-2 md:pb-0"
      role="group"
      aria-label={`Topp 3 ${kategori.namn.toLowerCase()}, svep i sidled för att se alla tre`}
      tabindex="0"
    >
      {kategori.items.map((item, i) => (
        <article class="flex flex-col bg-white border border-border rounded-xl overflow-hidden snap-start shrink-0 w-[84%] sm:w-[48%] md:w-auto">
          <div class="relative bg-gray-50 aspect-[4/3] border-b border-border">
            {item.badge && (
              <span class={`absolute top-3 left-3 z-10 text-white text-xs font-bold rounded-full px-2.5 py-1 ${i === 0 ? 'bg-winner' : 'bg-primary'}`}>
                {item.rank}. {item.badge}
              </span>
            )}
            {item.reviewUrl ? (
              <a href={item.reviewUrl} tabindex="-1" aria-hidden="true" class="block w-full h-full">
                <img src={item.image} alt={item.imgAlt} loading={eager && i === 0 ? 'eager' : 'lazy'} decoding="async" width="480" height="360" class="w-full h-full object-contain p-3" />
              </a>
            ) : (
              <img src={item.image} alt={item.imgAlt} loading={eager && i === 0 ? 'eager' : 'lazy'} decoding="async" width="480" height="360" class="w-full h-full object-contain p-3" />
            )}
          </div>
          <div class="flex flex-col flex-1 p-4">
            <p class="text-xs font-bold text-text-light mb-0.5">{item.brand}</p>
            <h3 class="font-heading text-lg font-bold text-text leading-snug mb-1">
              {item.reviewUrl ? (
                <a href={item.reviewUrl} class="hover:text-accent-dark transition-colors">{item.name}</a>
              ) : item.name}
            </h3>
            <p class="text-sm text-text-light leading-relaxed mb-3">{item.bestFor}</p>
            <div class="mt-auto">
              <div class="flex items-center gap-1.5 mb-2.5">
                <span class="text-sm font-bold text-text">{item.rating}</span>
                <span class="relative inline-flex" role="img" aria-label={`${item.rating} av 5 i vårt test`}>
                  <span class="flex text-border-dark">
                    {[0,1,2,3,4].map(() => (
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d={STAR} /></svg>
                    ))}
                  </span>
                  <span class="absolute inset-0 flex overflow-hidden text-star" style={`width:${(item.rating / 5) * 100}%`}>
                    {[0,1,2,3,4].map(() => (
                      <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d={STAR} /></svg>
                    ))}
                  </span>
                </span>
              </div>
              <a
                href={item.ctaUrl}
                target="_blank"
                rel={ctaRel(item.ctaUrl)}
                data-product={item.name}
                class="flex items-center justify-center w-full bg-cta hover:bg-cta-dark text-white font-bold text-sm py-3 rounded-lg transition-colors"
              >
                {item.ctaText}
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</div>
